#!/usr/bin/env bash
# drivers/opencode — one opencode turn without a terminal.
#   prompt on stdin → answer on stdout; progress and "session: opencode ID DIR" on stderr
#   AGENT_MODE=edit uses opencode's default agent, which edits and runs commands.
#   Anything else (read, web) uses its read-only "plan" agent. AGENT_MODEL is provider/model.
#   drivers/opencode --resume ID    opens that session interactively (t attach)
set -euo pipefail
if [ "${1:-}" = --resume ]; then exec opencode -s "$2"; fi

args=(run --format json)
if [ "${AGENT_MODE:-}" != edit ]; then args+=(--agent plan); fi
if [ -n "${AGENT_MODEL:-}" ]; then args+=(-m "$AGENT_MODEL"); fi

raw=$(mktemp)
trap 'rm -f "$raw"' EXIT

# every event carries the session id; log it once, from the first. The paths in a tool call are
# relative to where the agent works, and the rest of $HOME is ~
opencode "${args[@]}" | tee "$raw" | jq --unbuffered -nrR --arg dir "$PWD" --arg home "$HOME/" '
  def short: split($dir + "/") | join("") | split($home) | join("~/");
  foreach (inputs | fromjson?) as $e (0; . + 1;
    (if . == 1 then "session: opencode \($e.sessionID) \($dir)" else empty end),
    ($e | if .type == "text" then .part.text
          elif .type == "tool_use" then "  · \(.part.tool) \(.part.state | [.title, .input.filePath, .input.pattern, .input.command, .input.url] |
                                          map(select((. // "") != "")) | .[0] // "" | tostring | short | .[:120])"
          elif .type == "error" then "  ! \(.error.data.message // .error.name)"
          else empty end))' >&2

jq -nrR '[inputs | fromjson? | select(.type == "text") | .part.text] | last // empty' "$raw"
! grep -q '"type":"error"' "$raw"
