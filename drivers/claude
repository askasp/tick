#!/usr/bin/env bash
# drivers/claude — one Claude Code turn without a terminal.
#   prompt on stdin → answer on stdout; progress and "session: claude ID DIR" on stderr
#   AGENT_MODE=edit may change files, web may also search the web, anything else only reads.
#   AGENT_MODEL picks the model, AGENT_EFFORT how hard it thinks.
#   drivers/claude --resume ID    opens that conversation interactively (t attach)
set -euo pipefail
if [ "${1:-}" = --resume ]; then exec claude --resume "$2"; fi

sid=$(uuidgen)
args=(-p --session-id "$sid" --output-format stream-json --verbose)
case ${AGENT_MODE:-read} in
  # without a permission mode claude -p edits nothing, and still exits 0; acceptEdits alone
  # denies every command but a few that only read, test runs included, since -p can't ask
  edit) args+=(--permission-mode "${CLAUDE_EDIT_MODE:-acceptEdits}" --allowedTools Bash) ;;
  web)  args+=(--tools Read,Grep,Glob,WebSearch,WebFetch --allowedTools WebSearch,WebFetch) ;;
  *)    args+=(--tools Read,Grep,Glob) ;;
esac
if [ -n "${AGENT_MODEL:-}" ]; then args+=(--model "$AGENT_MODEL"); fi
if [ -n "${AGENT_EFFORT:-}" ]; then args+=(--effort "$AGENT_EFFORT"); fi

echo "session: claude $sid $PWD" >&2
raw=$(mktemp)
trap 'rm -f "$raw"' EXIT

# stream-json so a long turn shows its progress in the log instead of looking hung; the paths in a
# tool call are relative to where the agent works, and the rest of $HOME is ~
claude "${args[@]}" | tee "$raw" | jq --unbuffered -rR --arg dir "$PWD/" --arg home "$HOME/" '
  def short: split($dir) | join("") | split($home) | join("~/");
  fromjson? | select(.type == "assistant") | .message.content[]? |
  if .type == "text" then .text
  elif .type == "tool_use" then "  · \(.name) \(.input.file_path // .input.command // .input.pattern // "" | tostring | short | .[:120])"
  else empty end' >&2

jq -rR 'fromjson? | select(.type == "result") | .permission_denials[]? |
  "  ! denied: \(.tool_name) \(.tool_input.file_path // .tool_input.command // "")"' "$raw" >&2
jq -rR 'fromjson? | select(.type == "result") | .result // empty' "$raw"
# no result line, or an error result → fail
jq -eR 'fromjson? | select(.type == "result") | .is_error | not' "$raw" > /dev/null
