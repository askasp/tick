#!/usr/bin/env bash
# jobs/slack-loop — slack-in and slack-out every 10 seconds, so a Slack message is read and answered
# in ~10s, not a minute. It holds its own lock, so cron starts it every minute and only one runs; a
# pass that fails is logged and the next one tries again. From cron:
#   * * * * * $HOME/git/tick/jobs/slack-loop >> $HOME/.tick/slack.log 2>&1
. "$(dirname "$(readlink -f "$0")")/slack.sh"

exec 9> "$SLACK_STATE/loop"
flock -n 9 || exit 0

while true; do
  for job in slack-in slack-out; do
    # 9>&-: a task that `t new` starts would otherwise hold the lock for as long as it runs
    if ! "$T_ROOT/jobs/$job" 9>&-; then echo "$(date '+%F %T') $job failed; trying again in 10s" >&2; fi
  done
  sleep 10
done
