#!/usr/bin/env bash
# jobs/slack-out — one short message per task, posted once and edited from then on, with the details
# in one reply under it, edited too. `status` posts the open ones again at the bottom. Only a hold or
# an answer mentions you, because an edit is silent and a mention is not. From cron, after the tick:
#   * * * * * $HOME/git/tick/jobs/slack-out
. "$(dirname "$(readlink -f "$0")")/slack.sh"

# the message a task owns: one line, because a channel of them is read on a phone. Why it is held,
# how long it has been at it and what it did are the reply under it; its branch is a terminal's.
task_text() {
  local standing
  standing=$(standing "$1")
  printf '*%s*  %s  ·  %s %s' "$(task_num "$1")" "$(name "$1")" "$(fraction "$1")" "${standing%%  *}"
}

# a task's history as one message: the time, the steps it went through, and a loop it went round more
# than once as ↺ ×3 — churn is the thing you want to see, and a line each hides it. Steps chain while
# each starts where the last ended, ok goes without saying, and the numbers that sort the step files
# are not for reading.
story() {
  awk '
    function step(s) { sub(/^[0-9]+-/, "", s); return s }
    function emit(   out, i, round) {
      if (n == 0) return
      out = chain[1]
      for (i = 2; i <= n; i++) out = out " → " chain[i]
      round = times - (pos < n)                    # the pass it is in the middle of is not one it made
      if (round > 1) out = out "  *↺ ×" round "*"
      print start "  " out
      n = 0
    }
    function begin(from) { emit(); chain[1] = from; n = 1; pos = 1; times = 1; start = substr($2, 1, 5) }
    function seen(s,   i) { for (i = 1; i <= n; i++) if (chain[i] == s) return i; return 0 }

    { at = substr($2, 1, 5) }

    $5 == "ok" {
      from = step($4); to = step($7)
      if (n > 0 && chain[pos] != from) emit()               # it went on from somewhere else
      if (n == 0) begin(from)
      if (times == 1 && !seen(to)) { chain[++n] = to; pos = n; next }    # the chain is still growing
      want = (pos < n) ? chain[pos + 1] : chain[1]          # else it is round again, from where we are
      if (to != want) { begin(from); chain[2] = to; n = 2; pos = 2; next }   # a loop of its own
      if (pos < n) pos++
      else { pos = 1; times++ }
      next
    }
    $3 == "resumed" { emit(); print at "  resumed at " step($5); next }
    $4 == "on"      { emit(); sub(/^([^ ]+ ){5}/, ""); print at "  held  " $0; next }
                    { emit(); what = step($4)                  # a failure names itself, and what comes
                      sub(/^([^ ]+ ){4}/, ""); sub(/;.*/, "")   # after the semicolon the next line says
                      print at "  " what " " $0 }
    END             { emit() }' "$1/history"
}

details_text() {
  where "$1"
  if [ -s "$1/history" ]; then story "$1"; fi
  echo "_reply here to tell task $(task_num "$1") what to change · help for the rest_"
}

: > "$SLACK_STATE/cards.tmp"
for task in "$T_TASKS"/*/; do
  task=${task%/}
  [ -f "$task/step" ] || continue
  ch=$(channel_of "$task" 2> /dev/null) || continue

  # `status` in the channel: an open task's card is posted again down where you are reading, and the
  # one above goes the way a removed task's card does, at the end
  if [ -e "$SLACK_STATE/move.$ch" ] && [ "$(cat "$task/step")" != done ] && [ -s "$task/slack_ts" ]; then
    thread=$(get "$task/slack_thread")
    if [ -n "$thread" ]; then api chat.delete channel="$ch" ts="$thread" > /dev/null || true; fi
    rm -f "$task/slack_ts" "$task/slack_sent" "$task/slack_thread" "$task/slack_story"
  fi
  ts=$(get "$task/slack_ts")
  text=$(task_text "$task")

  if [ -z "$ts" ]; then
    # a task that was already done when you bound the channel is history, not news; one you started
    # here is news however fast it got there
    if [ "$(cat "$task/step")" = done ] && [ ! -f "$task/slack_src" ]; then continue; fi
    posted=$(api chat.postMessage channel="$ch" text="$text") || continue
    ts=$(jq -r .ts <<< "$posted")
    put "$task/slack_channel" "$ch"
    put "$task/slack_ts" "$ts"
  elif [ "$text" != "$(get "$task/slack_sent")" ]; then
    api chat.update channel="$ch" ts="$ts" text="$text" > /dev/null || true
  fi
  put "$task/slack_sent" "$text"
  echo "$ch $ts" >> "$SLACK_STATE/cards.tmp"

  # one message in the thread, edited from then on, so what happened is where you look for it and not
  # spread over a reply per tick, each under an app header of its own
  told=$(details_text "$task")
  if [ "$told" != "$(get "$task/slack_story")" ]; then
    thread=$(get "$task/slack_thread")
    if [ -z "$thread" ]; then
      posted=$(api chat.postMessage channel="$ch" thread_ts="$ts" text="$told") || continue
      put "$task/slack_thread" "$(jq -r .ts <<< "$posted")"
    else
      api chat.update channel="$ch" ts="$thread" text="$told" > /dev/null || true
    fi
    put "$task/slack_story" "$told"
  fi

  # an edit is silent, so a hold says itself once, in a message of its own: tick is waiting on you
  if [ -e "$task/hold" ] && [ ! -f "$task/slack_held" ]; then
    api chat.postMessage channel="$ch" thread_ts="$ts" \
      text="held  $(head -1 "$task/hold")${SLACK_ME:+$'\n\n'<@$SLACK_ME>}" > /dev/null || true
    touch "$task/slack_held"
  fi
  if [ ! -e "$task/hold" ]; then rm -f "$task/slack_held"; fi    # resumed: the next hold says itself too

  # an answer is the whole point of the question, so it goes to the thread as itself, and mentions
  # you the way a hold does: both are tick waiting on you
  if [ "$(cat "$task/step")" != done ]; then rm -f "$task/slack_answer"; fi   # a follow-up answers again
  if [ -s "$task/answer.md" ] && [ ! -f "$task/slack_answer" ] && [ "$(cat "$task/step")" = done ]; then
    answer=$(head -c 3000 "$task/answer.md")
    if [ "$(wc -c < "$task/answer.md")" -gt 3000 ]; then answer+=$'\n\n…  all of it: '"t show $(task_num "$task")"; fi
    api chat.postMessage channel="$ch" thread_ts="$ts" \
      text="$answer${SLACK_ME:+$'\n\n'<@$SLACK_ME>}" > /dev/null || true
    touch "$task/slack_answer"
  fi

  # the message you typed to start it wears the answer: 👀 tick has it, ✅ it is done
  if [ "$(cat "$task/step")" = done ] && [ -f "$task/slack_src" ] && [ ! -f "$task/slack_ok" ]; then
    api reactions.add channel="$ch" timestamp="$(get "$task/slack_src")" name=white_check_mark > /dev/null || true
    touch "$task/slack_ok"
  fi
done

# `t rm` takes the task directory, so its card goes too: what is left in the channel is what is left
# on the board. A card whose task is still there but done stays, because you still want its diff.
sort -o "$SLACK_STATE/cards.tmp" "$SLACK_STATE/cards.tmp"
comm -13 "$SLACK_STATE/cards.tmp" <(sort "$SLACK_STATE/cards" 2> /dev/null) | while read -r ch ts; do
  api chat.delete channel="$ch" ts="$ts" > /dev/null || true
done
mv "$SLACK_STATE/cards.tmp" "$SLACK_STATE/cards"
rm -f "$SLACK_STATE"/move.*
