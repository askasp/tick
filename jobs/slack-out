#!/usr/bin/env bash
# jobs/slack-out — one message per task, posted once and edited from then on, and the board as the
# channel's canvas. What the task did goes to its own thread; only a hold mentions you, because an
# edit is silent and a mention is not. From cron, right after the tick:
#   * * * * * $HOME/git/tick/jobs/slack-out
. "$(dirname "$(readlink -f "$0")")/slack.sh"

# the message a task owns: two lines, because it is read on a phone. Its branch and its worktree are
# a terminal's business (t show), and the thread under it is the rest.
task_text() { printf '*task %s*  %s\n%s' "$(task_num "$1")" "$(name "$1")" "$(where "$1")"; }

# the board: every open task, two ragged lines each. Not columns, because Slack's proportional font
# would only pretend they lined up.
board_text() {
  local ch=$1 repo=$2 t rows= open=0 held=0 done_n=0 mark
  for t in "$T_TASKS"/*/; do
    t=${t%/}
    [ -f "$t/step" ] || continue
    [ "$(channel_of "$t" 2> /dev/null || true)" = "$ch" ] || continue
    if [ "$(cat "$t/step")" = done ]; then done_n=$((done_n + 1)); continue; fi
    open=$((open + 1)) mark=
    if [ -e "$t/hold" ]; then held=$((held + 1)) mark='🔴 '; fi
    rows+="$mark\`$(task_num "$t")\` *$(name "$t")*"$'\n'"$(where "$t")"$'\n'
  done
  printf '*%s*  ·  %s active%s\n\n%s\n%s done' "$repo" "$open" \
    "$(if [ "$held" -gt 0 ]; then echo ", $held needs you"; fi)" \
    "${rows:-nothing running}" "$done_n"
}

# the lines history grew since we last looked, without the date and the task number it repeats
moves() {
  awk -v from="$1" 'NR > from {
    when = substr($2, 1, 5); $1 = ""; $2 = ""; sub(/^ +/, "")
    if ($1 ~ /^[0-9]+$/) { $1 = ""; sub(/^ +/, "") }
    print when "  " $0 }' "$2"
}

# There is one board message in a channel, ever, and it lives where you last asked for it: saying
# `status` there moves it to the bottom, which on a phone is the only place that is easy to find.
# Between asks it is edited where it stands, so it is current wherever you left it.
for pair in ${SLACK_CHANNELS:-}; do
  ch=${pair%%=*}
  text=$(board_text "$ch" "${pair#*=}")
  ts=$(get "$SLACK_STATE/board.$ch.ts")
  move=$SLACK_STATE/board.$ch.move
  if [ ! -e "$move" ] && [ -n "$ts" ] && [ "$text" = "$(get "$SLACK_STATE/board.$ch.sent")" ]; then continue; fi
  if [ -e "$move" ] || [ -z "$ts" ]; then
    if [ -n "$ts" ]; then api chat.delete channel="$ch" ts="$ts" > /dev/null || true; fi
    posted=$(api chat.postMessage channel="$ch" text="$text") || continue
    put "$SLACK_STATE/board.$ch.ts" "$(jq -r .ts <<< "$posted")"
    rm -f "$move"
  else
    api chat.update channel="$ch" ts="$ts" text="$text" > /dev/null || true
  fi
  put "$SLACK_STATE/board.$ch.sent" "$text"
done

: > "$SLACK_STATE/cards.tmp"
for task in "$T_TASKS"/*/; do
  task=${task%/}
  [ -f "$task/step" ] || continue
  ch=$(channel_of "$task" 2> /dev/null) || continue
  ts=$(get "$task/slack_ts")
  text=$(task_text "$task")

  if [ -z "$ts" ]; then
    # a task that was already done when you bound the channel is history, not news
    if [ "$(cat "$task/step")" = done ]; then continue; fi
    posted=$(api chat.postMessage channel="$ch" text="$text") || continue
    ts=$(jq -r .ts <<< "$posted")
    put "$task/slack_channel" "$ch"
    put "$task/slack_ts" "$ts"
  elif [ "$text" != "$(get "$task/slack_sent")" ]; then
    api chat.update channel="$ch" ts="$ts" text="$text" > /dev/null || true
  fi
  put "$task/slack_sent" "$text"
  echo "$ch $ts" >> "$SLACK_STATE/cards.tmp"

  if [ -f "$task/history" ]; then
    seen=$(get "$task/slack_seen") seen=${seen:-0}
    lines=$(moves "$seen" "$task/history")
    if [ -n "$lines" ]; then
      if grep -q 'on hold' <<< "$lines" && [ -n "${SLACK_ME:-}" ]; then lines+=$'\n'"<@$SLACK_ME>"; fi
      api chat.postMessage channel="$ch" thread_ts="$ts" text="$lines" > /dev/null || true
      put "$task/slack_seen" "$(wc -l < "$task/history")"
    fi
  fi

  # an answer is the whole point of the question, so it goes to the thread as itself, and mentions
  # you the way a hold does: both are tick waiting on you
  if [ "$(cat "$task/step")" != done ]; then rm -f "$task/slack_answer"; fi   # a follow-up answers again
  if [ -s "$task/answer.md" ] && [ ! -f "$task/slack_answer" ] && [ "$(cat "$task/step")" = done ]; then
    answer=$(head -c 3000 "$task/answer.md")
    if [ "$(wc -c < "$task/answer.md")" -gt 3000 ]; then answer+=$'\n\n…  all of it: '"t show $(task_num "$task")"; fi
    api chat.postMessage channel="$ch" thread_ts="$ts" \
      text="$answer${SLACK_ME:+$'\n\n'<@$SLACK_ME>}" > /dev/null || true
    touch "$task/slack_answer"
  fi

  # the message you typed to start it wears the answer: 👀 tick has it, ✅ it is done
  if [ "$(cat "$task/step")" = done ] && [ -f "$task/slack_src" ] && [ ! -f "$task/slack_ok" ]; then
    api reactions.add channel="$ch" timestamp="$(get "$task/slack_src")" name=white_check_mark > /dev/null || true
    touch "$task/slack_ok"
  fi
done

# `t rm` takes the task directory, so its card goes too: what is left in the channel is what is left
# on the board. A card whose task is still there but done stays, because you still want its diff.
sort -o "$SLACK_STATE/cards.tmp" "$SLACK_STATE/cards.tmp"
comm -13 "$SLACK_STATE/cards.tmp" <(sort "$SLACK_STATE/cards" 2> /dev/null) | while read -r ch ts; do
  api chat.delete channel="$ch" ts="$ts" > /dev/null || true
done
mv "$SLACK_STATE/cards.tmp" "$SLACK_STATE/cards"
