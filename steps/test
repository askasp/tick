#!/usr/bin/env bash
# test — run the repo's tests in the worktree. If they fail, send the output back to implement.
# The command is TEST_CMD (t new --test "npm test"), or else `make test` when the Makefile has one.
# TEARDOWN, when the pipeline sets it, runs afterwards: stop the containers the tests needed.
set -uo pipefail
task=$PWD
cd -P work || exit 1

cmd=${TEST_CMD:-}
if [ -z "$cmd" ] && grep -qs '^test:' Makefile; then cmd="make test"; fi
if [ -z "$cmd" ]; then
  echo "no TEST_CMD for this task and no 'make test' in the repo: nothing to run"
  exit 0
fi

teardown() { echo "\$ $TEARDOWN"; bash -c "$TEARDOWN"; }
if [ -n "${TEARDOWN:-}" ]; then trap teardown EXIT; fi     # whatever the tests started, pass or fail

echo "\$ $cmd"
timeout "${TEST_TIMEOUT:-30m}" bash -c "$cmd" > "$task/test.out" 2>&1
status=$?
if [ $status -eq 0 ]; then
  tail -5 "$task/test.out"
  exit 0
fi
tail -40 "$task/test.out"
{
  if [ $status -eq 124 ]; then
    echo "The tests (\`$cmd\`) still ran after ${TEST_TIMEOUT:-30m}, so they were stopped: something in them hangs. Find it, then make them pass."
  else
    echo "The tests fail (\`$cmd\`). Make them pass."
  fi
  if [ -s "$task/test.out" ]; then
    echo "The last 80 lines of output:"
    echo '```'
    tail -80 "$task/test.out"
    echo '```'
  else
    echo "They printed nothing."
  fi
} > "$task/feedback.md"
echo implement > "$task/goto"
