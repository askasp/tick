#!/usr/bin/env bash
# ci — wait for the PR's checks. Pending: exit 75, and the tick asks again in a minute.
# Failed: the failing logs become feedback.md, and the task goes back to implement.
set -uo pipefail
pr=$(cat pr)
waited=$(( $(date +%s) - $(stat -c %Y pushed) ))

checks=$(cd -P work && gh pr checks "$pr" 2>&1)
code=$?
echo "$checks"

if [ "$code" = 0 ]; then exit 0; fi
if [ "$code" = 8 ]; then                          # gh's "checks pending"
  if [ "$waited" -gt "${CI_TIMEOUT:-7200}" ]; then echo "CI has been pending for ${waited}s" > hold; fi
  exit 75
fi
if grep -q 'no checks reported' <<< "$checks"; then
  if [ "$waited" -le 300 ]; then exit 75; fi      # GitHub may not have registered them yet
  echo "this repo reports no checks; counting that as passed"
  exit 0
fi
if ! grep -qE $'\t(fail|failure)\t' <<< "$checks"; then
  echo "gh pr checks failed (exit $code) without a failing check" >&2
  exit 1
fi

failed_runs=$(grep -oE 'actions/runs/[0-9]+' <<< "$checks" | sort -u | cut -d/ -f3)
{
  echo "CI fails on the pull request. Make it pass."
  echo '```'
  echo "$checks"
  for run in $failed_runs; do
    (cd -P work && gh run view "$run" --log-failed) 2>&1 | tail -80
  done
  echo '```'
} > feedback.md
echo implement > goto
