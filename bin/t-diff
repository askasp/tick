#!/usr/bin/env bash
# t diff [TASK] [git diff args] — the task's change so far, against what it branched from
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
t=$(task_dir "${1:-}") || exit 1
[ $# -eq 0 ] || shift
repo=$(cat "$t/repo") branch=$(cat "$t/branch")
git -C "$repo" rev-parse -q --verify "refs/heads/$branch" > /dev/null || die "task ${t##*/} has no branch yet"
exec git -C "$repo" diff "$(cat "$t/base")...$branch" "$@"
