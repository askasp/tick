#!/usr/bin/env bash
# t thread CONVERSATION|TASK — a conversation the width of the screen, and what you write under it: enter starts a new
# line, ^y sends it, and esc leaves it held on the board. ^s has an agent write it, and the rest depends on the source:
# ^t a comment (Front), ^k ^j the message a reply goes under and ^g the channel, ^r a reaction (Slack).
#
# The inbox's enter opens a conversation here ($T_INBOX is its source); the board's, a reply held for you. There is no
# editor: the line you type is fzf's query, and backspace on an empty one takes the line above back. What you write is a
# task on pipeline reply (or the source's own, slack-reply) or comment, held at sign with it in answer.md until ^y signs
# it and runs it to the end, so esc loses nothing and nothing leaves before ^y, but a reaction, which the same key takes back.
# fzf runs t-thread for what changes: --pane, --start, --fresh (the thread as it is now), --key KEY QUERY, --pop (the
# last line, out of the text), --wait (for an agent's draft) and --loaded (the draft, into the prompt).
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
. "$T_ROOT/lib/thread.sh"
set -euo pipefail
terminal_colors

here=${T_THREAD:-}
failed() { echo "${1:-}change-input-label~$C_RED $(grep -m1 . "$here/err" | sed 's/^t: //') $C_OFF~"; exit; }
without_trailing_blanks() { tac | sed '/[^[:space:]]/,$!d' | tac; }
unchanged() { [ -n "$(kept task)" ] && without_trailing_blanks < "$here/text" | cmp -s - "$(kept task)/answer.md"; }
source_says() { "$T_ROOT/sources/$(inbox)" "$@"; }
# the line typed at the prompt is in the text now, so a failure takes it off the prompt: again would write it twice
took_line() { echo "clear-query+change-prompt($(prompt))+refresh-preview+"; }

# $1, a conversation in $T_INBOX or a reply or comment task, as the screen starts on it
open() {
  local task= line=
  : > "$here/text"
  keep at ""
  if [[ $1 =~ ^[0-9]+$ ]]; then
    task=$(task_dir "$1")
    line=$(sed -n 's/^conversation: //p' "$task/task.md" | head -1)
    [ -n "$line" ] || die "task $(task_num "$task") answers no conversation"
    keep kind "$(load_env "$task" > /dev/null 2>&1; echo "${KIND:-reply}")"
  else
    [ -n "${T_INBOX:-}" ] || die "which inbox is $1 in? open it from t inbox, or: T_INBOX=front t thread $1"
    keep kind reply
    task=$(reply_to "$T_INBOX" "$1")
    line="$T_INBOX $1"
    if [ -n "$task" ]; then line=$(sed -n 's/^conversation: //p' "$task/task.md" | head -1); fi
  fi
  keep conv "${line%%/*}"
  if [ "${line%%/*}" != "$line" ]; then keep at "${line#*/}"
  elif [ -z "$task" ]; then keep at "$(conv_field at)"; fi   # a mention or a thread you are in: a reply goes under it
  keep task "$task"
  keep mode write
  [ -n "$task" ] || return 0
  if grep -qsx draft "$task/opt"; then touch "$here/drafted"; fi
  if [[ $(cat "$task/step") != *-sign ]] && [ -e "$here/drafted" ]; then keep mode drafting
  elif [ -s "$task/answer.md" ]; then cp "$task/answer.md" "$here/text"; keep mode held; fi
}

# what you wrote, as answer.md of a task held at its sign step, going where the prompt is: the task you had, else a new one
hold_it() {
  local task n
  task=$(kept task)
  if [ -z "$task" ]; then
    n=$(printf 'conversation: %s\n' "$(target)" | t-new -p "$(pipeline_for)" "Re: $(subject)" - 2> "$here/err") || return 1
    task=$(tdir "$n")
    keep task "$task"
  fi
  n=$(task_num "$task")
  flock -w 60 "$task/lock" true || { echo "task $n is still running; send it again in a moment" > "$here/err"; return 1; }
  if ! grep -qxF "conversation: $(target)" "$task/task.md"; then     # the prompt moved since: so does the task
    sed "s|^conversation: .*|conversation: $(target)|" "$task/task.md" > "$task/task.tmp" && mv "$task/task.tmp" "$task/task.md"
  fi
  without_trailing_blanks < "$here/text" > "$task/answer.tmp" && mv "$task/answer.tmp" "$task/answer.md"
  rm -f "$task/signed"
  t-resume "$n" 2> /dev/null || true                  # its sign step holds again, now for what answer.md says
  t-run "$n" > /dev/null 2>&1 || true
  if [[ $(cat "$task/step") != *-sign ]]; then
    echo "task $n is at $(sed 's/^[0-9]*-//' "$task/step"), not yet waiting for your signature: t log $n" > "$here/err"
    return 1
  fi
  keep mode held
}

# the held task, signed and run to its end here, so the screen says whether it left: a thread that moved since you
# read it holds it again, with what was said since in the pane
send_it() {
  local task n
  task=$(kept task) n=$(task_num "$(kept task)")
  flock -w 60 "$task/lock" true || { echo "task $n is still running; send it again in a moment" > "$here/err"; return 1; }
  t-sign "$n" < /dev/null > /dev/null 2> "$here/err" || return 1
  t-run "$n" > /dev/null 2>&1 || true
  if [ -e "$task/hold" ]; then fresh > /dev/null; cp "$task/hold" "$here/err"; return 1; fi
  if [ "$(cat "$task/step")" != done ]; then last_words "$task/log/$(cat "$task/step").log" > "$here/err"; return 1; fi
  keep mode signed
}

# an agent writes it, told what you wrote so far: a new task with +draft, in place of the one you had
agent_writes() {
  local n
  if [ -n "$(kept task)" ]; then t-rm "$(task_num "$(kept task)")" > /dev/null 2> "$here/err" || return 1; fi
  n=$({ printf 'conversation: %s\n' "$(target)"; if written; then echo; cat "$here/text"; fi; } |
    t-new -p "$(pipeline_for)" +draft "Re: $(subject)" - 2> "$here/err") || return 1
  keep task "$(tdir "$n")"
  : > "$here/text"
  keep mode drafting
  setsid t-run "$n" < /dev/null > /dev/null 2>&1 &
}

# until the agent's run ends: at sign with its draft, or short of it
wait_for_draft() {
  local task
  [ "$(kept mode)" = drafting ] || return 0
  task=$(kept task)
  sleep 1
  while [ -d "$task" ] && ! flock -n "$task/lock" true 2> /dev/null; do sleep 0.5; done
}

loaded() {
  local task
  [ "$(kept mode)" = drafting ] || return 0
  task=$(kept task)
  keep mode write
  if [ -s "$task/answer.md" ] && [[ $(cat "$task/step") == *-sign ]]; then
    cp "$task/answer.md" "$here/text"
    touch "$here/drafted"
    echo "show-input+transform-query(t-thread --pop)+change-prompt($(prompt $(($(lines) - 1))))+refresh-preview+change-input-label~$(footer)~"
  else
    echo "show-input+change-prompt($(prompt))+refresh-preview+change-input-label~$C_RED no draft: $(last_words "$task/log/$(cat "$task/step" 2> /dev/null).log") $C_OFF~"
  fi
}

pop() { tail -n 1 "$here/text"; head -n -1 "$here/text" > "$here/text.tmp" && mv "$here/text.tmp" "$here/text"; }

fresh() {   # the thread as it is now, where the pane reads it
  local dir id
  dir=$(mail) id=$(conv_id)
  if [ -n "$(kept at)" ]; then id=$id/$(kept at); fi
  mkdir -p "$dir"
  if source_says thread "$id" > "$dir/thread.tmp" 2> /dev/null; then mv "$dir/thread.tmp" "$dir/thread.md"; echo refresh-preview
  else rm -f "$dir/thread.tmp"; fi
}

# where the prompt went: the pane shows it, mid-pane under its message or at the end
placed() { echo "change-prompt($(prompt))+$(window "$(if [ -n "$(kept at)" ]; then marker_line; fi)")+refresh-preview+change-input-label~$(footer)~"; }

# what key $1 does, with $2 typed on the line
act() {
  local q=$2 mode task name out ts
  mode=$(kept mode) task=$(kept task)
  case $1 in
    esc)    if [ "$mode" = write ]; then
              if [ -n "$q" ]; then printf '%s\n' "$q" >> "$here/text"; fi
              if written && ! unchanged; then hold_it || failed "$(took_line)"; fi
            fi
            echo abort; return ;;
    bspace) if [ -n "$q" ] || [ "$mode" != write ]; then echo backward-delete-char
            elif [ -s "$here/text" ]; then echo "transform-query(t-thread --pop)+change-prompt($(prompt $(($(lines) - 1))))+refresh-preview"; fi
            return ;;
  esac
  name=$(awk -v k="$1" '$2 == k { print $1; exit }' <<< "$THREAD_KEYS")
  case $name in
    line)    [ "$mode" = write ] || return 0
             printf '%s\n' "$q" >> "$here/text"
             echo "clear-query+change-prompt(  )+refresh-preview" ;;
    release) [ "$mode" = write ] || [ "$mode" = held ] || return 0
             if [ "$mode" = write ]; then
               if [ -n "$q" ]; then printf '%s\n' "$q" >> "$here/text"; fi
               if ! written; then echo "change-input-label~ nothing written yet: type it, then $(key release) ~"; return; fi
               hold_it || failed "$(took_line)"
             fi
             send_it || failed "clear-query+hide-input+refresh-preview+"
             echo "clear-query+hide-input+refresh-preview+change-input-label~$(footer)~" ;;
    comment) [ "$mode" = write ] && can comment || return 0
             if [ "$(kept kind)" = comment ]; then keep kind reply; keep task "$(reply_to $(kept conv))"
             else keep kind comment; keep task ""; fi     # a task you had keeps what it had, on the board
             echo "change-prompt($(prompt))+refresh-preview+change-input-label~$(footer)~" ;;
    up | down)
             if ! can threads; then echo "preview-half-page-$name"; return; fi
             [ "$mode" = write ] || return 0
             keep at "$(moved "$name")"
             placed ;;
    channel) [ "$mode" = write ] && can threads || return 0
             keep at ""
             placed ;;
    react)   can react || return 0
             ts=$(kept at)
             if [ -z "$ts" ]; then ts=$(positions | tail -1); fi   # no message picked: the last one said
             out=$(source_says react "$(conv_id)" "$ts" 2> "$here/err") || failed
             fresh > /dev/null
             echo "refresh-preview+change-input-label~ $out · $(key react) again takes it back ~" ;;
    draft)   [ "$mode" = write ] || [ "$mode" = held ] || return 0
             if [ -n "$q" ]; then printf '%s\n' "$q" >> "$here/text"; fi
             agent_writes || failed "$(took_line)"
             echo "clear-query+hide-input+reload(t-thread --wait)+refresh-preview+change-input-label~$(footer)~" ;;
    edit)    if [ "$mode" != held ]; then echo end-of-line; return; fi
             keep mode write
             echo "show-input+transform-query(t-thread --pop)+change-prompt($(prompt $(($(lines) - 1))))+refresh-preview+change-input-label~$(footer)~" ;;
    discard) [ "$mode" = held ] || return 0
             t-rm "$(task_num "$task")" > /dev/null 2> "$here/err" || failed
             keep task ""
             : > "$here/text"
             rm -f "$here/drafted"
             keep mode write
             echo "show-input+clear-query+change-prompt($(prompt))+refresh-preview+change-input-label~$(footer)~" ;;
  esac
}

case ${1:-} in
  --pane)   pane; exit ;;
  --start)  if [ "$(kept mode)" = write ]; then printf show-input; else printf hide-input; fi
            echo "+change-prompt($(prompt))+$(window)+refresh-preview+change-input-label~$(footer)~+bg-transform(t-thread --fresh)"
            exit ;;                                     # at the bottom, where the talk is; ^k ^j go up to a message
  --fresh)  fresh; exit ;;
  --key)    act "$2" "${3:-}"; exit ;;
  --pop)    pop; exit ;;
  --wait)   wait_for_draft; exit ;;
  --loaded) loaded; exit ;;
esac
[ -n "${1:-}" ] || die "usage: t thread CONVERSATION|TASK"
command -v fzf > /dev/null || die "t thread needs fzf (sudo apt install fzf); without it: t sign"
export T_THREAD
if [ -z "$here" ]; then
  T_THREAD=$(mktemp -d) here=$T_THREAD
  trap 'rm -rf "$here"' EXIT
fi
open "$1"

binds=()
while read -r _ key _; do
  binds+=(--bind "$key:transform:CLICOLOR_FORCE=1 t-thread --key $key {q}")
done <<< "$THREAD_KEYS"
t-thread --wait | fzf "${BOARD_FZF[@]}" --layout default --disabled --info hidden --prompt "$(prompt)" --input-label "$(footer)" \
  --input-label-pos 2:bottom --preview 'CLICOLOR_FORCE=1 t-thread --pane' --preview-window 'up,99%,follow,wrap,~2,noborder' \
  --bind 'start:transform:CLICOLOR_FORCE=1 t-thread --start' --bind 'load:transform:CLICOLOR_FORCE=1 t-thread --loaded' \
  --bind 'esc:transform:CLICOLOR_FORCE=1 t-thread --key esc {q}' --bind 'bspace:transform:t-thread --key bspace {q}' \
  "${PANE_SCROLL[@]}" "${binds[@]}" || true
