#!/usr/bin/env bash
# t ls [-a] — the board: open tasks, how far along each is, and why it waits (-a adds done ones)
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"

rows=$(board "${1:-}")
if [ -z "$rows" ]; then
  echo "no open tasks. start one: t new \"what to do\"${1:-   (t ls -a shows done ones)}"
  exit 0
fi
{
  printf '%-4s %-6s %-10s %-8s %s\n' ID STEPS STATE REPO TITLE
  while IFS= read -r row; do
    echo "$row"
    n=${row%% *}
    [ ! -f "$(tdir "$n")/hold" ] || echo "      ↳ $(head -1 "$(tdir "$n")/hold")   (t show $n)"
  done <<< "$rows"
} | if [ -t 1 ]; then fit; else cat; fi
