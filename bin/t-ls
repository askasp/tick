#!/usr/bin/env bash
# t ls [-a] — the board: open tasks, how far along each is, for how long, and what each is doing (-a adds done ones)
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"

if [ -t 1 ]; then read -r _ T_COLS < <(stty size < /dev/tty 2> /dev/null); fi   # a narrow terminal drops columns
rows=$(board "${1:-}")
if [ -z "$rows" ]; then
  echo "no open tasks. start one: t new \"what to do\"${1:-   (t ls -a shows done ones)}"
  exit 0
fi
echo "$rows" | if [ -t 1 ]; then fit; else cat; fi

# footer: GPU stats and token rate from running tasks, if available
footer=
stats=$(gpu_stats)
[ -n "$stats" ] && footer="$stats"
for t in "$T_TASKS"/*/; do
  [ -f "$t/step" ] || continue
  [ "$(state "$t")" = running ] || continue
  rate=$(token_rate "$t")
  [ -n "$rate" ] && footer="${footer:+$footer  }$rate"
done
if [ -n "$footer" ]; then echo "$footer"; fi
