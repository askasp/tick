#!/usr/bin/env bash
# t roadmap [TASK] — the project a roadmap watch keeps, in its own order, what needs you above a line: ^t makes a task, ^n an issue, ^s moves it, ? every key
#
# The watch is a task whose one step is roadmap (ROADMAP= and PROJECT= in its pipeline's env), and Enter on its row opens
# this. ^t asks for your note, then opens t compose on the issue (its title typed, the issue and your note as details)
# for the pipeline, the agent and the repo; the task made, GitHub hears in the background that the issue is In progress,
# assigned to you. ^n asks for a title and makes a new issue on the project, a sub-issue when you are in a list of them.
# ^s lists the project's statuses, and enter moves the issue to one. ^x takes an issue off this list.
# What you do shows at once, and GitHub hears it in the background, which then asks fzf through its socket to --refresh.
# fzf runs t-roadmap for what changes: --rows [PARENT], --statuses ISSUE, --pane KEY, --keys, --key KEY ROW,
# --compose ISSUE NOTE and --made (^t), --refresh; the background runs --start ISSUE (^t), --send ISSUE (^n) and
# --moved ISSUE STATUS WAS (^s)
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
shopt -s nullglob

if [ -z "${T_ROADMAP:-}" ]; then                     # the watch you named, else the first there is
  watches=("$T_TASKS"/*/roadmap)
  watch=${watches[0]:-}
  if [ -n "${1:-}" ]; then watch=$(task_dir "$1")/roadmap; fi
  [ -f "$watch" ] || die "no roadmap is watched${1:+ by task $1}; start one: t new -p amino-roadmap \"roadmap\""
  export T_ROADMAP
  T_ROADMAP=$(cat "$watch")
fi
read -r roadmap project <<< "$T_ROADMAP"
cache=$T_VAR/roadmap/${project//\//-}
items=$cache/items
top="${project%/*}> "
terminal_colors

issue() { jq -c --arg key "$1" 'select(.key == $key)' "$items"; }
number() { if [[ $1 == *#new-* ]]; then echo "#…"; else echo "#${1##*#}"; fi; }   # #… while GitHub makes it
not_mine() { cat "$cache/not-mine" 2> /dev/null || true; }

# the task made from issue $1, if there is one
working_on() {
  local found
  found=$(grep -lx "issue: $1" /dev/null "$T_TASKS"/*/task.md | head -1 || true)
  if [ -n "$found" ]; then echo "${found%/task.md}"; fi
}

# the repo in repos/ that has a git remote on GitHub as $1 (owner/name)
repo_for() {
  local env name
  for env in "$T_ROOT"/repos/*/env; do
    name=$(basename "$(dirname "$env")")
    if git -C "$(profile_get "$name" REPO)" remote -v 2> /dev/null | grep -q "github\.com[:/]$1\(\.git\)\?[[:space:]]"; then
      echo "$name"; return
    fi
  done
  return 1
}

# an issue a line, its key first for fzf and hidden:  #553  Security hardening  4/6  In progress  askasp · 6d  task 22
# With no PARENT: what needs you, a line, then the open issues that aren't another open issue's sub-issue. With PARENT,
# its sub-issues. Both in the project's order.
rows() {
  local key title sub status who last lift word detail task
  [ -f "$items" ] || return 0
  jq -rs --arg parent "${1:-}" --rawfile skip <(not_mine) '
    map(select(.state == "OPEN" and (.key | IN($skip | split("\n")[]) | not))) as $open
    | ($open | map(.key)) as $keys
    | (if $parent != "" then $open | map(select(.parent == $parent))
       else ($open | map(select(.lift != null))) as $lifted
         | $lifted + (if $lifted == [] then [] else [{key: "-"}] end)
           + ($open | map(select(.lift == null and (.parent == null or (.parent | IN($keys[]) | not))))) end)[]
    | if .key == "-" then "-" else
        [.key, .title, (if .total > 0 then "\(.done)/\(.total)" else "" end), (.status // ""),
         (.assignees | join(", ")), .last, (.lift // "")] | join("") end' "$items" |
    while IFS=$'\x1f' read -r key title sub status who last lift; do
      if [ "$key" = - ]; then printf -- '-\t%s%s%s\n' "$C_FAINT" "$(printf '─%.0s' {1..80})" "$C_OFF"; continue; fi
      task=$(working_on "$key")
      if [ "${#title}" -gt 40 ]; then title=${title:0:39}…; fi
      word=${lift:-$status} detail="${who:+$who · }$(ago "$last")"
      if [ "$lift" = stalled ]; then word=$status detail="nothing for $(ago "$last")"; fi
      if [ -n "$lift" ]; then word=$(pad 15 "$word" "$C_RED$word$C_OFF"); else word=$(pad 15 "$word" "$C_DIM$word$C_OFF"); fi
      printf '%s\t%s  %s  %s  %s  %s%s\n' "$key" "$(pad 6 "$(number "$key")" "$C_DIM$(number "$key")$C_OFF")" \
        "$(pad 40 "$title")" "$(pad 5 "$sub" "$C_MID$sub$C_OFF")" "$word" "$C_FAINT$detail$C_OFF" \
        "${task:+  ${C_DIM}task $(task_num "$task")$C_OFF}"
    done
}

# issue $1 as markdown, for a task's details and the pane: its title, its text, then its comments
issue_md() {
  issue "$1" | jq -r '
    def when: strflocaltime("%a %d %b %H:%M");
    "# \(.title)", "", "## issue from \(.author), \(.created | when)", "", .body,
    (.comments[] | "", "### └ comment by \(.by), \(.at | when)", "", .body)'
}

# the project's statuses, for ^s, the issue's own marked: the name first for fzf and hidden
statuses() {
  local now name
  now=$(issue "$1" | jq -r '.status // ""')
  while read -r name; do
    if [ "$name" = "$now" ]; then printf '%s\t%s  %snow%s\n' "$name" "$(pad 15 "$name")" "$C_DIM" "$C_OFF"
    else printf '%s\t%s\n' "$name" "$name"; fi
  done < "$cache/statuses"
}

# every key the roadmap binds, and what the line and the red words mean
keys() {
  local name key what
  while read -r name key what; do
    echo "$C_MID$(pad 7 "$(keyname "$key")")$C_OFF$(pad 8 "$name")$C_DIM$what$C_OFF"
  done <<< "$ROADMAP_KEYS"
  echo "${C_MID}^d ^u  ${C_OFF}scroll  ${C_DIM}the pane, half a page; PgDn/PgUp a page, Shift-↓/↑ a line$C_OFF"
  echo "${C_MID}esc    ${C_OFF}back    ${C_DIM}out of a list or a prompt, then to the board$C_OFF"
  echo
  echo "Above the line, what needs you, in red:"
  echo "  ${C_RED}stalled$C_OFF          ${C_DIM}In progress, and nothing touched it for STALL days: not on GitHub, not a task's commit$C_OFF"
  echo "  ${C_RED}no status$C_OFF        ${C_DIM}on the project, but in no column yet: $(key status) gives it one$C_OFF"
  echo "  ${C_RED}off the project$C_OFF  ${C_DIM}an open issue in its repos that isn't on it: $(key status) puts it there$C_OFF"
  echo
  echo "${C_DIM}Type to filter: QA lists every issue in QA. A number after an issue is how many of its sub-issues are done.$C_OFF"
}

pane() {
  local task
  if [[ ${FZF_PROMPT:-} == *" status> " ]]; then set -- "$(cat "$cache/picked")"; fi   # the issue, not the status
  [ "$1" != - ] && [ -f "$items" ] || return 0
  issue "$1" | jq -r --arg dim "$C_DIM" --arg bright "$C_BRIGHT" --arg off "$C_OFF" '
    "\($bright)\(.title)\($off)",
    "\($dim)\(.key) · opened \(.created | strflocaltime("%d %b %Y")) by \(.author)\($off)",
    "",
    "\($dim)status\($off)    \(.status // "none")\(if .onboard then "" else ", and not on the project" end)",
    (if .total > 0 then "\($dim)sub\($off)       \(.done) of \(.total) done" else empty end),
    (if .labels != [] then "\($dim)labels\($off)    \(.labels | join(", "))" else empty end),
    (if .assignees != [] then "\($dim)assignee\($off)  \(.assignees | join(", "))" else empty end)'
  task=$(working_on "$1")
  if [ -n "$task" ]; then echo; echo "${C_DIM}task $(task_num "$task")$C_OFF  $(standing "$task")"; fi
  echo
  issue_md "$1" | awk 'NR > 2 && /^#/ && !/^## issue from / && !/^### └ comment by / { $0 = " " $0 } 1' | thread_view /dev/stdin
}

back() { echo "enable-search+clear-query+change-prompt~$top~+reload~CLICOLOR_FORCE=1 t-roadmap --rows~+change-footer~$(footer)~"; }
footer() { hint enter sub-issues "$(key task)" task "$(key issue)" "new issue" "$(key status)" status "$(key drop)" "not mine" "$(key keys)" keys esc back; }
sub_issues() { echo "reload~CLICOLOR_FORCE=1 t-roadmap --rows '$1'~+change-prompt~$(number "$1")> ~+first"; }

# back to the list a new issue was asked for in: the sub-issues of PARENT, or with none the project's
back_to() {
  if [ -z "$1" ]; then back; return; fi
  echo "enable-search+clear-query+change-footer~$(footer)~+$(sub_issues "$1")"
}

# FILTER [JQ ARG…]: the list the watch keeps, through jq as one array, one writer at a time; its time stays when the
# watch last polled
rewrite() {
  local filter=$1
  shift
  (
    flock 9
    jq -cs "$@" "$filter | .[]" "$items" > "$items.tmp"
    touch -r "$items" "$items.tmp"
    mv "$items.tmp" "$items"
  ) 9> "$cache/lock"
}

# [FOOTER]: from the background, the list open in fzf reloads what was just written, FOOTER under it (--refresh)
nudge() {
  if [ -n "${1:-}" ]; then echo "$1" > "$cache/said.tmp" && mv "$cache/said.tmp" "$cache/said"; fi
  if [ -n "${FZF_SOCK:-}" ]; then curl -s --unix-socket "$FZF_SOCK" -d "transform(t-roadmap --refresh)" http > /dev/null || true; fi
}

# MESSAGE: what GitHub refused, on the roadmap's row on the board until its next poll, and under the list if it is open
refused() {
  local watch
  watch=$(grep -lx "$T_ROADMAP" /dev/null "$T_TASKS"/*/roadmap | head -1)
  echo "$1" > "${watch%/roadmap}/note.tmp"
  mv "${watch%/roadmap}/note.tmp" "${watch%/roadmap}/note"
  nudge "$C_RED$1$C_OFF"
}

# the list open in fzf, again, with what the background said under it; nothing while a prompt or the statuses are up
refresh() {
  local said rows="t-roadmap --rows"
  said=$(cat "$cache/said" 2> /dev/null || true)
  rm -f "$cache/said"
  case ${FZF_PROMPT:-$top} in
    *" note> " | *" status> " | *" title> ") return ;;
    "$top") ;;
    *) rows+=" '$(cat "$cache/parent")'" ;;
  esac
  echo "reload~CLICOLOR_FORCE=1 $rows~+change-footer~${said:-$(footer)}~"
}

# CREATE TITLE: a new issue with that title, in the repo and under the parent ^n picked: on this list at once as #…,
# while GitHub makes it in the background (send)
create() {
  local repo parent pending
  read -r repo parent < "$cache/picked"
  if [ -z "$1" ]; then echo "change-footer~$(hint enter "type its title first" esc back)~"; return; fi
  pending="$repo#new-$(date +%s%N)"
  rewrite 'map(if .key == $parent then .total += 1 else . end)
    + [{key: $key, item: null, repo: $repo, number: null, title: $title, state: "OPEN", status: null, onboard: true,
        parent: (if $parent == "" then null else $parent end), done: 0, total: 0, author: "you", assignees: [], labels: [],
        created: now | floor, updated: now | floor, last: now | floor, lift: "no status", url: "", body: "", comments: []}]' \
    --arg key "$pending" --arg repo "$repo" --arg title "$1" --arg parent "$parent"
  setsid t-roadmap --send "$pending" < /dev/null > /dev/null 2>&1 &
  echo "$(back_to "$parent")+change-footer~$1: GitHub is making it~"
}

# SEND ISSUE: GitHub makes the issue ^n put on this list as #…, and there it takes its number; if GitHub can't, it leaves
send() {
  local line parent out key item
  line=$(issue "$1")
  parent=$(jq -r '.parent // ""' <<< "$line")
  if ! out=$("$T_ROOT/roadmaps/$roadmap" create "$project" "$(jq -r .repo <<< "$line")" "$(jq -r .title <<< "$line")" \
             ${parent:+"$parent"} 2>&1); then
    rewrite 'map(select(.key != $pending) | if .key == $parent then .total -= 1 else . end)' --arg pending "$1" --arg parent "$parent"
    refused "GitHub didn't make “$(jq -r .title <<< "$line")”: $(tail -1 <<< "$out" | sed 's/^t: //')"
    return
  fi
  read -r key item <<< "$(tail -1 <<< "$out")"
  rewrite 'map(if .key == $pending then .key = $key | .item = $item | .number = ($key | sub(".*#"; "") | tonumber) else . end)' \
    --arg pending "$1" --arg key "$key" --arg item "$item"
  nudge "$(number "$key") is on the project; $(key status) gives it a status"
}

# MOVE ISSUE STATUS: the issue at that status on this list at once, while GitHub hears it in the background (moved)
move() {
  local was
  was=$(issue "$1")
  mark "$1" "$2"
  setsid t-roadmap --moved "$1" "$2" "$was" < /dev/null > /dev/null 2>&1 &
  echo "$(back)+change-footer~$(number "$1") is $2 now~"
}

# MOVED ISSUE STATUS WAS: GitHub hears the move; if it can't, the issue is back as WAS, its line before it
moved() {
  local out
  if ! out=$("$T_ROOT/roadmaps/$roadmap" move "$project" "$1" "$(jq -r '.item // empty' <<< "$3")" "$2" 2>&1); then
    rewrite 'map(if .key == $key then $was else . end)' --arg key "$1" --argjson was "$3"
    refused "GitHub didn't move $(number "$1") to $2: ${out#t: }"
  fi
}

# COMPOSE ISSUE NOTE: t compose on the issue in its repo, its title typed, and the issue, its comments and your note as
# details, where you pick the pipeline, the agent and the repo. Once the task is made, GitHub hears the rest in the
# background (start). What came of it waits in $cache/made for the footer (made).
compose() {
  local line repo id
  rm -f "$cache/made"
  line=$(issue "$1")
  if ! repo=$(repo_for "$(jq -r .repo <<< "$line")"); then
    echo "${C_RED}no repo in repos/ has a git remote on github.com/$(jq -r .repo <<< "$line"); add it: repos/NAME/env$C_OFF" > "$cache/made"
    return
  fi
  id=$({ echo "issue: $1"; issue_md "$1" | sed 1d; if [ -n "$2" ]; then printf '\n## My note\n\n%s\n' "$2"; fi; } |
       t-compose -r "$repo" --title "$(jq -r .title <<< "$line")" -) || true
  [ -n "$id" ] || return 0
  setsid t-roadmap --start "$1" < /dev/null > /dev/null 2>&1 &
  echo "task $(task_num "$id") works on $(number "$1"); GitHub hears it is In progress, and yours" > "$cache/made"
}
made() { echo "$(back)+change-footer~$(cat "$cache/made" 2> /dev/null || echo "no task made")~"; }

# START ISSUE: GitHub hears the issue is In progress and yours. It runs in the background, so if GitHub can't be told,
# the roadmap's row on the board says so until its next poll.
start() {
  local out
  if out=$("$T_ROOT/roadmaps/$roadmap" start "$project" "$1" "$(issue "$1" | jq -r '.item // empty')" 2>&1); then
    mark "$1" "In progress"
    nudge
  else
    refused "GitHub didn't hear $(number "$1") is In progress: ${out#t: }"
  fi
}

# MARK ISSUE STATUS: the issue at that status on this list, before the watch polls again
mark() {
  rewrite 'map(if .key == $key then .status = $status | .onboard = true
    | .lift = (if .lift == "stalled" and $status == "In progress" then "stalled" else null end) else . end)' \
    --arg key "$1" --arg status "$2"
}

# what key $1 does to row $2, as fzf actions. ^t turns the prompt into your note and ^s the list into the statuses,
# and enter or esc ends either.
act() {
  case ${FZF_PROMPT:-} in
    *" note> ")
      case $1 in
        enter) echo "execute~t-roadmap --compose '$(cat "$cache/picked")' {q}~+transform~t-roadmap --made~" ;;
        esc)   back ;;
        \?)    echo "put(?)" ;;
      esac
      return ;;
    *" status> ")
      case $1 in
        enter) move "$(cat "$cache/picked")" "$2" ;;
        esc)   back ;;
      esac
      return ;;
    *" title> ")
      case $1 in
        enter) create "${FZF_QUERY:-}" ;;
        esc)   back_to "$(cut -s -d' ' -f2 "$cache/picked")" ;;
        \?)    echo "put(?)" ;;
      esac
      return ;;
  esac
  if [ "$1" = esc ]; then
    if [ "${FZF_PROMPT:-$top}" = "$top" ]; then echo abort; else back; fi
    return
  fi
  if [ "$1" = "$(key_of keys)" ]; then                  # the label says the pane is showing the keys
    if [ -n "${FZF_PREVIEW_LABEL:-}" ]; then echo "change-preview-label()+change-preview~CLICOLOR_FORCE=1 t-roadmap --pane {1}~"
    else echo "change-preview-label( keys )+change-preview~CLICOLOR_FORCE=1 t-roadmap --keys~"; fi
    return
  fi
  if [ "$1" = "$(key_of issue)" ]; then                 # in the list of sub-issues opened last, or the project's own
    local parent= repo
    if [ "${FZF_PROMPT:-$top}" != "$top" ]; then parent=$(cat "$cache/parent"); fi
    repo=${parent%#*}
    if [ -z "$repo" ] && [ "${2:--}" != - ]; then repo=$(issue "$2" | jq -r .repo); fi
    if [ -z "$repo" ]; then repo=$(jq -rn 'first(inputs.repo) // empty' "$items" 2> /dev/null || true); fi
    [ -n "$repo" ] || { echo "change-footer~no issue on the project yet to take its repo from~"; return; }
    echo "$repo $parent" > "$cache/picked"
    local asked="$repo title> "
    if [ -n "$parent" ]; then asked="$(number "$parent") sub-issue title> "; fi
    echo "disable-search+clear-query+change-prompt~$asked~+change-footer~$(hint enter "make it, with no status" esc back)~"
    return
  fi
  [ "$2" != - ] || return 0
  if [[ $2 == *#new-* ]]; then echo "change-footer~GitHub is still making it~"; return; fi
  case $(awk -v k="$1" '$2 == k { print $1; exit }' <<< "$ROADMAP_KEYS") in
    open)
      if [ "$(issue "$2" | jq .total)" -gt 0 ]; then
        echo "$2" > "$cache/parent"
        sub_issues "$2"
      else
        echo "change-footer~$(number "$2") has no sub-issues; $(key task) makes it a task~"
      fi ;;
    task)
      local task
      task=$(working_on "$2")
      if [ -n "$task" ]; then echo "change-footer~task $(task_num "$task") already works on $(number "$2")~"; return; fi
      echo "$2" > "$cache/picked"
      echo "disable-search+clear-query+change-prompt~$(number "$2") note> ~+change-footer~$(hint enter "then the pipeline, agent and repo (no note is fine)" esc back)~" ;;
    status)
      echo "$2" > "$cache/picked"
      echo "clear-query+reload~CLICOLOR_FORCE=1 t-roadmap --statuses '$2'~+change-prompt~$(number "$2") status> ~+change-footer~$(hint enter "move it there" esc back)~+first" ;;
    drop)
      echo "$2" >> "$cache/not-mine"
      echo "reload~CLICOLOR_FORCE=1 t-roadmap --rows~+change-footer~$(number "$2") is off your list; GitHub keeps it as it is~" ;;
  esac
}

case ${1:-} in
  --rows)     rows "${2:-}"; exit ;;
  --statuses) statuses "$2"; exit ;;
  --compose)  compose "$2" "${3:-}"; exit ;;
  --made)     made; exit ;;
  --start)    start "$2"; exit ;;
  --send)     send "$2"; exit ;;
  --moved)    moved "$2" "$3" "$4"; exit ;;
  --refresh)  refresh; exit ;;
  --pane)     pane "$2"; exit ;;
  --keys)     keys; exit ;;
  --key)      act "$2" "$3"; exit ;;
esac

command -v fzf > /dev/null || die "the roadmap needs fzf (sudo apt install fzf); what the watch keeps is in $items"
sock=${XDG_RUNTIME_DIR:-/tmp}/tick-roadmap-$$.sock    # a socket's path can't be longer than 107 bytes; $T_VAR may be
binds=(--bind "esc:transform:t-roadmap --key esc {1}")
while read -r _ key _; do
  binds+=(--bind "$key:transform:t-roadmap --key '$key' {1}")
done <<< "$ROADMAP_KEYS"
CLICOLOR_FORCE=1 t-roadmap --rows | fzf "${BOARD_FZF[@]}" --delimiter $'\t' --with-nth 2.. --prompt "$top" --info inline-right \
  --footer "$(footer)" --preview 'CLICOLOR_FORCE=1 t-roadmap --pane {1}' \
  --preview-window 'right,50%,wrap,border-left,<60(down,60%,border-top)' "${PANE_SCROLL[@]}" "${binds[@]}" \
  --listen "$sock" || true
rm -f "$sock"
