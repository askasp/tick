#!/usr/bin/env bash
# t agent [-f] [TASK] [claude|opencode] — who solves every step of a task from its next run on; left out, the next one, then its pipeline's again
#
# -f cancels the step running now, so it runs again on the new agent: a step stuck on opencode goes to claude.
# t new --cli does this for a new task. It lives in the task's env as AGENT_CLI.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
force=
if [ "${1:-}" = -f ]; then force=1; shift; fi
task=$(task_dir "${1:-}")
n=$(task_num "$task") cli=${2-$(next_cli "$(env_get "$task/env" AGENT_CLI)")}
if [ -n "$cli" ] && [ ! -x "$T_ROOT/drivers/$cli" ]; then
  die "no driver '$cli'; there are: $(ls "$T_ROOT/drivers" | xargs)"
fi
{
  grep -v '^AGENT_CLI=' "$task/env" 2> /dev/null || true
  if [ -n "$cli" ]; then echo "AGENT_CLI=$cli"; fi
} > "$task/env.tmp" && mv "$task/env.tmp" "$task/env"
if [ -n "$cli" ]; then who="$cli solves every step"; else who="its pipeline's agents solve it again"; fi

if flock -n "$task/lock" true; then echo "task $n: $who from its next run"; exit 0; fi
if [ -z "$force" ]; then echo "task $n: $who from its next run; to switch the running step too: t agent -f $n"; exit 0; fi
step=$(cat "$task/step")
stop "$task"
runs=$task/runs/$step
if [ -f "$runs" ]; then echo $(( $(cat "$runs") - 1 )) > "$runs.tmp" && mv "$runs.tmp" "$runs"; fi   # switching isn't a run
echo "$(date '+%F %T') $n $step cancelled for another agent" >> "$task/history"
echo "task $n: $who; ${step#*-} runs again on the next tick (or now: t run $n)"
