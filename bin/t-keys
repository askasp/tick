#!/usr/bin/env bash
# t keys [TASK] — the keys t ui's header offers for a task: the ones worth pressing now, Enter doing the first
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
t=$(task_dir "${1:-}") || exit 1
st=$(state "$t") k= c= o=
if [ -t 1 ] || [ -n "${CLICOLOR_FORCE:-}" ]; then k=$C_PURPLE c=$C_TEXT o=$C_OFF; fi

keys=
for a in $(offers "$t"); do
  label=$a key=$(awk -v a="$a" '$1 == a { print $2 }' <<< "$ACTIONS")
  [ "$a" != hold ] || [ "$st" != HOLD ] || label=resume
  [ "$a" != log ] || [[ $st != after* ]] || label="log ${st#after }"      # nothing to watch here yet
  if [ -z "$keys" ]; then keys="$k⏎$c $label"; else keys+="  $k$(keyname "$key")$c $label"; fi
done
echo "$keys  $k?$c more$o"
