#!/usr/bin/env bash
# t rm [TASK] — delete a task and its worktree (the branch stays)
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
task=$(task_dir "${1:-}")
id=${task##*/} n=$((10#${task##*/}))
flock -n "$task/lock" true || die "task $n is running; t hold $n, and remove it when it stops"
for other in "$T_TASKS"/*/; do
  if [ "$(cat "$other/after" 2> /dev/null)" = "$id" ]; then
    die "task $((10#$(basename "$other"))) is stacked on $n; remove that one first"
  fi
done

branch=$(cat "$task/branch" 2> /dev/null || true)
if [ -d "$task/work" ] && [ ! -L "$task/work" ]; then
  git -C "$(cat "$task/repo")" worktree remove --force "$task/work"
fi
rm -rf "$task"
echo "t: removed task $n${branch:+; branch $branch is still there}" >&2
