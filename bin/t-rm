#!/usr/bin/env bash
# t rm [-f] [TASK] — delete a task and its worktree (the branch stays); -f first stops its run, agent and all
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
force=
if [ "${1:-}" = -f ]; then force=1; shift; fi
task=$(task_dir "${1:-}")
id=${task##*/} n=$(task_num "$task")
for other in "$T_TASKS"/*/; do
  if [ "$(cat "$other/after" 2> /dev/null)" = "$id" ]; then
    die "task $(task_num "${other%/}") is stacked on $n; remove that one first"
  fi
done
if ! flock -n "$task/lock" true; then
  [ -n "$force" ] || die "task $n is running; stop it and delete it with: t rm -f $n"
  stop "$task"
fi
rm -f "$task/step"     # off the board and out of the tick now; the teardown may take a while

branch=$(cat "$task/branch" 2> /dev/null || true)
work=$(readlink -f "$task/work" 2> /dev/null || true)
if [ -d "$work" ]; then
  teardown=$(load_env "$task" > /dev/null 2>&1; echo "${TEARDOWN:-}")
  if [ -n "$teardown" ]; then (cd "$work" && bash -c "$teardown") || echo "t: teardown failed: $teardown" >&2; fi
  git -C "$(cat "$task/repo")" worktree remove --force "$work"
fi
rm -rf "$task"
echo "t: removed task $n${branch:+; branch $branch is still there}" >&2
