#!/usr/bin/env bash
# t inbox [TASK] — the mail or chat a watch keeps, newest first, its thread beside it: enter opens the thread to write under it, ? every key
#
# The watch is a task on a pipeline like front-inbox or slack-inbox (t new -p front-inbox "front inbox"), and Enter on its
# row opens this. Enter here is t thread: the conversation the width of the screen, with what you write typed under it,
# which holds on the board until you sign it. What involves you comes first; under a rule, channels that don't, as a
# count. The list is what the watch last read, and ^x archives (in Slack: marks read) where it lives. A conversation
# says unread until t thread opens it, then how many messages others wrote since, and its subject dims once read.
# fzf runs t-inbox for what changes: --rows, --changed (the rows once the watch writes), --pane ID, --keys, --key KEY ID (what KEY does to it)
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
shopt -s nullglob

if [ -z "${T_INBOX:-}" ]; then                       # the watch you named, else the first there is
  watches=("$T_TASKS"/*/inbox)
  watch=${watches[0]:-}
  if [ -n "${1:-}" ]; then watch=$(task_dir "$1")/inbox; fi
  [ -f "$watch" ] || die "no inbox is watched${1:+ by task $1}; start one: t new -p front-inbox \"front inbox\""
  export T_INBOX
  T_INBOX=$(cat "$watch")
fi
mail=$T_VAR/mail/$T_INBOX
archive=$("$T_ROOT/sources/$T_INBOX" can archive 2> /dev/null || echo archive)   # what ^x is called where the mail lives
terminal_colors

# why a conversation is on the list, in a word: mention (a teammate names you), assigned, dm, thread (one you are in),
# replied; a channel that doesn't involve you has none
reason() {
  case " $1 " in
    *" mention "*)     echo mention ;;
    *" assigned "*)    echo assigned ;;
    *" dm "*)          echo dm ;;
    *" thread "*)      echo thread ;;
    *" participant "*) echo replied ;;
  esac
}

# what conversation $1 has that you haven't read: unread if t thread never opened it, else how many messages others
# wrote since it did (2 new), else nothing. A channel the watch keeps only as a count has no thread to count in: new
# if something came in after you opened it
news() {
  local thread=$mail/$1/thread.md n
  if [ ! -f "$thread" ]; then
    if [ -f "$mail/$1/read" ] && jq -e --argjson read "$(cat "$mail/$1/read")" '(.updated_at // 0) > $read' "$mail/$1/conv.json" > /dev/null; then
      echo new
    fi
    return 0
  fi
  if [ ! -f "$mail/$1/read" ]; then
    if [ "$(said_since "$thread" 0)" -gt 0 ]; then echo unread; fi
    return 0
  fi
  n=$(said_since "$thread" "$(cat "$mail/$1/read")")
  if [ "$n" -gt 0 ]; then echo "$n new"; fi
}

# a conversation a line, the id first for fzf and hidden: 11:02  anna@stadler.no  Q3 invoice discrepancy  mention  2 new  task 14.
# What involves you comes first, then a rule (id -), then the channels that don't.
rows() {
  local id when where about why word color news shade task
  cat /dev/null "$mail"/*/conv.json | jq -rs --argjson midnight "$(date -d 00:00 +%s)" '
    (map(select(.why != "channel")) | sort_by(-.updated_at)) as $yours
    | (map(select(.why == "channel" and (.unread // 1) > 0)) | sort_by(-.updated_at)) as $rest   # one you read in Slack is gone
    | ($yours + (if $yours != [] and $rest != [] then [{id: "-"}] else [] end) + $rest)[]
    | [.id, (.updated_at // 0 | strflocaltime(if . >= $midnight then "%H:%M" else "%d %b" end)),
       .where // .from // "", .about // .subject // "(no subject)", .why // ""]
    | join("\u001f")' |
    while IFS=$'\x1f' read -r id when where about why; do
      if [ "$id" = - ]; then printf -- '-\t%s%s%s\n' "$C_FAINT" "$(printf '%*s' 95 '' | sed 's/ /─/g')" "$C_OFF"; continue; fi
      task=$(reply_to "$T_INBOX" "$id") word=$(reason "$why") color=$C_DIM news=$(news "$id") shade=
      if [ "$word" = mention ]; then color=$C_RED; fi       # the one tag that reaches you nowhere else
      if [ -n "$news" ]; then shade=$C_BRIGHT; elif [ -f "$mail/$id/read" ]; then shade=$C_DIM; fi
      if [ "${#where}" -gt 24 ]; then where=${where:0:23}…; fi
      if [ "${#about}" -gt 44 ]; then about=${about:0:43}…; fi
      printf '%s\t%s%-6s%s  %s  %s  %s  %s%s\n' "$id" "$C_DIM" "$when" "$C_OFF" "$(pad 24 "$where")" "$(pad 44 "$about" "$shade$about$C_OFF")" \
        "$(pad 8 "$word" "$color$word$C_OFF")" "$(pad 7 "$news" "$C_MID$news$C_OFF")" "${task:+  ${C_DIM}task $(task_num "$task")$C_OFF}"
    done
}

# the rows, once the watch has written a conversation or dropped one: an inbox left open shows what came in since
changed() {
  local was
  was=$(stat -c '%n %y' "$mail" "$mail"/*/)
  while sleep 1; do
    if [ "$(stat -c '%n %y' "$mail" "$mail"/*/)" != "$was" ]; then break; fi
  done
  rows
}

count() { if [ "$1" = 1 ]; then echo "1 $2"; else echo "$1 ${2}s"; fi; }

pane() {
  local task messages comments news
  [ -f "$mail/$1/conv.json" ] || return 0
  messages=$(grep -c '^## ' "$mail/$1/thread.md" || true)
  comments=$(grep -c '^### └ comment' "$mail/$1/thread.md" || true)
  news=$(news "$1")
  echo "$C_BRIGHT$(jq -r '.subject // "(no subject)"' "$mail/$1/conv.json")$C_OFF"
  echo "$C_DIM$(jq -r '.meta // "\(.from) · \(.why)"' "$mail/$1/conv.json") · $(count "$messages" message)$(if [ "$comments" -gt 0 ]; then echo ", $(count "$comments" comment)"; fi)${news:+ · $news}$C_OFF"
  if [ -s "$mail/$1/gist" ]; then echo; cat "$mail/$1/gist"; fi
  task=$(reply_to "$T_INBOX" "$1")
  if [ -n "$task" ]; then echo; echo "${C_DIM}task $(task_num "$task")$C_OFF  $(standing "$task")"; fi
  echo
  if [ -f "$mail/$1/thread.md" ]; then thread_view "$mail/$1/thread.md"
  else echo "${C_DIM}Nothing here involves you, so only its count was read. Enter reads it.$C_OFF"; fi
  echo
  echo                                                            # room under the last message, so it reads as the end
}

# every key the inbox binds, and what it does
keys() {
  local name key what
  while read -r name key what; do
    if [ "$name" = archive ]; then name=$archive; fi
    echo "$C_MID$(pad 7 "$(keyname "$key")")$C_OFF$(pad 11 "$name")$C_DIM$what$C_OFF"
  done <<< "$INBOX_KEYS"
  echo "${C_MID}^d ^u  ${C_OFF}scroll     ${C_DIM}the pane, half a page; PgDn/PgUp a page, Shift-↓/↑ a line$C_OFF"
  echo "${C_MID}esc    ${C_OFF}back       ${C_DIM}to the board$C_OFF"
  echo
  echo "${C_DIM}Type to filter: mention lists every conversation that mentions you.$C_OFF"
}

# what key $1 does to conversation $2, as fzf actions
act() {
  local out
  [ "$2" != - ] || return 0                            # the rule between what involves you and the rest
  case $(awk -v k="$1" '$2 == k { print $1; exit }' <<< "$INBOX_KEYS") in
    open)
      echo "execute(t-thread $2)+reload(CLICOLOR_FORCE=1 t-inbox --rows)" ;;
    archive)
      if out=$("$T_ROOT/sources/$T_INBOX" archive "$2" 2>&1); then
        rm -rf "${mail:?}/$2"
        echo "up+reload(CLICOLOR_FORCE=1 t-inbox --rows)+change-footer~done: $archive in $T_INBOX~"   # the cursor goes to the row above
      else
        echo "change-footer~$C_RED${out#t: }$C_OFF~"
      fi ;;
    unread)
      rm -f "$mail/$2/read"
      tell "$T_INBOX" unread "$2"
      echo "reload(CLICOLOR_FORCE=1 t-inbox --rows)" ;;
    keys)                                               # the label says the pane is showing the keys
      if [ -n "${FZF_PREVIEW_LABEL:-}" ]; then
        echo "change-preview-label()+change-preview~CLICOLOR_FORCE=1 t-inbox --pane {1}~"
      else
        echo "change-preview-label( keys )+change-preview~CLICOLOR_FORCE=1 t-inbox --keys~"
      fi ;;
  esac
}

case ${1:-} in
  --rows)  rows; exit ;;
  --changed) changed; exit ;;
  --pane)  pane "$2"; exit ;;
  --keys)  keys; exit ;;
  --key)   act "$2" "$3"; exit ;;
esac

command -v fzf > /dev/null || die "the inbox needs fzf (sudo apt install fzf); what the watch keeps is in $mail"
binds=()
while read -r _ key _; do
  binds+=(--bind "$key:transform:t-inbox --key '$key' {1}")
done <<< "$INBOX_KEYS"
CLICOLOR_FORCE=1 t-inbox --rows | fzf "${BOARD_FZF[@]}" --delimiter $'\t' --with-nth 2.. --prompt "$T_INBOX> " --info inline-right --track \
  --bind 'load:reload-sync(CLICOLOR_FORCE=1 t-inbox --changed)' \
  --footer "$(hint enter open "$(key archive)" "$archive" "$(key keys)" keys esc back)" \
  --preview 'CLICOLOR_FORCE=1 t-inbox --pane {1}' --preview-window 'right,50%,follow,wrap,~2,border-left,<60(down,60%,border-top)' \
  "${PANE_SCROLL[@]}" "${binds[@]}" || true
