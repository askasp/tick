#!/usr/bin/env bash
# t ui [TASK [ACTION]] — the live board (plain `t` opens it): what each task is doing, a pane on the one
# you're on, and keys that act on it without leaving it: when a key needs words (new, stack, say, hold,
# name) the prompt takes them, and the pane shows what will happen. With a TASK: the menu of what to do
# with it; with an ACTION, that at once (next: whatever Enter does for it). `t ui +` starts a new task.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
ask() { local answer; read -rp "$1 " answer < /dev/tty; echo "$answer"; }

# fzf runs t-ui for everything on the board that changes:
#   --rows               the board's rows
#   --changed            the same, once the board has changed
#   --onload ID QUERY    what fzf does when rows come in: move the cursor, then wait for --changed
#   --pane ID QUERY      the pane
#   --key KEY ID QUERY   what KEY does now (ID is empty on an empty board); the keys are in lib/board.sh
# $T_UI/mode is "board", or "MODE ID" while the prompt takes words for new, stack, say, hold, name or the
# action to do (? asks), or waits on clean; $T_UI/pick is the pipeline (new, stack) or the step (say) chosen,
# and $T_UI/list the list behind the prompt: the tasks, or the pipelines that new opens on and ^p brings up.

# how wide a row can be: fzf's columns less the list's borders and pointer, less the pane beside them
list_width() {
  local cols=${FZF_COLUMNS:-}
  if [ -z "$cols" ]; then read -r _ cols < <(stty size < /dev/tty 2> /dev/null); fi
  cols=$((${cols:-200} - 6))
  if [ $((cols * 45 / 100)) -ge 60 ]; then cols=$((cols * 55 / 100)); fi
  echo "$cols"
}

# the tasks, then your own list as one row under them
board_rows() {
  local cols
  cols=$(list_width)
  T_COLOR=1 T_COLS=$cols board -a
  T_COLS=$cols CLICOLOR_FORCE=1 t-later --row
}

# the step task $1 starts over at, by name
first_step() { local s; s=$(steps "$(cat "$1/pipeline")" "$1" | head -1); echo "${s#*-}"; }

# the line task $1 is on in the board's list
row_of() { board -a | awk -v n="$(task_num "$1")" '$1 == n { print NR; exit }'; }

# where the cursor goes when task $1 is deleted: the row above it, else the one below
neighbour() {
  local ids i
  ids=($(board -a | awk '{ print $1 }'))
  for i in "${!ids[@]}"; do
    [ "${ids[i]}" = "$1" ] || continue
    if [ "$i" -gt 0 ]; then echo "${ids[i - 1]}"
    elif [ -n "${ids[i + 1]:-}" ]; then echo "${ids[i + 1]}"
    fi
    return
  done
}

if [ "${1:-}" = --rows ]; then board_rows; exit; fi

# the repo whose PIPELINE= is pipeline $1
repo_naming() {
  local d
  for d in "$T_ROOT"/repos/*/; do
    d=${d%/}
    if [ "$(profile_get "${d##*/}" PIPELINE)" = "$1" ]; then echo "${d##*/}"; return; fi
  done
}

# ^p in the new and stack forms: the tasks give way to the pipelines you start by hand, the default first,
# to be scrolled and searched as the tasks are; enter on one picks it. A row is the name, its kind, and
# what it works on: the repo for code, the agent for a question. A pipeline with no repo that doesn't
# answer (a reply, a watch) starts from elsewhere, and t new -p still reaches it.
if [ "${1:-}" = --pipelines ]; then
  def=$(cat "$T_UI/def" 2> /dev/null)
  for p in $(pipelines "${def:-$T_PIPELINE}"); do
    if [[ $(steps "$p") == [0-9]*-answer ]]; then kind=answer target=$(solver "$p" answer)
    elif no_repo "$p"; then continue
    else
      kind=code target=$(env_get "$T_ROOT/pipelines/$p/env" REPO)
      target=${target:-$(repo_naming "$p")}
    fi
    printf '%-17s%s%-9s%s%s%s%s\n' "$p" "$C_DIM" "$kind" "$C_OFF" "$C_MID" "${target##*/}" "$C_OFF"
  done
  exit
fi

# a reload reruns the pane, which loses your place in it: reload as soon as a task moves, and for
# what the agents are doing and the board's stats only every 14 seconds. It keeps $T_UI/stats warm:
# the footer (drawn on every cursor move) reads that file, so nvidia-smi never runs on a scroll.
if [ "${1:-}" = --changed ]; then
  moves() {
    local t
    for t in "$T_TASKS"/*/; do
      if [ -f "$t/step" ]; then echo "$t $(cat "$t/step") $(state "$t")"; fi
    done
  }
  put_stats() { [ -n "${T_UI:-}" ] && echo "$1" > "$T_UI/stats.tmp" && mv "$T_UI/stats.tmp" "$T_UI/stats"; }
  was=$(moves) all=$(board -a; t-later --row) i=0
  stats=$(board_stats); put_stats "$stats"
  while sleep 2; do
    i=$((i + 1))
    if [ "$(moves)" != "$was" ]; then break; fi
    if [ $((i % 7)) -ne 0 ]; then continue; fi
    fresh=$(board_stats); put_stats "$fresh"
    [ "$(board -a; t-later --row)" = "$all" ] && [ "$fresh" = "$stats" ] || break
  done
  board_rows
  exit
fi

# each reload ends by waiting for the next change, and first moves the cursor to the task in
# $T_UI/new (one just made, or the neighbour of one just deleted): only then is the list the new
# one, so a pos() chained right after a reload would land on the old list. A cursor that stays
# gets the keys of its task as it is now.
if [ "${1:-}" = --onload ]; then
  row= keys=
  if [ "$(cat "$T_UI/list" 2> /dev/null)" != pipelines ]; then   # the pipelines list never changes
    if [ -s "$T_UI/new" ]; then
      row=$(row_of "$(cat "$T_UI/new")")
      rm -f "$T_UI/new"
    fi
    if [ -z "$row" ]; then keys=$(t-ui --key focus "${2:-}" "${3:-}"); fi
    printf '%s%sreload-sync~t-ui --changed~' "${row:+pos($row)+}" "${keys:+$keys+}"
  fi
  exit
fi

if [ "${1:-}" = --pane ]; then
  id=$2 q=${3:-} pick=$(cat "$T_UI/pick")
  read -r mode target < "$T_UI/mode"
  task=
  if [[ ${target:-} == [0-9]* ]]; then task=$(tdir "$target"); fi
  case $mode in
    new | stack)
      if [ "$(cat "$T_UI/list" 2> /dev/null)" = pipelines ]; then
        show=${2:-$pick} typed=$(cat "$T_UI/title" 2> /dev/null)    # the pipeline under the cursor
      else show=$pick typed=$q; fi
      echo "$C_BRIGHT$show$C_OFF  ${C_FAINT}$(key pipeline):pipelines$C_OFF"
      echo
      CLICOLOR_FORCE=1 exec t-compose --dry "$show" "$typed" ;;
    say)
      echo "$(strip "$pick" $(restart_steps "$task"))  ${C_FAINT}tab:restart step$C_OFF"
      echo
      echo "${C_DIM}task $target$C_OFF  $(name "$task")"
      status "$task"
      step=${pick#+}
      if [ -n "$q" ]; then what="goes to feedback.md; the task restarts at"
      elif [ "$pick" != "$(first_step "$task")" ]; then what="nothing said: the task restarts at"
      else what="type what to change; the task restarts at"; fi
      echo "$C_DIM$what$C_OFF $step ${C_DIM}on the next tick$C_OFF"
      if [ "$pick" != "$step" ]; then echo "${C_DIM}It left out $step, which becomes one of its steps.$C_OFF"; fi
      if [ "$(state "$task")" = running ]; then echo "${C_BRIGHT}It is running: enter stops it first.$C_OFF"; fi
      who=$(cat "$T_UI/cli")
      who=${who:-$(solver "$(cat "$task/pipeline")" "$step" "$task")}
      if [ -n "$who" ]; then echo "${C_DIM}solved by$C_OFF $who  ${C_FAINT}$(key agent):another$C_OFF"; else echo; fi
      echo
      CLICOLOR_FORCE=1 t-log "$target" | tail -n 60 ;;
    hold)
      echo "${C_BRIGHT}hold$C_OFF  ${C_DIM}task $target · $(name "$task")$C_OFF"
      echo
      echo "The tick leaves it alone until you resume it: $(key hold) again."
      if [ "$(state "$task")" = running ]; then echo "It is running: the step running now finishes first. To stop it now instead: esc, then $(key keys) and cancel."; fi
      echo
      echo "${C_DIM}The board will say:$C_OFF ${C_RED}held$C_OFF  ${q:-held by hand}" ;;
    name)
      echo "${C_BRIGHT}name$C_OFF  ${C_DIM}task $target$C_OFF"
      echo
      echo "${C_DIM}title$C_OFF  $(title "$task")"
      echo "${C_DIM}now$C_OFF    $(name "$task")"
      echo
      echo "${C_DIM}The board shows the name, and t show the whole title. Empty: an agent picks a short one.$C_OFF" ;;
    clean)
      echo "${C_RED}delete$C_OFF  ${C_DIM}every task done, answered or held for 12 hours, and its worktree$C_OFF"
      echo
      t-clean -n
      echo
      echo "${C_DIM}The branches stay.$C_OFF" ;;
    do)
      echo "${C_BRIGHT}task $target$C_OFF  ${C_DIM}$(name "$task")$C_OFF"
      echo
      first=$(offers "$task" | cut -d' ' -f1)
      while read -r action key what; do
        if [ "$action" = "$first" ]; then key=enter; fi
        echo "$C_MID$(pad 7 "$(keyname "$key")")$C_OFF$(pad 8 "$action")$C_DIM$what$C_OFF"
      done <<< "$ACTIONS"
      echo
      for pair in "$(key new)|new task" "$(key clean)|delete what is done, answered or held for 12h" "tab|the pane: show, steps, log, diff" "^d ^u|scroll the pane" "^w|a wide pane, and back" \
                  "$(key keys) esc|back to the board"; do
        echo "$C_MID$(pad 7 "${pair%%|*}")$C_OFF$C_DIM${pair#*|}$C_OFF"
      done
      echo
      echo "${C_DIM}Type an action, or its first letters, and enter does it.$C_OFF"
      session=$(cat $(ls -tr "$task"/log/*.log 2> /dev/null) /dev/null | grep '^session: ' | tail -1)   # what t attach resumes
      if [ -n "$session" ]; then
        read -r _ cli session_id _ <<< "$session"
        echo "${C_DIM}session$C_OFF $cli $session_id"
      fi ;;
    *)
      if [ -z "$id" ]; then echo "no tasks yet: $(key new) starts one"
      elif [ "$id" = later ]; then CLICOLOR_FORCE=1 exec t-later --pane
      else CLICOLOR_FORCE=1 exec t-peek "$id" "$(cat "$T_UI/pane")"
      fi ;;
  esac
  exit
fi

if [ "${1:-}" = --key ]; then
  key=$2 id=$3 q=${4:-} pick=$(cat "$T_UI/pick")
  read -r mode target < "$T_UI/mode"
  named() { printf '%s\n' "$@" | awk -v k="$key" '$2 == k { print $1; exit }'; }   # what $key is in tables $@
  footer() {   # the board's bottom line: the keys for task $1, and the board's stats, if available
    local f stats
    if [ -z "$1" ]; then f=$(hint "$(key new)" new)
    elif [ "$1" = later ]; then f=$(hint enter "your own list" "$(key new)" new)
    else f=$(t-keys "$1" 2> /dev/null); fi
    stats=$(cat "$T_UI/stats" 2> /dev/null || board_stats)   # --changed keeps it warm; a cold start computes
    if [ -n "$stats" ]; then f="${f:+$f  }$stats"; fi
    echo "$f"
  }
  back() {   # to the board: its prompt, search and list, and the keys of task $1 (the cursor goes there on load)
    echo board > "$T_UI/mode"
    echo "change-prompt(task> )+enable-search+change-query()+change-preview-window(~2)+reload-sync~t-ui --rows~+refresh-preview+change-footer~$(footer "${1-$id}")~+rebind($(key_of keys))"
  }
  form() {   # the prompt takes words: mode $1 on $2, prompt $3, tab starting at $4, pane $5, keys $6, text $7
    local typed=
    if [ "$1" != do ]; then typed="+unbind($(key_of keys))"; fi   # ? is text there, and a paste of it runs nothing
    echo "$1 $2" > "$T_UI/mode"
    echo "$4" > "$T_UI/pick"
    echo "change-prompt($3)+disable-search+change-query~${7:-}~+change-preview-window($5)+refresh-preview+change-footer~$6~$typed"
  }
  follow_if_log() { case $1 in log | raw) echo follow ;; *) echo nofollow ;; esac; }
  show() { echo "$1" > "$T_UI/pane"; echo "change-preview-window($(follow_if_log "$1"))+refresh-preview"; }
  failed() { echo "change-footer~$C_RED$(grep -m1 . "$T_UI/err" | sed 's/^t: //')$C_OFF~"; exit; }
  keys() {   # the bottom line while the prompt takes words for $1, with the agent picked
    local agent
    agent=$(cat "$T_UI/cli")
    agent="agent ${agent:-default}"
    if [ "$(cat "$T_UI/list" 2> /dev/null)" = pipelines ]; then hint enter "this pipeline" "$(key agent)" "$agent" esc back; return; fi
    case $1 in
      new)   hint enter create "$(key pipeline)" pipeline "$(key agent)" "$agent" "$(key details)" details "$(key repo)" repo "$(key image)" image esc back ;;
      stack) hint enter create "$(key pipeline)" pipeline "$(key agent)" "$agent" "$(key details)" details "$(key image)" image esc back ;;
      say)   hint enter say tab "restart step" "$(key agent)" "$agent" esc back ;;
    esac
  }
  pipeline_list() {   # the list becomes the pipelines, the default first; a title typed before ^p waits in $T_UI/title
    echo pipelines > "$T_UI/list"
    echo "change-prompt(pipeline> )+enable-search+change-query()+change-footer~$(keys "$1")~+reload-sync~t-ui --pipelines~+pos(1)+refresh-preview"
  }
  pipeline_done() {   # from the pipelines: enter on one ($1) picks it; esc and ^p go back to the title
    if [ -n "$1" ]; then printf '%s\n' "$1" > "$T_UI/pick"; fi
    echo tasks > "$T_UI/list"
    case $mode in new) prompt="new> " ;; stack) prompt="stack on $target> " ;; esac
    echo "change-prompt($prompt)+disable-search+change-query~$(cat "$T_UI/title" 2> /dev/null)~+change-footer~$(keys "$mode")~+reload-sync~t-ui --rows~+refresh-preview"
  }
  new_form() {   # the pipeline first, then the title
    : > "$T_UI/args"; : > "$T_UI/repo"; : > "$T_UI/cli"; rm -f "$T_UI/title"
    default_pipeline > "$T_UI/def"
    echo "$(form new - "new> " "$(cat "$T_UI/def")" "nofollow,~2" "$(keys new)")+$(pipeline_list new)"
  }
  stack_form() {   # on an answer, a task made from it: in its repo's pipeline
    local task
    task=$(tdir "$1")
    : > "$T_UI/repo"; : > "$T_UI/cli"
    if [ -f "$task/answer.md" ]; then
      printf -- '--from\n%s\n' "$1" > "$T_UI/args"
      default_pipeline "$(cat "$task/repo" 2> /dev/null)" > "$T_UI/def"
      form stack "$1" "task from $1> " "$(cat "$T_UI/def")" "nofollow,~2" "$(keys stack)"
    else
      printf -- '--on\n%s\n' "$1" > "$T_UI/args"
      cat "$task/pipeline" > "$T_UI/def"
      form stack "$1" "stack on $1> " "$(cat "$T_UI/def")" "nofollow,~2" "$(keys stack)"
    fi
  }
  say_form() {
    local task
    task=$(tdir "$1")
    env_get "$task/env" AGENT_CLI > "$T_UI/cli"
    form say "$1" "say to $1> " "$(first_step "$task")" "follow,~6" "$(keys say)"
  }
  act_on() {   # action $1 on task $id, as $key asked
    local task
    task=$(tdir "$id")
    case $1 in
      log)    if [[ $(state "$task") == after* ]]; then   # queued: go to what it waits for
                echo log > "$T_UI/pane"
                echo "pos($(row_of "$(cat "$task/after")"))"
              elif [ "$key" = "$(key_of log)" ] && [ "$(pane "$task" "$(cat "$T_UI/pane")")" = log ]; then
                show raw                                 # its key again: the log as it is
              else show log; fi ;;
      diff)   if [ "$(pane_next "$task" log)" = diff ]; then echo "execute(t-diff $id)"   # a file at a time: its own screen
              else echo "change-footer~task $id has no change yet~"; fi ;;
      run)    if flock -n -s "$task/lock" true 2> /dev/null; then setsid t-run "$id" < /dev/null > /dev/null 2>&1 & fi
              echo log > "$T_UI/pane"
              echo "reload-sync~t-ui --rows~+change-preview-window(follow)+refresh-preview" ;;
      cancel) if [ "$(state "$task")" = running ]; then   # the board catches up once the run is gone
                setsid t-hold -f "$id" cancelled < /dev/null > /dev/null 2>&1 &
                echo "change-footer~stopping task $id…~"
              else
                echo "change-footer~task $id isn't running~"
              fi ;;
      hold)   if [ "$(state "$task")" = HOLD ]; then
                t-resume "$id" 2> /dev/null
                echo "reload-sync~t-ui --rows~+refresh-preview+change-footer~$(footer "$id")~"
              else
                form hold "$id" "hold $id because> " "" "nofollow,~2" "$(hint enter hold empty "held by hand" esc back)"
              fi ;;
      name)   form name "$id" "name $id> " "" "nofollow,~2" "$(hint enter rename empty "an agent picks one" esc back)" "$(name "$task")" ;;
      rm)     cursor=$(neighbour "$id")        # no asking: the branch stays, and a task stacked on it stops it
              force=
              if [ "$(state "$task")" = running ]; then force=-f; fi
              setsid -w t-rm $force "$id" < /dev/null > /dev/null 2> "$T_UI/err" &
              while [ -f "$task/step" ] && kill -0 $! 2> /dev/null; do sleep 0.05; done   # gone from the board, or refused
              if [ -f "$task/step" ]; then failed; fi
              if [ -n "$cursor" ]; then echo "$cursor" > "$T_UI/new"; fi
              back "$cursor" ;;
      say)    say_form "$id" ;;
      stack)  stack_form "$id" ;;
      attach) echo "execute(t-attach $id)+reload-sync~t-ui --rows~" ;;      # the agent's own screen: the one that leaves
      path)   echo "change-footer~$(t-path "$id" 2>&1 | sed 's/^t: //')~" ;;
      copy)   echo "change-footer~$(t-copy "$id" 2>&1 | sed 's/^t: //')~" ;;
      agent)  echo "refresh-preview+change-footer~$(t-agent "$id" 2>&1 | sed 's/^t: //')   $(key agent):another~" ;;
      inbox)  echo "execute(t-inbox $id)+reload-sync~t-ui --rows~+refresh-preview" ;;   # its own screen, like diff
      cal)    echo "execute(t-cal $id)+reload-sync~t-ui --rows~+refresh-preview" ;;
      roadmap) echo "execute(t-roadmap $id)+reload-sync~t-ui --rows~+refresh-preview" ;;
      sign)   echo "execute(t-thread $id)+reload-sync~t-ui --rows~+refresh-preview" ;;
    esac
  }
  submit() {   # what the prompt's words were for, sent with enter or (new, stack) with details
    local how=$1
    case $mode in
      do)   [ "$how" = enter ] || exit 0
            if [ -z "$q" ]; then back; exit; fi
            act=$(awk -v q="$q" 'index($1, q) == 1 { print $1 }' <<< "$ACTIONS")
            case $(grep -c . <<< "$act") in
              0) echo "change-footer~${C_RED}no action '$q'$C_OFF~"; exit ;;
              1) ;;
              *) echo "change-footer~'$q' could be: $(xargs <<< "$act")~"; exit ;;
            esac
            id=$target
            if [ "$act" = rm ]; then act_on rm; exit; fi   # it goes back to the board itself
            board=$(back)                     # the board first: the action may take the prompt again
            did=$(act_on "$act")
            echo "$board${did:++$did}" ;;
      hold) [ "$how" = enter ] || exit 0
            t-hold "$target" "$q" 2> /dev/null
            back "$target" ;;
      name) [ "$how" = enter ] || exit 0
            if [ -n "$q" ]; then t-name "$target" "$q" > /dev/null 2>&1
            else setsid t-name "$target" < /dev/null > /dev/null 2>&1 & fi
            back "$target" ;;
      clean) [ "$how" = enter ] || exit 0
            t-clean 2>&1 > /dev/null | grep -v '^t: removed ' > "$T_UI/err" || true
            if [ -s "$T_UI/err" ]; then echo "refresh-preview+$(failed)"; else back ""; fi ;;
      say)  [ "$how" = enter ] || exit 0
            if [ -z "$q" ] && [ "$pick" = "$(first_step "$task")" ]; then exit 0; fi   # nothing said, and no step picked
            if [ "$(state "$task")" = running ]; then t-hold -f "$target" "said to" 2> /dev/null; fi   # resuming lifts it
            t-agent "$target" "$(cat "$T_UI/cli")" > /dev/null   # the agent picked here solves it from now on
            if [ -n "$q" ]; then t-say "$target" "$q" "$pick" > /dev/null 2> "$T_UI/err" || failed
            else t-resume "$target" "$pick" 2> "$T_UI/err" || failed; fi
            back "$target" ;;
      new | stack)
            words "$q"
            repo=$(cat "$T_UI/repo") cli=$(cat "$T_UI/cli")
            mapfile -t extra < "$T_UI/args"
            set -- -p "$pick" ${repo:+-r "$repo"} ${cli:+--cli "$cli"} "${extra[@]}" "${flags[@]}"
            if [ "$how" = enter ] && [ -n "$title" ]; then
              new=$(t-new "$@" "$title" 2> "$T_UI/err") || failed
              back "$(task_num "$new")"
            else                      # details in $EDITOR: the one thing here that needs the terminal
              printf '%q ' t-new --edit "$@" "$title" > "$T_UI/run"
              echo "execute(bash \"\$T_UI/run\")+$(back)"
            fi ;;
    esac
  }

  if [ "$mode" = board ]; then
    case $key in
      focus)  if [ -z "$id" ] || [ "$id" = later ]; then echo "change-footer~$(footer "$id")~"; exit; fi
              shown=$(pane "$(tdir "$id")" "$(cat "$T_UI/pane")")
              echo "change-preview-window($(follow_if_log "$shown"))+change-footer~$(footer "$id")~" ;;
      tab)    [ -n "$id" ] && [ "$id" != later ] || exit 0
              task=$(tdir "$id")
              show "$(pane_next "$task" "$(pane "$task" "$(cat "$T_UI/pane")")")" ;;
      esc)    echo abort ;;
      ctrl-u) echo preview-half-page-up ;;
      enter)  if [ -z "$id" ]; then new_form
              elif [ "$id" = later ]; then echo "execute(t-later)+reload-sync~t-ui --rows~+refresh-preview"   # its own screen
              else act_on "$(offers "$(tdir "$id")" | cut -d' ' -f1)"; fi ;;
      *)      name=$(named "$BOARD_KEYS" "$ACTIONS")
              if [ "$name" = new ]; then new_form
              elif [ "$name" = clean ]; then form clean - "delete these? " "" "nofollow,~2" "$(hint enter delete esc back)"
              elif [ -z "$id" ] || [ "$id" = later ]; then exit 0     # a task's keys mean nothing on a pile
              elif [ "$name" = keys ]; then form do "$id" "do to $id> " "" "nofollow,~2" "$(hint enter do "$(key keys) esc" back)"
              else act_on "$name"
              fi ;;
    esac
    exit
  fi

  task=
  if [[ ${target:-} == [0-9]* ]]; then task=$(tdir "$target"); fi
  case $key in                          # the board's own keys wait until you're back
    tab)    case $mode in
              say) choices=$(restart_steps "$task") ;;
              *)   exit 0 ;;            # new and stack pick the pipeline as a list, not a tab cycle
            esac
            next_choice "$pick" $choices > "$T_UI/pick"
            echo refresh-preview ;;
    esc)    if [ -n "$q" ]; then echo clear-query    # what you typed goes first, then the form
            elif [ "$(cat "$T_UI/list" 2> /dev/null)" = pipelines ] && [ -e "$T_UI/title" ]; then pipeline_done
            else echo tasks > "$T_UI/list"; back; fi ;;
    ctrl-u) echo unix-line-discard ;;   # in a prompt, ^u clears what you typed
    enter)  if [ "$(cat "$T_UI/list" 2> /dev/null)" = pipelines ]; then pipeline_done "$id"
            else printf '%s ' "$q" > "$T_UI/entered"; after_paste 't-ui --key entered - "$FZF_QUERY"'; fi ;;
    entered) if [ "$q" = "$(cat "$T_UI/entered" 2> /dev/null)" ]; then   # no paste went on after enter
               q=${q% } did=$(submit enter)
               echo "backward-delete-char${did:++$did}"
             fi ;;
    *)      case $(named "$FORM_KEYS" "$BOARD_KEYS" "$ACTIONS") in
              details) if [ "$(cat "$T_UI/list" 2> /dev/null)" != pipelines ]; then submit details; fi ;;
              agent)   [[ $mode == new || $mode == stack || $mode == say ]] || exit 0   # the pipeline's, or another
                       next_cli "$(cat "$T_UI/cli")" > "$T_UI/c" && mv "$T_UI/c" "$T_UI/cli"
                       echo "refresh-preview+change-footer~$(keys "$mode")~" ;;
              repo)    if [ "$mode" = new ]; then
                         echo "execute(t-complete repos | fzf --prompt 'repo> ' --height 40% --reverse --delimiter : --nth 1 | cut -d: -f1 > \"\$T_UI/r\" && mv \"\$T_UI/r\" \"\$T_UI/repo\")+refresh-preview"
                       fi ;;
              pipeline) case $mode in
                          new | stack) if [ "$(cat "$T_UI/list" 2> /dev/null)" = pipelines ]
                                       then pipeline_done
                                       else printf '%s' "$q" > "$T_UI/title"; pipeline_list "$mode"; fi ;;
                        esac ;;
              image)   [[ $mode == new || $mode == stack ]] || exit 0   # a flag typed with the title, for t new
                       image=$(t-paste 2> "$T_UI/err") || failed
                       echo "put~ --image $image~" ;;
              keys)    if [ "$mode" = do ]; then back; else echo "put($key)"; fi ;;   # typed in a title, it is the title's
            esac ;;
  esac
  exit
fi

if [ "${1:-}" = + ]; then
  [ "${2:-next}" = next ] || exit 0
  t-new || ask "(Enter: back to the board)" > /dev/null
  exit
fi
if [ $# -gt 0 ]; then
  trap : INT                            # Ctrl-C stops what you started (t log -f), not this
  task=$(task_dir "$1") || exit 1
  id=${task##*/} n=$(task_num "$task") act=${2:-} st=$(state "$task")
  if [ "$act" = next ]; then act=$(offers "$task" | cut -d' ' -f1); fi
  if [ -z "$act" ]; then
    echo; t-show "$id"; echo
    act=$(pick "task $n" <<< "$ACTIONS") || exit 0
    act=${act%% *}
  fi
  grep -q "^$act " <<< "$ACTIONS" || die "no action '$act'; there are: $(cut -d' ' -f1 <<< "$ACTIONS" | xargs) next"
  case $act in
    log)    if [[ $st == after* ]]; then id=$(cat "$task/after"); fi       # queued: what it waits for
            t-log "$id" -f; exit ;;
    say)    t-say "$id" "" ;;                # no notes yet: its screen asks for them
    stack)  t-stack "$id" ;;                 # no title yet: t compose
    hold)   if [ "$st" = HOLD ]; then t-resume "$id"; else t-hold "$id" "$(ask "why? (Enter: held by hand)")"; fi ;;
    cancel) t-hold -f "$id" cancelled ;;
    name)   t-name "$id" "$(ask "new name? (Enter: an agent picks one)")" ;;
    *)      "t-$act" "$id" ;;
  esac
  result=$?
  if [ "$result" = 0 ] && [ "$act" != run ] && [ "$act" != path ] && [ "$act" != agent ]; then exit; fi
  ask "(Enter: back to the board)" > /dev/null          # to read what it printed, or why it failed
  exit
fi

command -v fzf > /dev/null || die "the live board needs fzf (sudo apt install fzf); t ls prints the board"
export T_UI T_NEW                       # this board's state (see --key); t compose --dry reads a new task's there too
T_UI=$(mktemp -d)
T_NEW=$T_UI
trap 'rm -rf "$T_UI"' EXIT
echo board > "$T_UI/mode"
echo tasks > "$T_UI/list"
touch "$T_UI/pane" "$T_UI/pick" "$T_UI/def" "$T_UI/args" "$T_UI/repo" "$T_UI/cli"

binds=()                                # each key once, though it may mean one thing on the board and another in a form
while read -r key; do
  binds+=(--bind "$key:transform:t-ui --key '$key' {1} {q}")
done < <({ printf '%s\n' enter esc ctrl-u; printf '%s\n' "$ACTIONS" "$BOARD_KEYS" "$FORM_KEYS" | awk '$2 != "-" { print $2 }'; } | awk '!seen[$0]++')
pos=1 row=0                             # start on the newest running task
while read -r n _; do
  row=$((row + 1))
  if [ "$(state "$(tdir "$n")")" = running ]; then pos=$row; fi
done < <(board -a)

# the air around the list is borders in the background's color: fzf leaves --padding and --margin the terminal's
t-ui --rows | fzf "${BOARD_FZF[@]}" --sync --input-border sharp --list-border vertical --footer-border sharp \
  --prompt 'task> ' --info inline-right --footer ' ' \
  --preview 't-ui --pane {1} {q}' --preview-window 'right,45%,wrap,border-left,~2,<60(down,60%,border-top)' \
  --bind "start:pos($pos)+bg-transform:t-ui --key focus {1} {q}" --bind "focus:bg-transform:t-ui --key focus {1} {q}" \
  --bind 'load:transform:t-ui --onload {1} {q}' "${binds[@]}" \
  --bind 'ctrl-d:preview-half-page-down,shift-down:preview-down,shift-up:preview-up' \
  --bind 'page-down:preview-page-down,page-up:preview-page-up,ctrl-w:change-preview-window(90%|)' \
  --bind "tab:bg-transform:t-ui --key tab {1} {q}" || true
