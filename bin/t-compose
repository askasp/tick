#!/usr/bin/env bash
# t compose [--title TITLE] [t new's flags] — start a task on one screen: type the title, pick the pipeline, and see the task
# it will make (t new --dry) while you can still change it; the keys at the bottom add details in $EDITOR,
# pick the repo and the agent. Flags typed with the title work too: "Add proration -r amino".
# Plain `t new` in a terminal with fzf opens this; on the board, a new task does the same in place.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"

if [ "${1:-}" = --dry ]; then           # the preview: pipeline $2, what you typed in $3, and $T_NEW's args, repo and cli
  words "${3:-}"
  mapfile -t extra < "$T_NEW/args"
  repo=$(cat "$T_NEW/repo") cli=$(cat "$T_NEW/cli" 2> /dev/null)
  exec t-new --dry -p "$2" ${repo:+-r "$repo"} ${cli:+--cli "$cli"} "${extra[@]}" "${flags[@]}" "$title"
fi
if [ "${1:-}" = --paste ]; then         # the clipboard's image, as a flag typed with the title
  if image=$(t-paste 2>&1); then echo "put~ --image $image~"; else echo "change-footer~${image#t: }~"; fi
  exit
fi
if [ "${1:-}" = --enter ]; then         # enter, unless it is a newline in a paste (after_paste): $2 is what you typed
  printf '%s ' "$2" > "$T_NEW/entered"
  after_paste 't-compose --entered "$FZF_QUERY"'
  exit
fi
if [ "${1:-}" = --entered ]; then
  if [ "$2" = "$(cat "$T_NEW/entered")" ]; then echo backward-delete-char+accept; fi
  exit
fi
command -v fzf > /dev/null || die "t compose needs fzf (sudo apt install fzf); without it: t new \"what to do\""

repo= pick= on= from= typed= extra=()
while [ $# -gt 0 ]; do
  case $1 in
    --title) typed=$2; shift ;;          # typed for you, as a screen that makes a task of something (t roadmap) knows it
    -r) repo=$2; shift ;;
    -p) pick=$2; shift ;;
    --on) on=$2; extra+=("$1" "$2"); shift ;;
    --from) from=$2; extra+=("$1" "$2"); shift ;;
    --cli | --test | --base) extra+=("$1" "$2"); shift ;;
    *)  extra+=("$1") ;;
  esac
  shift
done
export T_NEW                            # the flags compose started with, and the repo (its key changes it)
T_NEW=$(mktemp -d)
trap 'rm -rf "$T_NEW"' EXIT
printf '%s' "$repo" > "$T_NEW/repo"
: > "$T_NEW/args"
: > "$T_NEW/cli"
if [ ${#extra[@]} -gt 0 ]; then printf '%s\n' "${extra[@]}" > "$T_NEW/args"; fi

def=$(default_pipeline "$repo") prompt="new> "
if [ -n "$on" ]; then                   # a stack: its parent's pipeline, unless you pick another
  parent=$(task_dir "$on") || exit 1
  def=$(cat "$parent/pipeline") prompt="stack on $(task_num "$parent")> "
elif [ -n "$from" ]; then               # a task made from an answer: its repo's pipeline
  asked=$(task_dir "$from") || exit 1
  def=$(default_pipeline "${repo:-$(cat "$asked/repo" 2> /dev/null)}") prompt="task from $(task_num "$asked")> "
fi
pick=${pick:-$def}

rows=$(for p in $(pipelines "$def"); do
  f=$(flow "$p") note=
  if [[ $f == *→* ]]; then f=$(sed 's/ ([^)]*)//g' <<< "$f"); fi     # who solves each step: the preview says
  if [ "$p" = "$def" ]; then note=default; fi
  if no_repo "$p"; then note="no repo"; fi
  printf '%-9s ' "$p"; pad 36 "$f"; printf ' %s%s%s\n' "$C_DIM" "$note" "$C_OFF"
done)
pos=$(grep -n "^$pick " <<< "$rows" | cut -d: -f1)

details=$(key_of details)
out=$(printf '%s\n' "$rows" | fzf "${BOARD_FZF[@]}" --disabled --sync --prompt "$prompt" --query "$typed" --info hidden \
  --footer "$(hint enter create "$(key details)" details "$(key repo)" repo "$(key agent)" agent "$(key image)" image esc cancel)" \
  --bind "$(key_of image):transform:t-compose --paste" \
  --print-query --expect "$details" --bind "start:pos(${pos:-1})" --bind 'enter:transform:t-compose --enter {q}' --preview 'CLICOLOR_FORCE=1 t-compose --dry {1} {q} 2>&1' \
  --preview-window 'right,50%,border-left,wrap,<50(down,50%,border-top)' \
  --bind "$(key_of agent)"':execute-silent[. "$T_ROOT/lib/tick.sh"; next_cli "$(cat "$T_NEW/cli")" > "$T_NEW/c" && mv "$T_NEW/c" "$T_NEW/cli"]+refresh-preview' \
  --bind "$(key_of repo)"':execute(t-complete repos | fzf --prompt "repo> " --height 40% --reverse --delimiter : --nth 1 | cut -d: -f1 > "$T_NEW/r" && mv "$T_NEW/r" "$T_NEW/repo")+refresh-preview') || exit 0

mapfile -t picked <<< "$out"            # what you typed, the key that ended it, the pipeline's row
query=${picked[0]} key=${picked[1]:-} row=${picked[2]:-}
repo=$(cat "$T_NEW/repo") cli=$(cat "$T_NEW/cli")
words "$query"
set -- -p "${row%% *}" ${repo:+-r "$repo"} ${cli:+--cli "$cli"} "${extra[@]}" "${flags[@]}"
if [ -z "$title" ] || [ "$key" = "$details" ]; then set -- --edit "$@"; fi   # no title yet: the editor asks for one
t-new "$@" "$title"
