#!/usr/bin/env bash
# t run [TASK] — run a task's steps one after another, in this terminal, until it has to wait
#
# This is the whole scheduler. The tick runs it for every task each minute.
# A step's exit code decides what happens next:
#   0    done: go to the next step, or to the one the step wrote into ./goto
#   75   not yet (CI running, no free agent slot): same step, next tick
#   *    failed: same step, next tick
# After MAX_RUNS runs of one step that didn't finish, the task holds; so it does when a step
# has sent it back with goto MAX_ROUNDS times without moving on to a later one.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -uo pipefail
task=$(task_dir "${1:-}") || exit 1
cd "$task" || exit 1
id=${task##*/} n=$(task_num "$task")

# One runner per task. A stacked task's lock is a symlink to its parent's, so this is
# also one runner per worktree. The kernel drops the lock when we die, even on kill -9
# or a reboot, so there is no pid file to go stale.
exec 9> lock
flock -n 9 || exit 0

# what the run's programs put in $TMPDIR goes with it; a run killed with -9 leaves it to the next one
export TMPDIR=$task/tmp
rm -rf "$TMPDIR" && mkdir "$TMPDIR"
trap 'rm -rf "$TMPDIR"' EXIT

unset T_UI T_NEW    # the board's, when t ui started us: plan's t new would write into it after it closed
set -a
load_env "$task"
set +a
export TASK_ID=$id
mkdir -p log runs
note() { echo "$(date '+%F %T') $*" | tee -a history >&2; }

while :; do
  step=$(cat step) pipeline=$(cat pipeline)
  if [ "$step" = done ] || [ -e hold ]; then exit 0; fi
  if [ -f after ]; then                           # stacked: wait for the task below
    parent=$(cat after)
    if [ ! -f "$T_TASKS/$parent/step" ]; then
      echo "task $parent, which this one is stacked on, is gone" > hold
      exit 0
    fi
    if [ "$(cat "$T_TASKS/$parent/step")" != done ]; then exit 0; fi
  fi

  run=$(( $(cat "runs/$step" 2> /dev/null || echo 0) + 1 ))
  moved=$(cat "runs/$step.moved" 2> /dev/null || echo 0)       # its runs when the task last moved past it
  if [ $((run - moved)) -gt "$MAX_RUNS" ]; then
    echo "${step#*-} ran $MAX_RUNS times without getting past it" > hold
    note "$n on hold: ${step#*-} ran $MAX_RUNS times"
    exit 0
  fi
  echo "$run" > "runs/$step"                    # counted before it runs, so a crash counts too

  rm -f goto
  echo "=== $(date '+%F %T') $step, run $run" >> "log/$step.log"
  T_STEP=${step#*-} "$T_ROOT/pipelines/$pipeline/$step" < /dev/null 2>&1 | tee -a "log/$step.log"
  code=${PIPESTATUS[0]}

  case $code in
    0)  next=$(next_step "$pipeline" "$step" "$task")
        if [ -f goto ]; then
          next=$(find_step "$pipeline" "$(cat goto)" "$task")
          if [ -z "$next" ]; then
            echo "$step asked to go to '$(cat goto)', which $pipeline doesn't have" > hold; exit 0
          fi
        fi
        echo "$next" > step.tmp && mv step.tmp step
        echo "$run" > "runs/$step.moved"
        note "$n $step ok → $next"
        if [[ $next > $step ]]; then
          rm -f "runs/$step.rounds"
        else
          rounds=$(( $(cat "runs/$step.rounds" 2> /dev/null || echo 0) + 1 ))
          echo "$rounds" > "runs/$step.rounds"
          if [ "$rounds" -ge "$MAX_ROUNDS" ]; then
            echo "${step#*-} sent it back $rounds times" > hold
            note "$n on hold: ${step#*-} sent it back $rounds times"
          fi
        fi ;;
    75) echo $((run - 1)) > "runs/$step"        # waiting isn't a run
        exit 0 ;;
    *)  note "$n $step failed (exit $code); it runs again on the next tick"
        exit 0 ;;
  esac
done
