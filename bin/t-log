#!/usr/bin/env bash
# t log ID [-f] — a task's history and its latest step's output (-f follows it live)
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
task=$(task_dir "${1:?usage: t log ID [-f]}") || exit 1
cd "$task" || exit 1

[ ! -f history ] || cat history
[ ! -f hold ] || echo "HOLD: $(cat hold)"
latest=$(ls -t log/*.log 2> /dev/null | head -1)
[ -n "$latest" ] || { echo "(no step has run yet)"; exit 0; }
echo "--- $task/$latest"
if [ "${2:-}" = -f ]; then exec tail -n 40 -f "$latest"; fi
tail -n 60 "$latest"
