#!/usr/bin/env bash
# t log [TASK] [-f] [--raw] — what a task's steps printed: every run in the order it ran, each
# banner saying which step it came from and its run number. -f keeps following it through the steps
# still to come. In a terminal it pages, from the end.
# The agent's markdown is rendered, long lines fold on words, and three or more calls of one tool in
# a row fold into one line; --raw is the file itself, every byte of it, and the session ids with it.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
. "$T_ROOT/lib/log.sh"
follow= raw= arg=
for word; do
  case $word in
    -f)    follow=1 ;;
    --raw) raw=1 ;;
    *)     arg=$word ;;
  esac
done
task=$(task_dir "$arg") || exit 1
cd "$task" || exit 1
terminal_colors
cols=$(width)                         # taken here: in the pipeline below, stdout is the pager's pipe

files=()                              # a step that hasn't run has no log yet; tail -F waits for it
for s in $(steps "$(cat pipeline)" "$PWD"); do files+=("log/$s.log"); done
files+=(history)

{
  { story
    if [ -f hold ]; then echo "HOLD: $(head -1 hold)"; fi
    ls log/*.log > /dev/null 2>&1 || echo "(no step has run yet)"
  } | if [ -n "$raw" ]; then cat; else digest; fi
  # digest holds a run of calls back to see how long it gets, so what tail -F follows goes round it
  if [ -n "$follow" ]; then tail -q -n 0 -F "${files[@]}" 2> /dev/null; fi
} | if [ -n "$raw" ]; then cat; else render; fi |
  if [ -t 1 ] && [ -z "$follow" ]; then LESS=${LESS-FRX} less +G; else cat; fi
