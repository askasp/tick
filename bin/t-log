#!/usr/bin/env bash
# t log [TASK] [-f] [--raw] — what a task's steps printed: every run in the order it ran, each followed by how
# it ended. -f keeps following it through the steps still to come. In a terminal it pages, from the end.
# Three or more calls of one tool in a row fold into one line; --raw shows them all, and the session ids.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
follow= raw= arg=
for word; do
  case $word in
    -f)    follow=1 ;;
    --raw) raw=1 ;;
    *)     arg=$word ;;
  esac
done
task=$(task_dir "$arg") || exit 1
cd "$task" || exit 1
terminal_colors

files=()                              # a step that hasn't run has no log yet; tail -F waits for it
for s in $(steps "$(cat pipeline)"); do files+=("log/$s.log"); done
files+=(history)

# Each step logs its runs ("=== DATE TIME step, run N") apart, and times are to the second, so
# history, which says in order how each run ended, decides whose run comes next. A run that had
# to wait (exit 75) keeps its number, so it goes out together with the run after it.
story() {
  local f have=()
  for f in "${files[@]}"; do
    if [ -f "$f" ]; then have+=("$f"); fi
  done
  if [ ${#have[@]} -eq 0 ]; then return 0; fi
  awk 'function pending(s) { return p[s] < n[s] }
       function start(s)   { return at[s, p[s] + 1] }
       function emit(s)    { p[s]++; printf "%s", run[s, p[s]] }
       function before(when, or_at,  s, b) {    # every run started before `when`, oldest first
         for (;;) {
           b = ""
           for (s in n) if (pending(s) && (start(s) < when || (or_at && start(s) == when)) && (b == "" || start(s) < start(b))) b = s
           if (b == "") return
           emit(b)
         }
       }
       FILENAME != "history" {
         if (FNR == 1) { s = FILENAME; n[s] = 0 }
         if (/^=== [0-9-]+ [0-9:]+ /) { n[s]++; at[s, n[s]] = $2 " " $3; num[s, n[s]] = $NF }
         else if (!n[s]) { n[s] = 1; at[s, 1] = "" }
         run[s, n[s]] = run[s, n[s]] $0 "\n"
         next
       }
       { s = "log/" $4 ".log"
         if ((s in n) && pending(s)) {
           before(start(s)); emit(s)
           while (pending(s) && num[s, p[s] + 1] == num[s, p[s]] && start(s) <= $1 " " $2) emit(s)
         } else before($1 " " $2, 1)
         print }
       END { before("~", 1) }' "${have[@]}"
}

# three or more calls of one tool in a row become one line: "· Read ×8  src/lib/health-*, src/app.ts".
# While the task runs, its last three calls stay lines of their own, so the log still moves.
digest() {
  local live=
  if [ "$(state "$task")" = running ]; then live=1; fi
  awk -v live="$live" '
    function common(a, b) {
      while (a != "" && index(b, a) != 1) a = substr(a, 1, length(a) - 1)
      return a
    }
    # the calls folded: paths by directory, with what their names start with; commands by their first word
    function summary(k,   i, a, j, g, ng, out, seen, order, first, pre, many) {
      for (i = 1; i <= k; i++) {
        a = arg[i]
        sub(/ .*/, "", a)
        j = arg[i] ~ / / ? 1 : match(a, /[^\/]*$/)
        g = j > 1 ? substr(a, 1, j - 1) : a
        if (!(g in seen)) { seen[g] = 1; order[++ng] = g; first[g] = a; pre[g] = substr(a, j) }
        else if (a != first[g]) { many[g] = 1; pre[g] = common(pre[g], substr(a, j)) }
      }
      for (i = 1; i <= ng && i <= 6; i++) {
        g = order[i]
        out = out (i > 1 ? ", " : "") (many[g] ? g pre[g] "*" : first[g])
      }
      return out (ng > 6 ? ", …" : "")
    }
    function flush(keep,   i, k) {
      k = n - keep >= 3 ? n - keep : 0
      if (k) print "  · " tool " ×" k "  " summary(k)
      for (i = k + 1; i <= n; i++) print line[i]
      n = 0
    }
    /^  · / {
      if ($2 != tool) flush(0)
      tool = $2
      line[++n] = $0
      arg[n] = substr($0, index($0, $2) + length($2) + 1)
      next
    }
    { flush(0); print }
    END { flush(live ? 3 : 0) }'
}

# a run stands out, an agent's words get a bar, and its session line (t attach's) goes. In color, greys:
# dim for what tick says about a run, text for what the run printed, bright for the agent's words and
# its edits; and red for a run that failed or held. The hold space remembers whether this run is an
# agent's (it logged a session): its plain lines are its words.
paint() {
  local bold= hide_session='/^session: /d' when='[0-9]{4}-[0-9-]+ [0-9:]+ '
  if [ -n "$C_OFF" ] && [ -z "${NO_COLOR:-}" ]; then bold=$'\e[1m'; else C_BRIGHT= C_TEXT= C_DIM= C_RED= C_OFF=; fi
  if [ -n "$raw" ]; then hide_session=; fi
  sed -u -E \
    -e 's/\x1b\[[0-9;]*m//g' \
    -e '/^=== /{x;s/.*//;x}' \
    -e "/^$when/{x;s/.*//;x}" \
    -e '/^session: /{x;s/.*/agent/;x}' \
    -e "$hide_session" \
    -e "s/^=== .*/\n$bold&$C_OFF/;t" \
    -e "s/^session: .*/$C_DIM&$C_OFF/;t" \
    -e "s/^($when.*(failed|hold|cancelled).*)/$C_RED\1$C_OFF/;t" \
    -e "s/^$when.*/$C_DIM&$C_OFF/;t" \
    -e "s/^HOLD: .*/$C_RED&$C_OFF/;t" \
    -e "s/^  · (edit|write|patch|Edit|Write|MultiEdit|NotebookEdit)( (.*))?\$/$C_DIM·$C_OFF $C_BRIGHT\1  \3$C_OFF/;t" \
    -e "s/^  · ([^ ]*) ?(.*)/$C_DIM·$C_OFF $C_TEXT\1  \2$C_OFF/;t" \
    -e "s/^ *! (.*)/$C_BRIGHT!$C_OFF $C_TEXT\1$C_OFF/;t" \
    -e '/^$/b' \
    -e x -e "/^agent\$/{x;s/.*/$C_DIM▌$C_OFF $C_BRIGHT&$C_OFF/;b" -e '}' -e x \
    -e "s/.+/$C_TEXT&$C_OFF/"
}

{
  { story
    if [ -f hold ]; then echo "HOLD: $(head -1 hold)"; fi
    ls log/*.log > /dev/null 2>&1 || echo "(no step has run yet)"
  } | if [ -n "$raw" ]; then cat; else digest; fi
  # mawk reads ahead, so a line tail -F follows would wait in digest until the next ones came
  if [ -n "$follow" ]; then tail -q -n 0 -F "${files[@]}" 2> /dev/null; fi
} | if [ -t 1 ] && [ -z "$follow" ]; then paint | LESS=${LESS-FRX} less +G; else paint; fi
