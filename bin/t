#!/usr/bin/env bash
# t — the task board. `t CMD ARGS` runs bin/t-CMD. Plain `t`: the interactive board in a terminal, `t ls` elsewhere.
here=$(dirname "$(readlink -f "$0")")
if [ $# -eq 0 ]; then
  if [ -t 0 ] && [ -t 1 ]; then exec "$here/t-ui"; fi
  exec "$here/t-ls"
fi
cmd=$1
shift
[ ! -x "$here/t-$cmd" ] || exec "$here/t-$cmd" "$@"

[ "$cmd" = help ] || echo "t: no command '$cmd'" >&2
echo "usage (TASK is an id, a word from its title, or left out to choose from a list):" >&2
for f in "$here"/t-*; do sed -n '2s/^# /  /p' "$f" >&2; done
[ "$cmd" = help ]
