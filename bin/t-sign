#!/usr/bin/env bash
# t sign [TASK] — sign a reply or a comment, and it leaves on the next tick; in a terminal, $EDITOR shows it first, with its thread
#
# With none written yet, you type it under the thread instead, ctrl-d ending it. What you save or type is what leaves,
# and an empty one signs nothing. A reply goes where its pipeline's DELIVER= says:
# draft saves it as a private draft where the conversation is, to send from there; send sends it as you. A comment
# (KIND=comment) is posted on the conversation, for your teammates only.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
task=$(task_dir "${1:-}")
n=$(task_num "$task") step=$(cat "$task/step")
[ "${step#*-}" = sign ] || die "task $n waits for no signature; it is at ${step#*-} (t show $n)"
flock -n "$task/lock" true || die "task $n is running; sign it when it stops: t log $n -f"
read -r kind deliver < <(load_env "$task" > /dev/null 2>&1; echo "${KIND:-reply} ${DELIVER:-draft}")
source=$(sed -n '/^conversation: /{s/^conversation: \([^ ]*\).*/\1/p;q}' "$task/task.md")
case $kind/$deliver in
  comment/*) goes="is posted for your teammates" ask="post it for your teammates, now?" about=": internal, only your teammates see it" ;;
  */send)    goes="is sent as you" ask="send it as you, now?" about= ;;
  *)         goes="is saved as a draft in $source" ask= about= ;;
esac

without_trailing_blanks() { tac | sed '/[^[:space:]]/,$!d' | tac; }

if [ -t 0 ] && [ -t 1 ]; then
  if [ -s "$task/answer.md" ]; then
    f=$(mktemp --suffix=.md)
    {
      cat "$task/answer.md"
      printf '\n# tick: your %s goes above%s. Lines like these are dropped, and an empty %s signs nothing.\n' "$kind" "$about" "$kind"
      sed 's/^/# tick: /' "$task/thread.md"
    } > "$f"
    "${EDITOR:-vi}" "$f"
    text=$(grep -v '^# tick:' "$f" | without_trailing_blanks || true)
    rm -f "$f"
  else                                  # nothing written yet: the thread, and what you type under it
    clear 2> /dev/null || true
    echo "$C_BRIGHT$(sed -n '1s/^# //p' "$task/thread.md")$C_OFF"
    FZF_PREVIEW_COLUMNS=$(stty size 2> /dev/null | cut -d' ' -f2) thread_view "$task/thread.md"
    printf '\n%sYour %s, under it%s. Ctrl-d on a line of its own ends it; an empty %s signs nothing.%s\n' "$C_DIM" "$kind" "$about" "$kind" "$C_OFF"
    text=$(without_trailing_blanks || true)
  fi
  grep -q '[^[:space:]]' <<< "$text" || die "an empty $kind signs nothing; task $n still waits for you: t sign $n"
  printf '%s\n' "$text" > "$task/answer.tmp" && mv "$task/answer.tmp" "$task/answer.md"
fi
grep -qs '[^[:space:]]' "$task/answer.md" || die "task $n has no $kind to sign; write it in a terminal: t sign $n"

if [ -n "$ask" ] && [ -t 0 ]; then
  read -rp "$ask [y/N] " yes
  [ "$yes" = y ] || die "nothing signed; task $n still waits for you: t sign $n"
fi
touch "$task/signed"
"$T_ROOT/bin/t-resume" "$n" 2> /dev/null
echo "t: task $n is signed, and $goes on the next tick (or now: t run $n)" >&2
