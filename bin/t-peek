#!/usr/bin/env bash
# t peek [TASK] [show|steps|log|raw|diff] — what t ui's pane shows: a running task's live log, else its details.
# steps: how each step went, the file it runs, and every setting the steps see, with the env file it came from.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
task=$(task_dir "${1:-}") || exit 1
id=${task##*/} n=$(task_num "$task") st=$(state "$task") step=$(cat "$task/step")
if [ -t 1 ]; then export CLICOLOR_FORCE=1; fi
terminal_colors
mode=$(pane "$task" "${2:-}")
case $mode in log | raw) tab_color=$C_YELLOW ;; diff) tab_color=$C_GREEN ;; *) tab_color=$C_BLUE ;; esac
if [ "$mode" = raw ]; then tabs=(show steps raw); else tabs=(show steps log); fi
if [ "$(pane_next "$task" log)" = diff ]; then tabs+=(diff); fi

case $st in                             # two lines the pane keeps at its top: what this is, and a rule
  done)   about="$(cat "$task/pipeline") · $(status "$task")" ;;
  after*) about="queued behind ${st#after }" ;;
  *)      who=$(solver "$(cat "$task/pipeline")" "${step#*-}" "$task")
          case $st in
            running) since="running $(age "$task")" ;;
            HOLD)    since="held $(age "$task")" ;;
            *)       since="next tick" ;;
          esac
          about="${step#*-}${who:+ ($who)} · $since" ;;
esac
case $mode in
  log) about+="   $C_PURPLE^l$C_DIM raw" ;;
  raw) about+="   $C_PURPLE^l$C_DIM folded" ;;
esac
echo "$(strip "$tab_color" "$mode" "${tabs[@]}") ${C_DIM}task $n · $about   $C_PURPLE↹$C_DIM next$C_OFF"
rule "$C_DIM"

# how often step $1 ran, and how its last run ended: 2 ok → review
runs_of() {
  cat "$task/history" 2> /dev/null | awk -v step="$1" '
    $4 == step && ($5 == "ok" || $5 == "failed") {
      runs++
      sub(/^[^ ]+ [^ ]+ [^ ]+ [^ ]+ /, ""); sub(/;.*/, ""); sub(/→ [0-9]+-/, "→ ")
      last = $0
    }
    END { print runs + 0, last }'
}

# the comment lines a script starts with, after its #!
header() {
  local line
  while IFS= read -r line; do
    [[ $line == '#'* ]] || break
    line=${line#\#}
    echo "${line# }"
  done < <(tail -n +2 "$1")
}

# ✓ 20-test  2 runs  ok → review  → steps/test · 3 pipelines: the file is theirs too, so editing it changes them all
step_rows() {
  local pipeline each mark=✓ now now_color runs end end_color file shared width links
  pipeline=$(cat "$task/pipeline") width=$(steps "$pipeline" | wc -L)
  links=$(for file in "$T_ROOT"/pipelines/*/[0-9]*; do readlink -f "$file"; done)
  for each in $(steps "$pipeline"); do
    if [ "$each" = "$step" ]; then now=▶ mark=·; else now=$mark; fi
    case $now in ✓) now_color=$C_GREEN ;; ▶) now_color=$C_YELLOW ;; *) now_color=$C_DIM ;; esac
    read -r runs end < <(runs_of "$each")
    case $end in ok*) end_color=$C_GREEN ;; *) end_color=$C_RED ;; esac
    if [ "$each" = "$step" ] && [ "$st" = running ]; then end=running end_color=$C_YELLOW
    elif [ "$each" = "$step" ] && [ "$st" = HOLD ]; then end=held end_color=$C_RED
    fi
    case $runs in 0) runs=— ;; 1) runs="1 run" ;; *) runs="$runs runs" ;; esac
    file=$(readlink -f "$T_ROOT/pipelines/$pipeline/$each")
    shared=$(grep -cxF "$file" <<< "$links")
    if [ "$shared" -gt 1 ]; then shared=" · $shared pipelines"; else shared=; fi
    echo "$now_color$now$C_OFF $(pad "$width" "$each")  $(pad 7 "$runs")  $end_color$(pad 15 "$end")$C_OFF  $C_DIM→ ${file#"$T_ROOT"/}$shared$C_OFF"
  done
  if [ "$step" != done ]; then
    echo
    header "$T_ROOT/pipelines/$pipeline/$step"
  fi
}

# every setting the steps see, and the env file it comes from: TEST_CMD  make test  task
settings() {
  local files keys width key file from
  mapfile -t files < <(env_files "$task")
  keys=$(for file in "${files[@]}"; do
    if [ -f "$file" ]; then grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "$file"; fi
  done | tr -d = | awk '!seen[$0]++')
  echo "${C_DIM}settings   pipeline → repo → task$C_OFF"
  if [ -z "$keys" ]; then echo "  ${C_DIM}none$C_OFF"; return; fi
  width=$(wc -L <<< "$keys")
  (
    load_env "$task" > /dev/null 2>&1
    for key in $keys; do
      for file in "${files[@]}"; do
        if grep -q "^$key=" "$file" 2> /dev/null; then from=$file; fi
      done
      from=${from%/env}
      if [ "$from" = "$task" ]; then from=task; fi
      echo "  $(pad "$width" "$key")  ${!key:-}  $C_DIM${from#"$T_ROOT"/}$C_OFF"
    done
  )
}

case $mode in
  log | raw)
    raw=
    if [ "$mode" = raw ]; then raw=--raw; fi
    if [ "$st" = running ]; then          # a short log sits at the bottom, where its next line comes
      blank_lines=$(( ${FZF_PREVIEW_LINES:-0} - 2 - $(t-log "$id" $raw | wc -l) ))
      if [ "$blank_lines" -gt 0 ]; then printf '\n%.0s' $(seq "$blank_lines"); fi
    fi
    exec t-log "$id" -f $raw ;;
  steps) step_rows; echo; settings ;;
  diff)  t-diff "$id" --color=always 2>&1 | if command -v delta > /dev/null; then delta --paging=never; else cat; fi ;;
  *)     t-show "$id" | sed '/^  next:$/,/^$/d' ;;               # the board's header has the keys
esac
