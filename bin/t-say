#!/usr/bin/env bash
# t say [TASK] "what to change" — send a task back to implement with your notes (done tasks too)
#
# The notes go into feedback.md, the same file the review, the tests and CI write.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
if [ $# -eq 1 ]; then msg=$1 task=$(task_dir ""); else task=$(task_dir "${1:-}") msg=${2:-}; fi
n=$((10#${task##*/}))
if [ -z "$msg" ]; then
  [ -t 0 ] || die 'usage: t say [TASK] "what to change"'
  read -rp "what should change? " msg
  [ -n "$msg" ] || exit 0
fi
flock -n "$task/lock" true || die "task $n is running; say it when it stops, or: t hold $n"

printf '%s\n' "$msg" >> "$task/feedback.md"
exec "$T_ROOT/bin/t-resume" "$n" implement
