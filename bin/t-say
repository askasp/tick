#!/usr/bin/env bash
# t say [TASK] "notes" [STEP] — back to its first step (or STEP) with your notes: a fix for code, a follow-up for a question
#
# The notes go into feedback.md, the same file the review, the tests and CI write. Without notes, in a
# terminal with fzf, a screen to write them on: it says what will happen, shows the task's latest log,
# and lets you pick the step it restarts at.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
at=
if [ $# -eq 1 ]; then msg=$1 task=$(task_dir ""); else task=$(task_dir "${1:-}") msg=${2:-} at=${3:-}; fi
n=$(task_num "$task") first=$(steps "$(cat "$task/pipeline")" | head -1)
flock -n "$task/lock" true || die "task $n is running; say it when it stops, or: t hold $n"

if [ -z "$msg" ] && [ -t 0 ] && command -v fzf > /dev/null && [ "${T_PICKER:-fzf}" = fzf ]; then
  rows=$(steps "$(cat "$task/pipeline")" | while read -r s; do
    note="restarts here"
    if [ "$s" = "$first" ]; then note="starts over"; fi
    printf '%-10s %s%s%s\n' "${s#*-}" "$C_DIM" "$note" "$C_OFF"
  done)
  preview='. "$T_ROOT/lib/tick.sh"; t=$(tdir '"$n"') s={1}
    echo "${C_DIM}task '"$n"'$C_OFF  $(name "$t")  $C_DIM$(cat "$t/branch" 2> /dev/null)$C_OFF"; status "$t"
    echo "${C_DIM}goes to feedback.md; the task restarts at$C_OFF $s ${C_DIM}on the next tick$C_OFF"; echo
    CLICOLOR_FORCE=1 t-log '"$n"' | tail -n 60'
  out=$(printf '%s\n' "$rows" | fzf "${BOARD_FZF[@]}" --disabled --prompt "say to $n> " --info hidden --print-query \
    --footer "$(hint enter say ↑↓ "the step it restarts at" esc cancel)" \
    --preview "$preview" --preview-window 'right,60%,border-left,wrap,follow,~4,<50(down,60%,border-top)') || exit 0
  mapfile -t typed <<< "$out"
  msg=${typed[0]} at=${typed[1]:-}
  at=${at%% *}
elif [ -z "$msg" ]; then
  [ -t 0 ] || die 'usage: t say [TASK] "what to change"'
  echo "task $n  $(name "$task")"
  status "$task"
  echo "goes to feedback.md; the task starts over at $first"
  read -rp "say> " msg
fi
[ -n "$msg" ] || exit 0

printf '%s\n' "$msg" >> "$task/feedback.md"
exec "$T_ROOT/bin/t-resume" "$n" "${at:-$first}"
