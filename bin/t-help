#!/usr/bin/env bash
# t help — how to start a task, the repos and pipelines, and every command
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"

cat << 'EOF'
tick: AI coding tasks on a board of files; cron moves them along.

Start a task, from any directory (TAB completes -r, -p, --on and tasks):
  t new -r amino "Add a discount code field"   in amino, with amino's own pipeline
  t new "..."                                  in the repo you're standing in
  t new                                        the same, writing the title and details in $EDITOR
  t periode-feature "..."                      a pipeline that names its repo: mono, from any directory
  t amino +plan "..."                          with an optional step: plan it into one PR or a stack
  t new --on 3 "..."                           stack it on task 3: branches from 3, starts when 3 is done
  t new --cli claude "..."                     solve every step with claude instead
  t new --image "$(t paste)" "..."             with the image on the clipboard, for the agent to see
  t ask --now -r amino "How does X work?"      a question about a repo, answered right here
  t research --now "..."                       a question for the web
  t new --from 7 "..."                         make question 7 into a task: its answer is the details

Follow it:
  t                  the board: pick a task, then what to do with it
  t show 3           where it is, and what to do next

EOF
echo "Repos (-r NAME; any directory in $T_REPOS, or a path, works too):"
for d in "$T_ROOT"/repos/*/; do
  [ -f "$d/env" ] || continue
  name=$(basename "$d")
  p=$(profile_get "$name" PIPELINE)
  printf '  %-9s %s  (pipeline %s)\n' "$name" "$(profile_get "$name" REPO)" "${p:-$T_PIPELINE}"
done
echo
echo "Pipelines (t NAME \"...\", or t new -p NAME; * is the default):"
for d in "$T_ROOT"/pipelines/*/; do
  name=$(basename "$d") mark=' '
  if [ "$name" = "$T_PIPELINE" ]; then mark='*'; fi
  printf '  %s %-9s %s\n' "$mark" "$name" "$(flow "$name")"
done
echo
echo "Commands (t CMD --help for more; TASK is a number, a word from its title, or left out to pick):"
for f in "$T_ROOT"/bin/t-*; do sed -n '2s/^# /  /p' "$f"; done
