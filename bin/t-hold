#!/usr/bin/env bash
# t hold [TASK] [reason] — pause a task; the tick leaves it alone until `t resume`
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
task=$(task_dir "${1:-}") || exit 1
reason=${2:-}
echo "${reason:-held by hand}" > "$task/hold"
flock -n "$task/lock" true || echo "t: the step that is running now finishes first" >&2
