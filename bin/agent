#!/usr/bin/env bash
# agent NAME — run agents/NAME.md as a filter: prompt on stdin, answer on stdout, progress on stderr
#
#   git diff | agent reviewer > review.md
#
# The file says what the agent may do (mode: read, web or edit); a pipeline can change that
# for one of its steps with MODE_<step>=. Which CLI and model run it is the pipeline's choice,
# per step: CLI_review=opencode, MODEL_review=... in its env.
# AGENT_CLI and AGENT_MODEL override that (t new --cli sets AGENT_CLI for one task).
# claude thinks at EFFORT_<step>=, else $T_EFFORT.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
file=$T_ROOT/agents/${1:?usage: agent NAME < prompt}.md
[ -f "$file" ] || die "no agent '$1'; there are: $(ls "$T_ROOT/agents" | sed 's/\.md$//' | xargs)"

if [ "$(head -1 "$file")" = --- ]; then
  frontmatter=$(sed '1d; /^---$/,$d' "$file")
  prompt=$(sed '1,/^---$/d' "$file")
else
  frontmatter= prompt=$(cat "$file")
fi
mode=$(sed -n 's/^mode: *//p' <<< "$frontmatter")

step=${T_STEP:-}
step=${step//[^a-zA-Z0-9_]/_}
cli_var=CLI_$step model_var=MODEL_$step mode_var=MODE_$step effort_var=EFFORT_$step
mode=${!mode_var:-$mode}
planned=${!cli_var:-$T_CLI}
cli=${AGENT_CLI:-$planned}
model=${AGENT_MODEL:-}
# a model named for the step belongs to the step's own CLI: claude's "opus" means nothing to opencode
if [ -z "$model" ] && [ "$cli" = "$planned" ]; then model=${!model_var:-}; fi
[ -x "$T_ROOT/drivers/$cli" ] || die "no driver '$cli'; there are: $(ls "$T_ROOT/drivers" | xargs)"
export AGENT_MODE=$mode AGENT_MODEL=$model AGENT_EFFORT=${AGENT_EFFORT:-${!effort_var:-$T_EFFORT}}

# At most SLOTS_<cli> of these at once. A slot is a lock file; the kernel frees it
# when its holder dies. None free → 75, and the step runs again next tick.
slots_var=SLOTS_$cli
slots=${!slots_var:-2}
mkdir -p "$T_VAR/run"
for i in $(seq "$slots"); do
  exec 8> "$T_VAR/run/$cli.$i"
  if flock -n 8; then break; fi
  if [ "$i" -eq "$slots" ]; then echo "agent: all $slots $cli slots busy; trying again later" >&2; exit 75; fi
done

{ echo "$prompt"; echo; cat; } | "$T_ROOT/drivers/$cli"
