#!/usr/bin/env bash
# agent NAME — run agents/NAME.md as a filter: prompt on stdin, answer on stdout, progress on stderr
#
#   git diff | agent reviewer > review.md
#
# The file says what the agent may do (mode: read, web or edit); a pipeline can change that
# for one of its steps with MODE_<step>=. Which CLI and model run it is the pipeline's choice,
# per step: CLI_review=opencode, MODEL_review=... in its env.
# AGENT_CLI and AGENT_MODEL override that (t new --cli sets AGENT_CLI for one task).
# When the CLI fails — a local model out of context, a server that went away — claude gets the
# same prompt once, so the task keeps going.
# claude thinks at EFFORT_<step>=, else $T_EFFORT.
# A repo's GENERATED= (in repos/NAME/env) is named in every prompt: those files are tooling's.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
file=$T_ROOT/agents/${1:?usage: agent NAME < prompt}.md
[ -f "$file" ] || die "no agent '$1'; there are: $(ls "$T_ROOT/agents" | sed 's/\.md$//' | xargs)"

if [ "$(head -1 "$file")" = --- ]; then
  frontmatter=$(sed '1d; /^---$/,$d' "$file")
  prompt=$(sed '1,/^---$/d' "$file")
else
  frontmatter= prompt=$(cat "$file")
fi
mode=$(sed -n 's/^mode: *//p' <<< "$frontmatter")

step=${T_STEP:-}
step=${step//[^a-zA-Z0-9_]/_}
cli_var=CLI_$step model_var=MODEL_$step mode_var=MODE_$step effort_var=EFFORT_$step
mode=${!mode_var:-$mode}
planned=${!cli_var:-$T_CLI}
cli=${AGENT_CLI:-$planned}
model=${AGENT_MODEL:-}
# a model named for the step belongs to the step's own CLI: claude's "opus" means nothing to opencode
if [ -z "$model" ] && [ "$cli" = "$planned" ]; then model=${!model_var:-}; fi
[ -x "$T_ROOT/drivers/$cli" ] || die "no driver '$cli'; there are: $(ls "$T_ROOT/drivers" | xargs)"
export AGENT_MODE=$mode AGENT_MODEL=$model AGENT_EFFORT=${AGENT_EFFORT:-${!effort_var:-$T_EFFORT}}

# At most SLOTS_<cli> of these at once. A slot is a lock file; the kernel frees it
# when its holder dies. None free → 75, and the step runs again next tick.
take_slot() {
  local slots_var=SLOTS_$1 slots i
  slots=${!slots_var:-2}
  mkdir -p "$T_VAR/run"
  for i in $(seq "$slots"); do
    exec 8> "$T_VAR/run/$1.$i"      # the slot we held, if any, is dropped here
    if flock -n 8; then return; fi
  done
  echo "agent: all $slots $1 slots busy; trying again later" >&2
  exit 75
}

take_slot "$cli"
turn=$(mktemp) answer=$(mktemp) board=$(mktemp -d)
trap 'rm -rf "$turn" "$answer" "$board"' EXIT
# An agent that runs t itself (a test it set up by hand, without its T_VAR) gets an empty board
# of its own: through ours, its `t new` became a task that the tick then ran.
driver() { T_VAR=$board "$T_ROOT/drivers/$1"; }
{
  echo "$prompt"
  # what tooling writes in this repo (GENERATED= in its env): never worth an agent's context
  if [ -n "${GENERATED:-}" ]; then
    echo; echo "Generated in this repo, and left out of any diff below: $GENERATED"
    echo "Never read, edit or review those; change what generates them instead."
  fi
  echo; cat
} > "$turn"
# the answer is held back until the turn worked: half an answer is not one
if driver "$cli" < "$turn" > "$answer"; then cat "$answer"; exit 0; fi

# A model that can't answer must not stop the task: claude gets the same prompt once.
# Its model is the step's own CLI's (vllm/laguna-s-2.1 means nothing to claude), so drop it.
[ "$cli" != claude ] || exit 1
echo "agent: $cli failed; the same prompt goes to claude" >&2
take_slot claude
AGENT_MODEL=
driver claude < "$turn"
