#!/usr/bin/env bash
# t name [TASK] ["name"] — what the board calls a task; left out, an agent reads the task and picks a short name
#
# t new does this itself for a title longer than 40 characters. task.md keeps the whole title.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
task=$(task_dir "${1:-}")
n=$(task_num "$task") name=${2:-}
if [ -z "$name" ]; then
  answer=$(cd "$task" && agent namer < task.md 2> /dev/null) || answer=
  name=$(grep -m1 '[^[:space:]]' <<< "$answer" | tr -d '`*#"' | sed 's/^ *//; s/ *$//' || true)
  name=${name:0:50}
fi
[ -n "$name" ] || die "no name came back for task $n; give it one yourself: t name $n \"...\""
echo "$name" > "$task/name.tmp" && mv "$task/name.tmp" "$task/name"
