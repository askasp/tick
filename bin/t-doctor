#!/usr/bin/env bash
# t doctor — check everything tick needs, list the repos and pipelines, and say how to fix what's missing
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
bad=0
ok()   { echo "  ✓ $1"; }
fix()  { echo "  ✗ $1"; echo "      fix: $2"; bad=1; }
need() { if command -v "$1" > /dev/null; then ok "$1"; else fix "$1 not found" "$2"; fi; }

# fzf exits 1 when nothing matches, and 2 on a flag it doesn't know: the live board's flags, here
fzf_is_new_enough() {
  fzf --with-shell 'bash -c' --gutter ' ' --info-command true --bind 'tab:bg-transform-header:true' --filter x < /dev/null > /dev/null 2>&1
  [ $? -le 1 ]
}

echo "tools"
need git      "sudo apt install git"
need jq       "sudo apt install jq"
need flock    "sudo apt install util-linux"
need fuser    "sudo apt install psmisc   (only t rm -f needs it)"
need claude   "curl -fsSL https://claude.ai/install.sh | bash"
need opencode "curl -fsSL https://opencode.ai/install | bash"
need gh       "sudo apt install gh   (only pipelines with a pr step need it)"
if command -v gh > /dev/null; then
  if gh auth status > /dev/null 2>&1; then ok "gh is logged in"; else fix "gh is not logged in" "gh auth login"; fi
fi
if ! command -v fzf > /dev/null; then echo "  · no fzf: plain t prints the board, and pickers are numbered menus (sudo apt install fzf)"
elif fzf_is_new_enough; then ok "fzf (the live board)"
else echo "  · fzf $(fzf --version | cut -d' ' -f1) is too old for the live board: get a newer one from github.com/junegunn/fzf/releases"; fi

echo "wiring"
if [ "$(PATH=$T_PATH_BEFORE command -v t | xargs -r readlink -f)" = "$T_ROOT/bin/t" ]; then ok "t is on your PATH"
else echo "  · t isn't on PATH, which is fine with an alias: alias t=$T_ROOT/bin/t"; fi
if crontab -l 2> /dev/null | grep -q 'bin/t tick'; then ok "cron ticks every minute"
else fix "no cron line, so tasks only move when you run them" "(crontab -l; echo '* * * * * $T_ROOT/bin/t tick') | crontab -"; fi
if grep -qs 'completions/t.zsh' ~/.zshrc; then ok "tab completion in zsh"
else echo "  · no tab completion: add to ~/.zshrc: source $T_ROOT/completions/t.zsh"; fi
if mkdir -p "$T_TASKS" 2> /dev/null && [ -w "$T_TASKS" ]; then ok "state in $T_VAR"; else fix "can't write $T_TASKS" "set T_VAR in $T_ROOT/etc/tick.conf"; fi

echo "repos   (t new -r NAME; a directory in $T_REPOS works too)"
found=
for d in "$T_ROOT"/repos/*/; do
  d=${d%/}
  [ -f "$d/env" ] || continue
  found=1 name=${d##*/}
  repo=$(profile_get "$name" REPO) p=$(profile_get "$name" PIPELINE)
  if ! git -C "$repo" rev-parse > /dev/null 2>&1; then fix "repo $name: $repo isn't a git repo" "edit REPO= in $d/env"; continue; fi
  printf '    %-10s %s  (pipeline %s)\n' "$name" "$repo" "${p:-$T_PIPELINE}"
  if [ -n "$p" ] && [ ! -d "$T_ROOT/pipelines/$p" ]; then fix "repo $name: there's no pipeline '$p'" "edit PIPELINE= in $d/env"; fi
  if [ -z "$(profile_get "$name" TEST_CMD)" ] && ! grep -qs '^test:' "$repo/Makefile"; then
    echo "               · no TEST_CMD and no 'make test', so its test steps check nothing (add TEST_CMD= to $d/env)"
  fi
done
if [ -z "$found" ]; then echo "  · none yet: mkdir $T_ROOT/repos/NAME, and write REPO= into its env"; fi
if [ -n "$T_REPO" ]; then echo "    outside a repo, t new uses: $T_REPO"; fi

echo "pipelines   (t new -p NAME; * is the default)"
for d in "$T_ROOT"/pipelines/*/; do
  name=$(basename "$d") mark=' '
  if [ "$name" = "$T_PIPELINE" ]; then mark='*'; fi
  printf '  %s %-10s %s\n' "$mark" "$name" "$(flow "$name")"
  for s in $(steps "$name"); do
    if [ ! -x "$d$s" ]; then fix "$name/$s isn't an executable step" "ls -l $d$s"; fi
  done
  if no_repo "$name"; then echo "               needs no repo"; fi
  if [ -e "$T_ROOT/bin/t-$name" ]; then
    fix "pipeline $name has the name of a command, so t $name runs the command" "mv ${d%/} $T_ROOT/pipelines/OTHER-NAME"
  fi
done

if [ "$bad" = 0 ]; then echo "all good"; fi
exit "$bad"
