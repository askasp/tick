#!/usr/bin/env bash
# t show [TASK] — one task: where it is in its pipeline, its state, what you can do next, and its answer.
# In a terminal it pages through less, like git, and glow renders the answer's markdown.
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
task=$(task_dir "${1:-}") || exit 1
n=$(task_num "$task") step=$(cat "$task/step") pipeline=$(cat "$task/pipeline") st=$(state "$task")
waits_for=
if [[ $st == after* ]]; then waits_for=${st#after }; fi

mark=✓ flow=
for s in $(steps "$pipeline"); do
  who=$(solver "$pipeline" "${s#*-}" "$task")
  label=${s#*-}${who:+ ($who)}
  if [ "$s" = "$step" ]; then flow+="▶ $label  "; mark=·; else flow+="$mark $label  "; fi
done

glow= width=${FZF_PREVIEW_COLUMNS:-$(tput cols 2> /dev/null || echo 80)}
if { [ -t 1 ] || [ -n "${CLICOLOR_FORCE:-}" ]; } && command -v glow > /dev/null; then glow=1; fi   # t ui's pane forces it
if [ "$width" -gt 100 ]; then width=100; fi

answer() {   # glow writes into less, not a terminal: force its style and color, and hush its terminal queries
  if [ -n "$glow" ]; then CLICOLOR_FORCE=1 glow -s "${GLAMOUR_STYLE:-dark}" -w "$width" - < "$task/answer.md" 2> /dev/null
  else cat "$task/answer.md"; fi
}

show() {
  echo "$n  $(title "$task")"
  echo
  echo "  $pipeline:  $flow"
  case $st in
    ready)   echo "  state:     waiting for the next tick" ;;
    running) echo "  state:     running ${step#*-}, run $(cat "$task/runs/$step" 2> /dev/null || echo 1) of $MAX_RUNS" ;;
    after*)  echo "  state:     queued behind task $waits_for" ;;
    HOLD)    echo "  state:     ON HOLD: $(head -1 "$task/hold")" ;;
    done)    echo "  state:     done" ;;
  esac
  if [ -f "$task/repo" ]; then echo "  repo:      $(cat "$task/repo")"; fi
  if [ -e "$task/work" ]; then
    echo "  branch:    $(cat "$task/branch")  (from $(cat "$task/base"))"
    echo "  worktree:  $(readlink -f "$task/work")"
  fi
  if [ -f "$task/pr" ]; then echo "  PR:        $(cat "$task/pr")"; fi
  if [ -s "$task/feedback.md" ]; then echo "  feedback:  $(grep -m1 . "$task/feedback.md" | cut -c1-90)"; fi
  if [ -n "$waits_for" ]; then
    parent=$(tdir "$waits_for")
    echo; echo "  waiting for:"
    echo "    $waits_for  $(progress "$parent")  $(age "$parent")  $(name "$parent")"
    echo "    $(status "$parent")"
    echo "  it starts on the tick after $waits_for is done."
  fi
  if [ -f "$task/history" ]; then echo; echo "  history:"; tail -n 5 "$task/history" | sed 's/^/    /'; fi

  echo
  echo "  next:"
  case $st in
    ready)   echo "    t run $n            start it now, in this terminal" ;;
    running) echo "    t log $n -f         watch it" ;;
    after*)  echo "    t show $waits_for            the task it waits for" ;;
    HOLD)    echo "    t log $n            see why"
             echo "    t say $n \"...\"      tell it what to do; it starts over from its first step"
             echo "    t attach $n         take over the agent yourself, then: t resume $n" ;;
    done)    if [ -f "$task/answer.md" ]; then
               echo "    t say $n \"...\"      ask a follow-up"
             elif [ -f "$task/pr" ]; then
               echo "    review and merge   $(cat "$task/pr")"
               echo "    t say $n \"...\"      ask for more changes"
             else
               echo "    t diff $n           read the change"
               echo "    git -C $(cat "$task/repo") merge $(cat "$task/branch")"
               echo "    t say $n \"...\"      ask for more changes"
             fi
             echo "    t stack $n          start a task stacked on this one"
             echo "    t rm $n             delete the task" ;;
  esac

  if [ -s "$task/answer.md" ]; then echo; echo "  answer:"; answer; fi
}

if [ -t 1 ]; then show | LESS=${LESS-FRX} ${PAGER:-less}; else show; fi
