#!/usr/bin/env bash
# t stack [TASK] ["what to do"] — start a task stacked on another: same worktree, repo and pipeline, starts when TASK is done
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail
parent=$(task_dir "${1:-}")
shift || true
exec "$T_ROOT/bin/t-new" --on "$parent" "$@"
