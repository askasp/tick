#!/usr/bin/env bash
# t new ["what to do" [-]] [-p PIPELINE] [+STEP] [--on TASK] [--cli claude|opencode] [--test CMD] [-r REPO] [--now] [--edit] [--dry] — create a task
#
# No title: in a terminal with fzf, t compose opens; else $EDITOR, where line 1 is the title and the rest
# details for the agent (--edit opens it with a title too). A "-" reads the details from stdin instead:
#   cat spec.md | t new "Add proration" -
# The repo is -r NAME (a repo in repos/, a path, or a directory in $T_REPOS), else the one you're in,
# else $T_REPO. A pipeline with REPO=none (research) needs none; one with REPO=NAME (main: tick) runs
# only there. --now runs the task here, at once. --dry prints the task it would make, and makes nothing.
# The pipeline is -p (or t PIPELINE "..."), else the repo's own (PIPELINE= in repos/NAME/env), else $T_PIPELINE.
# +STEP adds one of its optional steps (OPTIONAL= in its env), which it otherwise leaves out: t feature +plan "...".
# --on TASK stacks it: that task's worktree, repo and pipeline, and it waits until that task is done.
# A title longer than 40 characters gets a short name for the board from an agent (see t name).
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
. "$T_ROOT/lib/new.sh"
set -euo pipefail

args=("$@") pipeline= on= cli= test= repo= base= title= details= stdin= now= edit= dry= opt=
while [ $# -gt 0 ]; do
  case $1 in
    -p)     pipeline=$2; shift ;;
    --on)   on=$2; shift ;;
    --cli)  cli=$2; shift ;;
    --test) test=$2; shift ;;
    --base) base=$2; shift ;;
    -r)     repo=$2; shift ;;
    -)      stdin=1 ;;
    --now)  now=1 ;;
    --edit) edit=1 ;;
    --dry)  dry=1 ;;
    +*)     opt+=" ${1#+}" ;;
    -*)     die "unknown flag $1" ;;
    *)      title=$1 ;;
  esac
  shift
done
if [ -n "$cli" ] && [ ! -x "$T_ROOT/drivers/$cli" ]; then
  die "no driver '$cli'; there are: $(ls "$T_ROOT/drivers" | xargs)"
fi
if [ -n "$pipeline" ] && [ ! -d "$T_ROOT/pipelines/$pipeline" ]; then
  die "no pipeline '$pipeline'; there are: $(ls "$T_ROOT/pipelines" | xargs)"
fi
if [ -z "$title$edit$dry$stdin" ] && [ -t 0 ] && [ -t 1 ] && command -v fzf > /dev/null && [ "${T_PICKER:-fzf}" = fzf ]; then
  exec "$T_ROOT/bin/t-compose" "${args[@]}"
fi
repo_arg=$repo

why=
if [ -n "$on" ]; then
  parent=$(task_dir "$on")
  repo=$(cat "$parent/repo") base=$(cat "$parent/branch") why="task $(task_num "$parent")'s"
  pipeline=${pipeline:-$(cat "$parent/pipeline")}
elif needs_repo; then
  find_repo
fi
pipeline=${pipeline:-$T_PIPELINE}
have=$(optional "$pipeline")               # what +plan may ask for: the steps the pipeline leaves out
for want in $opt; do
  case " $have " in *" $want "*) continue ;; esac
  die "pipeline $pipeline has no optional step +$want${have:+; it has: ${have// /, }}"
done

if [ -n "$dry" ]; then preview; exit 0; fi

from_first_words() { sed '/[^[:space:]]/,$!d'; }
if [ -z "$title" ] || [ -n "$edit" ]; then
  [ -t 0 ] && [ -t 1 ] || die 'usage: t new "what to do" [-p PIPELINE] [--on TASK]'
  f=$(mktemp --suffix=.md)
  {
    printf '%s\n\n' "$title"
    echo "# tick: line 1 is the title. Below it, details for the agent: files, examples, what done means."
    echo "# tick: ${repo:+${repo##*/} · }$pipeline${repo:+ · branches from $base}"
    echo "# tick: lines like these are dropped. Save an empty file to cancel."
  } > "$f"
  "${EDITOR:-vi}" "$f"
  text=$(grep -v '^# tick:' "$f" | from_first_words || true)
  rm -f "$f"
  title=$(head -1 <<< "$text")
  details=$(tail -n +2 <<< "$text" | from_first_words)
  [ -n "$title" ] || die "no title, so nothing was created"
elif [ -n "$stdin" ]; then
  details=$(cat)
fi

# the next free id; mkdir is atomic, so two `t new` at once never share one
mkdir -p "$T_TASKS"
n=$(last_task_num)
while :; do
  n=$((n + 1))
  if mkdir "$T_TASKS/$(printf %04d "$n")" 2> /dev/null; then break; fi
done
id=$(printf %04d "$n")
cd "$T_TASKS/$id"

{ echo "# $title"; if [ -n "$details" ]; then printf '\n%s\n' "$details"; fi; } > task.md
if [ -n "$repo" ]; then
  echo "$repo" > repo
  echo "$base" > base
  echo "t/$id$(slug "$title")" > branch
fi
echo "$pipeline" > pipeline
if [ -n "$opt" ]; then printf '%s\n' $opt > opt; fi     # the optional steps it asked for
steps "$pipeline" "$opt" | head -1 > step
mkdir log

: > lock
if [ -n "$on" ]; then
  echo "${parent##*/}" > after             # it branches from the task below, in a worktree of its own
  if [ -f "$parent/env" ]; then cp "$parent/env" env; fi
fi
if [ -n "$cli" ]; then echo "AGENT_CLI=$cli" >> env; fi
if [ -n "$test" ]; then printf 'TEST_CMD=%q\n' "$test" >> env; fi
if [ "${#title}" -gt 40 ]; then          # from t ui, named in the background: the board doesn't wait for an agent
  if [ -n "${T_UI:-}" ]; then setsid "$T_ROOT/bin/t-name" "$n" < /dev/null > /dev/null 2>&1 &
  else "$T_ROOT/bin/t-name" "$n" > /dev/null || true; fi
fi
if [ -n "${T_UI:-}" ]; then echo "$n" > "$T_UI/new"; fi                  # made from t ui: its cursor goes here

tick=
if [ -n "$now" ]; then when="Running it now."
elif [ -n "$on" ]; then when="It starts when task $(task_num "$parent") is done."
elif has_cron_tick; then when="Started; follow it with: t log $n -f" tick=1
else when="No cron tick is installed (see t doctor), so start it with: t run $n"
fi
echo "$id"
echo "t: task $n: pipeline $pipeline${repo:+, repo ${repo##*/}, branch $(cat branch)}. $when" >&2
if [ -n "$now" ]; then exec "$T_ROOT/bin/t-run" "$n"; fi
# only setsid goes to the background: a whole `a || b &` would fork a shell that keeps our stdout open,
# and $(t new) (t ui's Enter) would wait for the run to end
if [ -n "$tick" ]; then setsid "$T_ROOT/bin/t-run" "$n" < /dev/null > /dev/null 2>&1 & fi
