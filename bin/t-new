#!/usr/bin/env bash
# t new ["what to do" [-]] [-p PIPELINE] [--on TASK] [--cli claude|opencode] [--test CMD] [-r REPO] [--now] [--edit] [--dry] — create a task
#
# No title: in a terminal with fzf, t compose opens; else $EDITOR, where line 1 is the title and the rest
# details for the agent (--edit opens it with a title too). A "-" reads the details from stdin instead:
#   cat spec.md | t new "Add proration" -
# The repo is -r NAME (a repo in repos/, a path, or a directory in $T_REPOS), else the one you're in,
# else $T_REPO. A pipeline with REPO=none (research) needs none; one with REPO=NAME (main: tick) runs
# only there. --now runs the task here, at once. --dry prints the task it would make, and makes nothing.
# The pipeline is -p (or t PIPELINE "..."), else the repo's own (PIPELINE= in repos/NAME/env), else $T_PIPELINE.
# --on TASK stacks it: that task's worktree, repo and pipeline, and it waits until that task is done.
# A title longer than 40 characters gets a short name for the board from an agent (see t name).
. "$(dirname "$(readlink -f "$0")")/../lib/tick.sh"
set -euo pipefail

args=("$@") pipeline= on= cli= test= repo= base= title= details= stdin= now= edit= dry=
while [ $# -gt 0 ]; do
  case $1 in
    -p)     pipeline=$2; shift ;;
    --on)   on=$2; shift ;;
    --cli)  cli=$2; shift ;;
    --test) test=$2; shift ;;
    --base) base=$2; shift ;;
    -r)     repo=$2; shift ;;
    -)      stdin=1 ;;
    --now)  now=1 ;;
    --edit) edit=1 ;;
    --dry)  dry=1 ;;
    -*)     die "unknown flag $1" ;;
    *)      title=$1 ;;
  esac
  shift
done
[ -z "$cli" ] || [ -x "$T_ROOT/drivers/$cli" ] || die "no driver '$cli'; there are: $(ls "$T_ROOT/drivers" | xargs)"
[ -z "$pipeline" ] || [ -d "$T_ROOT/pipelines/$pipeline" ] || die "no pipeline '$pipeline'; there are: $(ls "$T_ROOT/pipelines" | xargs)"
if [ -z "$title$edit$dry$stdin" ] && [ -t 0 ] && [ -t 1 ] && command -v fzf > /dev/null && [ "${T_PICKER:-fzf}" = fzf ]; then
  exec "$T_ROOT/bin/t-compose" "${args[@]}"
fi
r_arg=$repo

trunk() {   # origin's copy first: a local main may be behind
  git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD && return
  local b
  for b in origin/main origin/master main master; do
    if git -C "$1" rev-parse -q --verify "$b^{commit}" > /dev/null; then echo "$b"; return; fi
  done
  return 1
}
slug() {   # "-add-the-widget", for the branch
  local s
  s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | cut -c1-40 | sed 's/^-*//; s/-*$//')
  echo "${s:+-$s}"
}

why=                                    # where the repo came from, for --dry
if [ -n "$on" ]; then
  parent=$(task_dir "$on")
  repo=$(cat "$parent/repo") why="task $((10#${parent##*/}))'s"
  base=$(cat "$parent/branch")
  pipeline=${pipeline:-$(cat "$parent/pipeline")}
elif [ -z "$repo" ] && [ -n "$pipeline" ] && no_repo "$pipeline"; then
  :
else
  pin=
  [ -z "$pipeline" ] || pin=$(env_get "$T_ROOT/pipelines/$pipeline/env" REPO)
  if [ -n "$pin" ] && [ "$pin" != none ]; then
    [ -z "$repo" ] || [ "$(realpath -m "$(repo_path "$repo")")" = "$(realpath -m "$(repo_path "$pin")")" ] ||
      die "$pipeline works only in $pin: leave out -r, or pick another pipeline with -p"
    repo=$pin why="$pipeline works only here"
  fi
  if [ -n "$repo" ]; then repo=$(repo_path "$repo") why=${why:--r}
  elif ! git rev-parse --git-dir > /dev/null 2>&1 && [ -n "$T_REPO" ]; then repo=$(repo_path "$T_REPO") why=T_REPO; fi
  common=$(git -C "${repo:-.}" rev-parse --path-format=absolute --git-common-dir 2> /dev/null) ||
    die "${repo:-this directory} is not in a git repo: cd into one, pass -r NAME, or set T_REPO in etc/tick.conf"
  repo=${common%/.git} why=${why:-this directory}
  [ -n "$pipeline" ] || pipeline=$(profile_get "$(profile_of "$repo")" PIPELINE)
  [ -n "$base" ] || base=$(trunk "$repo") || die "can't tell the trunk of $repo; pass --base BRANCH"
fi
pipeline=${pipeline:-$T_PIPELINE}

# IN_PLACE=yes (the main pipeline): no worktree; the task commits onto the branch the repo's checkout is on
in_place=
if [ -n "$repo" ] && [ "$(env_get "$T_ROOT/pipelines/$pipeline/env" IN_PLACE)" = yes ]; then
  in_place=$(git -C "$repo" branch --show-current)
  [ -n "$in_place" ] || die "$repo has no branch checked out, and $pipeline commits onto the one it's on"
  base=$(git -C "$repo" rev-parse HEAD)
fi

if [ -n "$dry" ]; then                  # what it would make, while you can still change it (t compose's preview)
  d= o= g= r= y=
  if [ -t 1 ] || [ -n "${CLICOLOR_FORCE:-}" ]; then d=$C_DIM o=$C_OFF g=$C_GREEN r=$C_RED y=$C_YELLOW; fi
  row() { printf '%s%-10s%s%s\n' "$d" "$1" "$o" "$2"; }
  n=$( (ls "$T_TASKS" 2> /dev/null || true) | sort -n | tail -1) n=$((10#${n:-0} + 1))
  first=$(steps "$pipeline" | head -1) first=${first#*-}
  who=${cli:-$(solver "$pipeline" "$first")}
  if [ -n "$repo" ]; then
    rn=$(profile_of "$repo")
    row repo "${rn:-${repo##*/}}$d   ($why)$o"
    row pipeline "$pipeline"
    row branch "${in_place:-t/$(printf %04d "$n")$(slug "$title")}"
    row base "$base"
  else
    row pipeline "$pipeline"
    row repo "${d}none needed$o"
  fi
  src=CLI_$first; [ -z "$cli" ] || src=--cli
  [ -z "$who" ] || row cli "$who$d  ($src)$o"
  if [ -n "$now" ]; then row starts "${g}now, here$o"
  elif [ -n "$on" ]; then row starts "when task $((10#${parent##*/})) is done"
  elif crontab -l 2> /dev/null | grep -q 'bin/t tick'; then row starts "${g}next tick, < 60s$o"
  else row starts "${r}only when you run it: there is no cron tick (see t doctor)$o"; fi
  if [ -n "$on" ]; then
    row shares "task $((10#${parent##*/}))'s worktree and lock"
    for c in "$T_TASKS"/*/after; do     # a sibling starts on the same tick, in the same worktree
      [ "$(cat "$c" 2> /dev/null)" = "${parent##*/}" ] && [[ $(state "${c%/after}") == after* ]] || continue
      printf '\n%stask %s is already stacked here and starts on the same tick%s\n' "$y" "$((10#$(basename "${c%/after}")))" "$o"
    done
  fi
  [ "${#title}" -le 40 ] || printf '\n%sname      an agent will pick a short one (title > 40)%s\n' "$y" "$o"
  [ -n "$repo" ] || [ -n "$now" ] || printf '\n%sthe answer lands in the pane; ^N answers it here and now%s\n' "$d" "$o"
  def=$(profile_get "$(profile_of "$repo")" PIPELINE) cmd="t new" flags=
  if [ -n "$on" ]; then flags+=" --on $((10#${parent##*/}))"
  elif [ "$pipeline" != "${def:-$T_PIPELINE}" ]; then
    if [ -e "$T_ROOT/bin/t-$pipeline" ]; then flags+=" -p $pipeline"; else cmd="t $pipeline"; fi
  fi
  [ -z "$r_arg" ] || flags+=" -r $r_arg"
  [ -z "$cli" ] || flags+=" --cli $cli"
  [ -z "$now" ] || flags+=" --now"
  short=${title:-…}; [ "${#short}" -le 22 ] || short="${short:0:21}…"
  printf '\n%s%s%s \\\n  "%s"%s\n' "$d" "$cmd" "$flags" "$short" "$o"            # the command, to type next time
  exit 0
fi

if [ -z "$title" ] || [ -n "$edit" ]; then
  [ -t 0 ] && [ -t 1 ] || die 'usage: t new "what to do" [-p PIPELINE] [--on TASK]'
  f=$(mktemp --suffix=.md)
  {
    printf '%s\n\n' "$title"
    echo "# tick: line 1 is the title. Below it, details for the agent: files, examples, what done means."
    echo "# tick: ${repo:+${repo##*/} · }$pipeline${repo:+ · branches from $base}"
    echo "# tick: lines like these are dropped. Save an empty file to cancel."
  } > "$f"
  "${EDITOR:-vi}" "$f"
  text=$(grep -v '^# tick:' "$f" || true)
  rm -f "$f"
  title=$(awk 'NF { print; exit }' <<< "$text")
  details=$(awk 'f; !f && NF { f = 1 }' <<< "$text" | sed '/./,$!d')
  [ -n "$title" ] || die "no title, so nothing was created"
elif [ -n "$stdin" ]; then
  details=$(cat)
fi

# the next free id; mkdir is atomic, so two `t new` at once never share one
mkdir -p "$T_TASKS"
n=$(ls "$T_TASKS" | sort -n | tail -1)
n=$((10#${n:-0}))
while :; do
  n=$((n + 1))
  mkdir "$T_TASKS/$(printf %04d "$n")" 2> /dev/null && break
done
id=$(printf %04d "$n")
cd "$T_TASKS/$id"

{ echo "# $title"; [ -z "$details" ] || printf '\n%s\n' "$details"; } > task.md
if [ -n "$repo" ]; then
  echo "$repo" > repo
  echo "$base" > base
  echo "${in_place:-t/$id$(slug "$title")}" > branch
fi
echo "$pipeline" > pipeline
steps "$pipeline" | head -1 > step
mkdir log

if [ -n "$on" ]; then
  p=${parent##*/}
  echo "$p" > after
  ln -s "../$p/work" work          # the parent's checkout...
  ln -s "../$p/lock" lock          # ...and its lock, so two tasks never run in it at once
  [ ! -f "$parent/env" ] || cp "$parent/env" env
elif [ -n "$in_place" ]; then
  ln -s "$repo" work
  ln -s "$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)/tick-in-place.lock" lock   # one task per checkout
else
  : > lock
fi
[ -z "$cli" ] || echo "AGENT_CLI=$cli" >> env
[ -z "$test" ] || printf 'TEST_CMD=%q\n' "$test" >> env
if [ "${#title}" -gt 40 ]; then          # from t ui, named in the background: the board doesn't wait for an agent
  if [ -n "${T_UI:-}" ]; then setsid "$T_ROOT/bin/t-name" "$n" < /dev/null > /dev/null 2>&1 &
  else "$T_ROOT/bin/t-name" "$n" > /dev/null || true; fi
fi
[ -z "${T_UI:-}" ] || echo "$n" > "$T_UI/new"                  # made from t ui: its cursor goes here

if [ -n "$now" ]; then when="Running it now."
elif [ -n "$on" ]; then when="It starts when task $((10#${parent##*/})) is done."
elif crontab -l 2> /dev/null | grep -q 'bin/t tick'; then when="Started; follow it with: t log $n -f" tick=1
else when="No cron tick is installed (see t doctor), so start it with: t run $n"; fi
echo "$id"
echo "t: task $n: pipeline $pipeline${repo:+, repo ${repo##*/}, branch $(cat branch)}. $when" >&2
[ -z "$now" ] || exec "$T_ROOT/bin/t-run" "$n"
# only setsid goes to the background: a whole `a || b &` would fork a shell that keeps our stdout open,
# and $(t new) (t ui's Enter) would wait for the run to end
if [ -n "${tick:-}" ]; then setsid "$T_ROOT/bin/t-run" "$n" < /dev/null > /dev/null 2>&1 & fi
