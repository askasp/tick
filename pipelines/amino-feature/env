# amino-feature: implement, test and review, then a pull request. With +plan, a planner first decides whether it is one
# pull request or a stack of small ones; with +preview, the repo's PREVIEW puts the branch online and
# its links on the PR; with +ci, the task waits for the PR's checks and fixes them.
OPTIONAL="plan preview ci"
# Who solves each agent step (claude or opencode): the planner is named, the rest take the default T_CLI.
# MODEL_<step>= pins a model for a step, and EFFORT_<step>= how hard claude thinks; every other step
# thinks at T_EFFORT (etc/tick.conf).
CLI_plan=claude                        # the planner gets the latest Opus, thinking as hard as it can
MODEL_plan=opus
EFFORT_plan=max

# The review reads the diff once per mindset named here, each time for one thing only: a name is a
# file in mindsets/, and one narrow question makes the reviewer read what a wide one skims past, like
# the callers outside the diff. craft, data and trust are left to jobs/idle-review: taste blocked more
# rounds than any bug did.
MINDSETS="intent defects blast-radius tests"
# From the third round on, only these may still send the task back: tests always find more.
LATE_MINDSETS="intent defects"
