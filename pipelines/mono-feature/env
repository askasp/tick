# mono-feature: a change to Periode's monorepo (repos/mono) from any directory: implement, test and review,
# then a pull request. The agents follow the repo's CLAUDE.md files and skills, and the house-rules review pass
# holds the diff to them. With +plan, a planner first decides whether it is one pull request or a stack of
# small ones; with +ci, the task waits for the PR's checks and fixes them.
REPO=mono
OPTIONAL="plan ci"
# Who solves each agent step (claude or opencode): the planner is named, the rest take the default T_CLI.
# MODEL_<step>= pins a model for a step, and EFFORT_<step>= how hard claude thinks; every other step
# thinks at T_EFFORT (etc/tick.conf).
CLI_plan=claude                        # the planner gets the latest Opus, thinking as hard as it can
MODEL_plan=opus
EFFORT_plan=max

# The review reads the diff once per mindset named here, each time for one thing only (mindsets/).
# craft, data and trust are left to jobs/idle-review.
MINDSETS="intent house-rules defects blast-radius tests"
# From the third round on, only these may still send the task back: a broken house rule still does.
LATE_MINDSETS="intent house-rules defects"
