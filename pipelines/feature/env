# feature: local's steps, then a pull request. With +plan, a planner first decides whether it is one
# pull request or a stack of small ones; with +ci, the task waits for the PR's checks and fixes them.
OPTIONAL="plan ci"
# Who solves each agent step (claude or opencode). MODEL_<step>= pins a model for it, and
# EFFORT_<step>= how hard claude thinks; every other step thinks at T_EFFORT (etc/tick.conf).
CLI_plan=claude                        # the planner gets the latest Opus, thinking as hard as it can
MODEL_plan=opus
EFFORT_plan=max
CLI_implement=opencode
CLI_review=opencode

# The review reads the diff once per line here, each time for one thing only: a fast local model
# is better at four small questions than at one big one, and a stacked PR gets no Copilot review.
REVIEWS="does it do what the task asked, and only that|bugs: wrong logic, unhandled errors, races, lost data|tests: is every new path covered, and does each test assert the rule|security and data: authorization, input validation, secrets, what leaves the system"
