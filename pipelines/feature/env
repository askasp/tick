# feature: local's steps, then a pull request. With +plan, a planner first decides whether it is one
# pull request or a stack of small ones; with +ci, the task waits for the PR's checks and fixes them.
OPTIONAL="plan ci"
# Who solves each agent step (claude or opencode). MODEL_<step>= pins a model for it, and
# EFFORT_<step>= how hard claude thinks; every other step thinks at T_EFFORT (etc/tick.conf).
CLI_plan=claude                        # the planner gets the latest Opus, thinking as hard as it can
MODEL_plan=opus
EFFORT_plan=max
CLI_implement=opencode
CLI_review=opencode
CLI_sync=opencode                      # the merger, when the base moved on

# The review reads the diff once per mindset named here, each time for one thing only: a name is a
# file in mindsets/, and a small local model is better at five narrow questions than one wide one.
# data and trust are left to jobs/idle-review, which has all the time in the world.
MINDSETS="intent defects blast-radius tests craft"
# From the third round on, only these may still send the task back: tests and craft always find more.
LATE_MINDSETS="intent defects"
