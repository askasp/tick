  said '[{"ts": "20.0", "user": "U0AKSEL", "text": "help"}]' replies
  "$tmp/tick/jobs/slack-in"
  [ ! -f "$(dir $id)/feedback.md" ]                # help is not something to tell the task
  grep -A3 '^chat.postMessage' "$FAKE/slack.calls" | grep -q 'thread_ts=20.0'
}

test_slack_takes_the_card_of_a_task_you_removed() {
  slack
  id=$(new -r toy "add the widget")
