  eq "$(step $id)" 10-answer
  t run $id
  eq "$(step $id)" done
  grep -q 'Your earlier answer' "$FAKE/read.prompts"
  grep -q 'and how do I run just one?' "$FAKE/read.prompts"
}

test_new_now_runs_the_task_at_once() {
  t new --now -p ask "how do the tests run?" < /dev/null > /dev/null 2>&1
  eq "$(step 0001)" done
}

test_with_cron_a_new_task_starts_without_waiting_for_the_tick() {
  echo "* * * * * $tmp/tick/bin/t tick" > "$FAKE/crontab"
  id=$(FAKE_SLEEP=0.5 new "add the widget")              # the run it starts takes a while...
  [ "$(step $id)" != done ]                               # ...and t new doesn't wait for it (t ui's Enter would)
  wait_done $id
}

test_a_pipeline_name_starts_a_task_in_that_pipeline() {
  t ask --now "how do the tests run?" < /dev/null > /dev/null 2>&1
  eq "$(cat "$(dir 0001)/pipeline")" ask
  eq "$(step 0001)" done
  t ask --help | grep -q 'stacks it'
  t complete commands | grep -q '^research:new task: answer (claude)'
  mkdir "$tmp/tick/pipelines/log"                          # a command wins over a pipeline, and doctor says so
  t log --help | grep -q '^t log'
  not grep -q '^log:new task' <(t complete commands)
  not t doctor > "$tmp/out"
  grep -q 'pipeline log has the name of a command' "$tmp/out"
}

test_show_says_where_a_task_is_and_what_comes_next() {
  id=$(new "add the widget")
  out=$(t show $id)
  grep -q '^pipeline  local · opencode$' <<< "$out"      # the agent named once
  grep -q '^          1 implement  2 test  3 review$' <<< "$out"
  grep -q '^state     waiting for the next tick$' <<< "$out"
  grep -q '^base      origin/main$' <<< "$out"           # what its diff is against, before it has a worktree
  grep -q 't run 1 ' <<< "$out"
  t run $id
  out=$(t show widget)
  grep -q '^  [0-9:]*  review     →  done$' <<< "$out"   # history, without the date, the task and "ok"
  grep -q 't diff 1 ' <<< "$out"
  t ls -a | grep -q ' 3/3 '
}

test_diff_shows_the_change() {
  id=$(new "add the widget")
  t run $id
  t diff $id | grep -q '^+change'
}

test_log_shows_every_run_in_order_each_followed_by_how_it_ended() {
  printf 'BROKEN\nfixed\n' > "$FAKE/impl"                 # the tests fail once: back to implement, in one second
  id=$(new "add the widget")
  t run $id
  eq "$(t log $id | grep -oE '[a-z]+( → [a-z]+)? +run [0-9]+|[a-z]+ → done' | tr -s ' ' | paste -sd,)" \
    "implement run 1,implement → test run 1,test → implement run 2,implement → test run 2,test → review run 1,review → done"
}

test_log_f_follows_the_task_into_the_steps_still_to_come() {
  id=$(new "add the widget")
  timeout 20 t log $id -f > "$tmp/out" 2>&1 &
  for i in $(seq 50); do grep -q '(no step has run yet)' "$tmp/out" && break; sleep 0.1; done
  t run $id
  for i in $(seq 50); do grep -q 'review → done' "$tmp/out" && break; sleep 0.1; done
  kill $!
  grep -q '(no step has run yet)' "$tmp/out"
  grep -qE 'implement → test +run 1' "$tmp/out"
  grep -q 'review → done' "$tmp/out"
}

test_ui_on_a_task_offers_what_to_do_with_it() {
  id=$(new "add the widget")
  printf '7\nbusy\n' | T_PICKER=select PAGER=cat tty "t ui $id" > /dev/null   # 7) hold, and why
  grep -q busy "$(dir $id)/hold"
  (. "$tmp/tick/lib/tick.sh"; T_COLOR=1 board | grep -qF "${C_RED}held")   # the live board shows it in red
  out=$(printf 'use a fixture\n' | T_PICKER=select tty "t ui $id say")   # say names the task and what happens next
  grep -q 'starts over at 10-implement' <<< "$out"
  grep -q 'use a fixture' "$(dir $id)/feedback.md"
  t hold $id busy
  tty "t ui $id hold" > /dev/null                         # its ctrl key again: it goes on
  [ ! -e "$(dir $id)/hold" ]
  not t ui $id nosuch 2> "$tmp/err"
  grep -q 'there are: log say' "$tmp/err"
  T_PICKER=select tty t | grep -q 'add the widget'        # no fzf: plain t prints the board
}

test_the_board_counts_steps_and_leaves_what_is_absent_blank() {
  new "add the widget" > /dev/null
  new -p ask "how do the tests run?" > /dev/null
  t run 2
  t ls -a > "$tmp/out"
  grep -qE '^ +1 +repo +add the widget +0/3 +next tick$' "$tmp/out"   # not begun: no age
  grep -qE '^ +2 +repo +how do the tests run\? +1/1 +answered$' "$tmp/out"
  not grep -q — "$tmp/out"                                # what is absent is blank
  eq "$(grep -v -E '^(GPU|tokens)' "$tmp/out" | awk '{ print index($0, "/") }' | sort -u | wc -l)" 1   # the step column lines up
  (. "$tmp/tick/lib/tick.sh"; T_COLS=80 board -a) > "$tmp/narrow"         # under 100 columns: no repo
  not grep -q repo "$tmp/narrow"
  grep -q ' 0/3 *next tick$' "$tmp/narrow"
}

test_the_board_says_what_each_task_is_doing_and_for_how_long() {
  printf 'noop\n' > "$FAKE/impl"
  id=$(new "add the widget")
  t ls | grep -qE '^ +1 .* 0/3 +next tick$'              # nothing ran yet
  t run $id
  t ls | grep -qE '^ +1 .* 1/3 +<1m +next tick +implement: the implementer changed nothing$'
  t hold $id "waiting on design"
  t ls | grep -qE ' 1/3 +<1m +held +waiting on design$'
  t keys $id | grep -qE '^enter:say .*:resume .*:keys$'  # enter says to it, a key resumes it, ? has the rest
}

test_the_board_names_the_file_and_never_a_whole_command() {
  id=$(new "add the widget")
  mkdir -p "$(dir $id)/log"
  did() { printf '=== 2026-09-11 10:00:00 10-implement, run 1\n  · %s\n' "$1" > "$(dir $id)/log/10-implement.log"; }
  did 'Read frontend/lib/wearables/workers/notify.ts'
  t ls | grep -q 'implement: Read notify.ts$'
  did 'Bash cd "$(git rev-parse --show-toplevel)" && ./fetch-pr-comments.sh 2>&1'
  t ls | grep -q 'implement: Bash fetch-pr-comments.sh$'
  did 'reading the discount code field and the proration it needs'
  t ls | grep -q 'implement: reading the discount code field…$'   # nothing gets more than a column
}

test_the_log_folds_a_run_of_one_tool_and_raw_shows_it_all() {
  id=$(new "add the widget")
  mkdir -p "$(dir $id)/log"
  { echo "=== 2026-09-11 10:00:00 10-implement, run 1"; echo "session: claude abc /x"
    for f in lib/health-sync.ts lib/health-notify.ts hooks/useHealth.ts lib/health-sync.ts; do echo "  · Read $f"; done
    echo "Read them."
    for i in 1 2 3 4 5 6 7; do echo "  · Grep p$i"; done
  } > "$(dir $id)/log/10-implement.log"
  t log $id > "$tmp/out"
  grep -qxF '       read   ×4  lib/health-*, hooks/useHealth.ts' "$tmp/out"
  grep -qxF '       Read them.' "$tmp/out"               # the agent's own words, in the text column
  grep -qxF '       grep   ×7  p1, p2, p3, p4, p5, p6, …' "$tmp/out"
  not grep -q 'session:' "$tmp/out"
  t log $id --raw > "$tmp/raw"
  eq "$(grep -c '· Read' "$tmp/raw")" 4
  grep -q '^session: claude abc' "$tmp/raw"              # the id t attach resumes
  ( exec 9> "$(dir $id)/lock"; flock 9; sleep 30 ) &     # while it runs, its last three calls stay lines
  sleep 0.3
  t log $id | tail -4 > "$tmp/live"
  eq "$(head -1 "$tmp/live")" '       grep   ×4  p1, p2, p3, p4'
  eq "$(tail -1 "$tmp/live")" '       grep   p7'
  kill $!
}

test_an_agents_markdown_reads_as_text_folded_to_the_pane() {
  id=$(new "add the widget")
  mkdir -p "$(dir $id)/log"
  cp "$tmp/tick/test/fixtures/opencode-review.log" "$(dir $id)/log/30-review.log"
  FZF_PREVIEW_COLUMNS=60 t log $id > "$tmp/out"
  [ "$(LC_ALL=C.UTF-8 wc -L < "$tmp/out")" -lt 60 ]       # folded to the pane, so fzf wraps nothing
  grep -qE '^13:11  review +run 1$' "$tmp/out"            # the banner: its time, step, and run at the edge
  not grep -qE '\*\*|`|^ *#' "$tmp/out"                   # the markdown is rendered, not printed
  grep -qxF '       Analysis' "$tmp/out"
  grep -qxF '       · suppresses CONNECTION_ENDED only in that window' "$tmp/out"
  tr -s ' \n' '  ' < "$tmp/out" | grep -qF 'causing the postgres library to reject it with CONNECTION_ENDED.'   # no word broken
  red=$(. "$tmp/tick/lib/tick.sh"; echo "$C_RED")
  FZF_PREVIEW_COLUMNS=60 CLICOLOR_FORCE=1 t log $id | grep -qF "${red}closeDb()"   # code stands out in red
}

test_the_pane_shows_details_log_or_diff() {
  id=$(new "add the widget")
  t run $id
  t peek $id | grep -q '^          1 implement  2 test  3 review$'   # done: its details,
  not grep -q 't diff 1' <(t peek $id)                    # without what to do next: the board's keys say
  timeout 0.5 t peek $id log | grep -q 'review → done'
  t peek $id diff | sed 's/\x1b\[[0-9;]*m//g' | grep -q '^+change'   # in color
  t peek $id steps | grep -qE '^30-review +1 run'
  timeout 0.5 t peek $id raw | grep -q '^session: opencode'
  t keys $id | grep -qE '^enter:diff +[^ ]+:stack +[^ ]+:say '
  export T_UI=$tmp/ui T_NEW=$tmp/ui                        # and the key the footer offers works
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  t ui --key "$(keyfor say)" $((10#$id)) '' | grep -q "change-prompt(say to $((10#$id))> )"
}

test_steps_says_how_each_step_went_and_which_file_each_setting_comes_from() {
  profile                                                 # toy has a TEST_CMD of its own
  printf 'BROKEN\nfixed\n' > "$FAKE/impl"                 # the tests fail once: back to implement
  id=$(new -r toy -p local --test "make test" "add the widget")
  t peek $id steps | grep -qE '^10-implement +next tick '     # nothing ran yet
  t peek $id steps | grep -q '^implement — '              # what the step it is on does
  t run $id
  out=$(t peek $id steps)
  grep -qE '^10-implement  2 runs   ok → test +→ steps/implement · [0-9]+ pipelines$' <<< "$out"
  grep -qE '^20-test +2 runs   ok → review ' <<< "$out"
  grep -qE '^30-review +1 run    ok → done ' <<< "$out"
  grep -qE '^  CLI_implement +opencode  pipelines/local$' <<< "$out"
  grep -qE '^  TEST_CMD +make test  task$' <<< "$out"      # the task's own beats the repo's
  grep -qE "^  REPO +$tmp/repo  repos/toy$" <<< "$out"
}

test_compose_takes_flags_typed_with_the_title() {
  mkdir "$tmp/new"; : > "$tmp/new/args"; : > "$tmp/new/repo"
  out=$(T_NEW=$tmp/new t compose --dry local "what changed in bash? -p research")
  grep -q '^pipeline *research$' <<< "$out"
  grep -q '"what changed in bash?"' <<< "$out"
}

test_the_board_starts_a_task_and_says_to_one_in_place() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  t ui --key "$(keyfor new)" '' '' | grep -q 'change-prompt(new> )+disable-search'
  eq "$(cat "$T_UI/pick")" local
  t ui --key tab '' '' > /dev/null                        # tab: the next pipeline
  eq "$(cat "$T_UI/pick")" feature
  t ui --pane '' 'add the widget' | sed 's/\x1b\[[0-9;]*m//g' | grep -q '^pipeline *feature'   # in color
  t ui --key "$(keyfor agent)" '' '' > /dev/null          # another agent than the pipeline's
  t ui --pane '' 'add the widget' | sed 's/\x1b\[[0-9;]*m//g' | grep -q '^cli *claude  (--cli)'
  t ui --key enter '' 'add the widget' | grep -q 'reload-sync'   # made; the reload's end puts the cursor on it
  eq "$(cat "$T_UI/new")" 1
  eq "$(cat "$(dir 0001)/pipeline")" feature
  grep -q '^AGENT_CLI=claude$' "$(dir 0001)/env"
  t hold 1 waiting
  t ui --key enter 1 '' | grep -q 'change-prompt(say to 1> )'   # Enter on a held task: say to it
  t ui --key enter 1 'use a fixture' > /dev/null
  grep -q 'use a fixture' "$(dir 0001)/feedback.md"
  [ ! -e "$(dir 0001)/hold" ]
  eq "$(cat "$T_UI/mode")" board
}

test_ui_new_form_preview_is_spaced_from_header() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  t ui --key enter '' '' > /dev/null                      # enter on an empty board: a new task
  eq "$(t ui --pane '' 'add the widget' | sed -n 2p)" ""  # a blank line under the pipelines
}

test_the_board_holds_renames_and_deletes_in_place() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  new "add the widget" > /dev/null
  new "fix the gadget" > /dev/null
  t ui --key "$(keyfor hold)" 1 '' | grep -q 'change-prompt(hold 1 because> )'
  t ui --key enter 1 'waiting on design' > /dev/null
  grep -q 'waiting on design' "$(dir 0001)/hold"
  t ui --key "$(keyfor hold)" 1 '' > /dev/null                    # held: ^r resumes it at once
  [ ! -e "$(dir 0001)/hold" ]
  t ui --key "$(keyfor keys)" 1 '' | grep -q 'change-prompt(do to 1> )'   # ? asks for the action by name...
  t ui --key enter 1 na | grep -q 'change-query~add the widget~'   # ...and its first letters will do
  t ui --key enter 1 'Widget' > /dev/null
  eq "$(cat "$(dir 0001)/name")" Widget
  t ui --key "$(keyfor keys)" 1 '' > /dev/null
  t ui --key enter 1 rm > /dev/null
  t ui --pane 1 '' | grep -q 'Deletes its directory'   # the pane says what goes before Enter does it
  [ -d "$(dir 0001)" ]
  t ui --key enter 1 '' > /dev/null
  [ ! -e "$(dir 0001)" ]
  eq "$(cat "$T_UI/new")" 2                              # the cursor goes to the next task
  t ui --key "$(keyfor log)" 2 '' > /dev/null
  t ui --key "$(keyfor log)" 2 '' > /dev/null
  eq "$(cat "$T_UI/pane")" raw                           # ^l again: the log as it is
  t ui --key "$(keyfor keys)" 2 '' > /dev/null
  t ui --pane 2 '' | grep -q 'delete it and its worktree'
  eq "$(cat "$T_UI/mode")" "do 2"
  t ui --key enter 2 r | grep -q 'could be: run rm'      # two start so: it says which
  t ui --key "$(keyfor keys)" 2 '' > /dev/null                        # ? again: back
  eq "$(cat "$T_UI/mode")" board
}

test_a_key_does_one_thing_on_the_board_and_one_in_a_form() {
  ( . "$tmp/tick/lib/tick.sh"
    eq "$(printf '%s\n' "$ACTIONS" "$BOARD_KEYS" | awk '$2 != "-" { print $2 }' | sort | uniq -d)" ""
    eq "$(printf '%s\n' "$FORM_KEYS" "$BOARD_KEYS" | awk '{ print $2 }' | sort | uniq -d)" "" )
}

test_the_live_board_draws_its_rows_and_the_keys_at_the_bottom() {
  command -v tmux > /dev/null && command -v fzf > /dev/null || return 0
  new "add the widget" > /dev/null
  server=tick-${tmp##*/}
  tmux -f /dev/null -L "$server" new-session -d -x 160 -y 16 t
  for i in $(seq 100); do                                 # the pane comes last
    tmux -L "$server" capture-pane -p > "$tmp/screen"
    if grep -q 'implement · next tick' "$tmp/screen"; then break; fi
    sleep 0.1
  done
  last=$(($(tmux -L "$server" display-message -p '#{pane_height}') - 1))
  tmux -L "$server" capture-pane -p -e -E 0 > "$tmp/top"
  tmux -L "$server" capture-pane -p -e -S "$last" > "$tmp/bottom"
  tmux -L "$server" kill-server
  cat "$tmp/screen" >&2                                    # what it drew, should a line below fail
  for corner in top bottom; do                             # the list's grey reaches the edges, with no gap in the terminal's
    grep -qE $'^[\e[0-9;m]*48;2;28;28;28' "$tmp/$corner"
  done
  grep -q '^[│ ]*task> ' "$tmp/screen"
  grep -qE '^[│ ]*> +1 +(repo +)?add the widget +0/3 +next tick' "$tmp/screen"   # fzf's pointer
  grep -q 'implement · next tick' "$tmp/screen"                      # the pane on it
  grep -qE 'enter:run .*:keys' "$tmp/screen"
}

test_doctor_says_what_to_fix() {
  not t doctor > "$tmp/out"
  if command -v fzf > /dev/null; then grep -q '✓ fzf (the live board)' "$tmp/out"; fi   # fzf knows the board's flags and colors
  grep -q 'no cron line' "$tmp/out"
  grep -q '\* local ' "$tmp/out"
  echo "* * * * * $tmp/tick/bin/t tick" > "$FAKE/crontab"
  t doctor > "$tmp/out"
  grep -q 'all good' "$tmp/out"
}

test_the_front_digest_puts_comments_that_mention_you_first() {
  front
  now=$(date +%s)
  page "[{\"id\": \"cnv_mail\", \"subject\": \"Invoice question\", \"status\": \"open\", \"updated_at\": $now}]" > "$FAKE/front/conversations_search_recipient"
  page "[{\"id\": \"cnv_tag\", \"subject\": \"Launch plan\", \"status\": \"open\", \"updated_at\": $((now - 60))}]" > "$FAKE/front/conversations_search_mention"
  page "[{\"type\": \"email\", \"created_at\": $now, \"text\": \"Can you resend the invoice?\", \"recipients\": [{\"role\": \"from\", \"handle\": \"bob@shop.example\"}]},
         {\"type\": \"email\", \"created_at\": 1, \"text\": \"old news\", \"recipients\": []}]" > "$FAKE/front/conversations_cnv_mail_messages"
  page "[{\"id\": \"com_1\", \"posted_at\": $now, \"author\": {\"id\": \"tea_kari\", \"first_name\": \"Kari\", \"last_name\": \"N\"}, \"body\": \"@me can you sign off?\"}]" > "$FAKE/front/conversations_cnv_tag_comments"
  page '[{"id": "tea_me"}]' > "$FAKE/front/comments_com_1_mentions"
  "$tmp/tick/jobs/front-digest" > "$tmp/digest"
  [ -s "$tmp/digest" ]
  p=$FAKE/read.prompts
  grep -q 'comment by Kari N, .* — MENTIONS YOU' "$p"
  [ "$(grep -n 'Launch plan' "$p" | cut -d: -f1)" -lt "$(grep -n 'Invoice question' "$p" | cut -d: -f1)" ]
  grep -q 'email from bob@shop.example' "$p"
  not grep -q 'old news' "$p"
}

idle() { "$tmp/tick/jobs/idle-review" 2> /dev/null; }   # one pass of jobs/idle-review, quietly   # one pass of jobs/idle-review, quietly
reads() { grep -c '^=====$' "$FAKE/read.prompts" 2> /dev/null || echo 0; }   # prompts a reviewer got

test_idle_review_reads_finished_work_with_a_mindset_its_pipeline_skipped() {
  echo 'MINDSETS="intent"' >> "$tmp/tick/pipelines/local/env"
  id=$(new "add the widget")
  t run $id
  eq "$(reads)" 1                                         # the pipeline read it once, as intent
  idle
  eq "$(reads)" 2
  [ ! -e "$(dir $id)/idle/intent" ]                       # the one its pipeline runs waits its turn
  m=$(ls "$(dir $id)/idle")                               # whichever it took, that mindset was read
  grep -qF "$(head -1 "$tmp/tick/mindsets/$m.md")" "$FAKE/read.prompts"
  eq "$(cut -d' ' -f1 "$(dir $id)/idle/$m")" "$(git -C "$(t path $id)" rev-parse HEAD)"
}

test_the_board_says_which_mindset_is_reading_a_finished_task() {
  id=$(new "add the widget")
  t run $id
  FAKE_SLEEP=3 setsid "$tmp/tick/jobs/idle-review" > /dev/null 2>&1 &
  for _ in $(seq 50); do [ -s "$(dir $id)/note" ] && break; sleep 0.2; done
  t ls -a | grep "^ *$((10#$id)) " | grep -q 'idle review  '      # something is happening, and what
  wait
  [ ! -e "$(dir $id)/note" ]                                      # and the board says done again
  t ls -a | grep "^ *$((10#$id)) " | grep -q ' done$'
}

test_idle_review_waits_while_the_gpu_is_yours() {
  id=$(new "add the widget")
  t run $id
  before=$(reads)
  export GPU_BUSY=true                                    # as a Steam game makes it
  idle
  eq "$(reads)" "$before"
  export GPU_BUSY=false
  idle
  eq "$(reads)" "$((before + 1))"                         # and reads again once you stop playing
}

test_idle_review_goes_quiet_when_every_mindset_has_read_the_commit() {
  export IDLE_PASSES=1
  id=$(new "add the widget")
  t run $id
  for _ in $(ls "$tmp/tick/mindsets"); do idle; done
  before=$(reads)
  idle
  eq "$(reads)" "$before"                                 # nothing new to look at, and it says nothing
  eq "$(ls "$(dir $id)/idle" | wc -l)" "$(ls "$tmp/tick/mindsets" | wc -l)"
}

test_what_an_idle_review_finds_goes_back_to_the_task_once() {
  printf 'approve\nchanges\n' > "$FAKE/verdicts"         # the pipeline approves; the idle pass doesn't
  id=$(new "add the widget")
  t run $id
  idle
  eq "$(step $id)" 10-implement                           # said to the task, which starts over
  grep -q '^## idle review: ' "$(dir $id)/feedback.md"    # and the note says which mindset found it
  eq "$(cat "$(dir $id)/idle/fixes")" 1
  idle
  eq "$(cat "$(dir $id)/idle/fixes")" 1                   # it is running now: one finding at a time
}

test_idle_review_leaves_a_busy_machine_alone() {
  id=$(new "add the widget")
  t run $id
  exec 9> "$(dir $id)/lock"; flock 9
  echo 10-implement > "$(dir $id)/step"                   # something is running
  before=$(reads)
  idle
  eq "$(reads)" "$before"
  exec 9>&-
}

test_two_idle_reviews_never_overlap() {
  id=$(new "add the widget")
  t run $id
  mkdir -p "$T_VAR"; exec 8> "$T_VAR/idle.lock"; flock 8
  before=$(reads)
  idle
  eq "$(reads)" "$before"
  exec 8>&-
}

test_idle_review_passes_over_work_it_cannot_help() {
  a=$(new "landed work" -p main)                          # main lands its branch on the trunk
  t run $a
  b=$(new "parent work"); c=$(new "child work" --on $b)
  t run $b
  d=$(new "held work"); t run $d; t hold $d "not now" > /dev/null 2>&1
  e=$(new "a question" -p ask); t run $e                  # no worktree at all
  before=$(reads)
  idle
  eq "$(reads)" "$before"                                 # landed, stacked on, held, no worktree
  eq "$(step $c)" 10-implement
}

test_idle_review_asks_one_task_for_no_more_fixes_than_it_may() {
  export IDLE_FIXES=1
  printf 'approve\nchanges\napprove\n' > "$FAKE/verdicts"
  id=$(new "add the widget")
  t run $id
  idle
  eq "$(cat "$(dir $id)/idle/fixes")" 1
  t run $id                                               # it fixes what the idle review found
  eq "$(step $id)" done
  before=$(reads)
  idle
  eq "$(reads)" "$before"                                 # and is left alone from now on
}

test_idle_review_leaves_a_closed_pull_request_alone() {
  profile
  echo MERGED > "$FAKE/pr_state"
  id=$(new "add the widget" -r toy -p feature)
  t run $id
  eq "$(step $id)" done
  before=$(reads)
  idle
  eq "$(reads)" "$before"
  [ -n "$(ls "$(dir $id)/idle")" ]                        # marked read, so it stops being a candidate
}

test_idle_review_is_a_job_the_rest_of_tick_knows_nothing_about() {
  not grep -rq 'idle/' "$root/bin" "$root/lib" "$root/steps" "$root/drivers" "$root/pipelines" "$root/etc"
}

