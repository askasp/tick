#!/usr/bin/env bash
# test/run [PATTERN] — every test (or those matching PATTERN), with fake claude/opencode/gh/crontab.
# Never calls a model. Tests run in parallel, each under set -e in its own copy of tick, with its own T_VAR and a
# toy repo that has a bare "origin" and a `make test` that fails while impl.txt ends in BROKEN.
root=$(cd "$(dirname "$0")/.." && pwd)
path=$PATH
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 SHELL=/bin/bash
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
unset T_VAR T_PIPELINE T_REPO T_REPOS MAX_RUNS SLOTS_claude SLOTS_opencode AGENT_CLI AGENT_MODEL T_PICKER
# run by a tick task's test step, the task's settings are exported (TEST_CMD=test/run would be the toy's too),
# and so is t ui's state when the board started the task: its T_UI is gone by now, and t new writes there
unset TASK_ID T_STEP T_UI T_NEW T_UI_CHANGED TEST_CMD TEARDOWN $(cat "$root"/pipelines/*/env "$root"/repos/*/env 2> /dev/null | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | sort -u)

eq()   { [ "$1" = "$2" ] || { echo "expected '$2', got '$1'" >&2; return 1; }; }
not()  { if "$@"; then echo "should have failed: $*" >&2; return 1; fi; }
new()  { t new "$@" < /dev/null 2> /dev/null; }
dir()  { echo "$T_VAR/tasks/$1"; }
step() { cat "$(dir "$1")/step"; }
tty()  { script -qec "$1" /dev/null; }      # run a command line in a pseudo-terminal
wait_done() {
  local i id all
  for i in $(seq 150); do
    all=1
    for id; do [ "$(step "$id")" = done ] || all=; done
    [ -z "$all" ] || return 0
    sleep 0.2
  done
  echo "timed out waiting for $*" >&2; t ls -a >&2; return 1
}

setup() {
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  cp -a "$root" "$tmp/tick"
  rm -rf "$tmp/tick/repos"                 # your own repos stay out of the tests
  echo "REPO=$tmp/repo" >> "$tmp/tick/pipelines/main/env"   # main is tick's; here it is the toy repo's
  export T_VAR=$tmp/var FAKE=$tmp/fake PATH=$tmp/tick/test/fake:$tmp/tick/bin:$path
  mkdir -p "$FAKE"
  git init -q --bare -b main "$tmp/origin.git"
  git init -q -b main "$tmp/repo"
  cd "$tmp/repo"
  printf 'test:\n\t@! tail -1 impl.txt 2>/dev/null | grep -q BROKEN\n' > Makefile
  git add Makefile && git commit -q -m init
  git remote add origin "$tmp/origin.git"
  git push -q -u origin main 2> /dev/null
  git remote set-head origin main
}

profile() {   # a repo named "toy" for the toy repo: feature by default, with a test command of its own
  mkdir -p "$tmp/tick/repos/toy"
  printf 'REPO=%s\nPIPELINE=feature\nTEST_CMD="touch %s/tested && make test"\n' "$tmp/repo" "$tmp" > "$tmp/tick/repos/toy/env"
}

front() {   # a Front account for jobs/front-digest, served by the fake curl: me@example.com is tea_me
  export XDG_CONFIG_HOME=$tmp/config
  mkdir -p "$tmp/config/front" "$FAKE/front"
  printf 'FRONT_TOKEN=secret\nFRONT_EMAIL=me@example.com\n' > "$tmp/config/front/env"
  echo '{"id": "tea_me"}' > "$FAKE/front/teammates_alt:email:me@example.com"
}
page() { jq -nc --argjson r "$1" '{_results: $r, _pagination: {next: null}}'; }

test_scripts_parse() {
  for f in "$root"/bin/* "$root"/steps/* "$root"/drivers/* "$root"/jobs/* "$root"/test/fake/* "$root"/lib/*; do bash -n "$f"; done
}

test_help_shows_how_to_start_a_task() {
  t help | grep -q 'Start a task'
  t help | grep -q 'feature .*implement (opencode)'
  t help | grep -q 't resume'
  t new --help | grep -q 'stacks it'
  not t nosuch 2> "$tmp/err"
  grep -q 'Start a task' "$tmp/err"
}

test_a_task_runs_to_done_in_its_own_worktree() {
  id=$(new "add the widget")
  eq "$id" 0001
  eq "$(step $id)" 10-implement
  t run $id
  eq "$(step $id)" done
  w=$(t path $id)
  eq "$w" "$(readlink -f "$(dir $id)/work")"
  eq "$(git -C "$w" branch --show-current)" t/0001-add-the-widget
  eq "$(git -C "$w" rev-list --count origin/main..HEAD)" 1
  eq "$(git -C "$w" log -1 --format=%s)" "add the widget"
  grep -q ' 1 30-review ok → done' "$(dir $id)/history"   # history names the task, not the run
}

test_review_feedback_reaches_the_implementer() {
  printf 'changes\napprove\n' > "$FAKE/verdicts"
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  eq "$(cat "$(dir $id)/runs/10-implement")" 2
  grep -q 'Feedback to address' "$FAKE/edit.prompts"
  grep -q 'VERDICT: changes' "$FAKE/edit.prompts"
  ls "$(dir $id)"/log/feedback.*.md > /dev/null          # archived once it was addressed
  [ ! -e "$(dir $id)/feedback.md" ]
}

test_failing_tests_go_back_to_the_implementer() {
  printf 'BROKEN\nfixed\n' > "$FAKE/impl"
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  grep -q 'The tests fail' "$FAKE/edit.prompts"
  grep -q '20-test ok → 10-implement' "$(dir $id)/history"
}

test_a_step_that_never_gets_past_holds_the_task() {
  printf 'changes\nchanges\nchanges\nchanges\n' > "$FAKE/verdicts"
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" 30-review                              # implement moves on each time; review sends it back
  grep -q 'ran 3 times' "$(dir $id)/hold"
  t ls | grep -q 'HELD review ran 3 times'
  t run $id
  eq "$(cat "$(dir $id)/runs/30-review")" 3               # held: nothing ran
  t resume $id 2> /dev/null
  t run $id                                               # one more "changes", then approve
  eq "$(step $id)" done
}

test_a_step_counts_its_runs_afresh_once_the_task_moved_past_it() {
  export SLOTS_opencode=1
  printf 'BROKEN\nBROKEN\nfixed\n' > "$FAKE/impl"         # test sends it back twice, then passes
  id=$(new "fix the widget" -p main)
  mkdir -p "$T_VAR/run"
  ( exec 8> "$T_VAR/run/opencode.1"; flock 8; sleep 2 ) &
  sleep 0.5
  t run $id                                               # makes the worktree, then waits for a slot
  wait
  echo other > other.txt && git add other.txt && git commit -q -m "meanwhile on main"
  t run $id                                               # merge brings main in: test runs a 4th time
  eq "$(step $id)" done
  eq "$(grep -c '20-test ok' "$(dir $id)/history")" 4
}

test_an_implementer_that_changes_nothing_fails() {
  printf 'noop\nnoop\nnoop\n' > "$FAKE/impl"
  id=$(new "add the widget")
  t run $id; t run $id; t run $id
  eq "$(step $id)" 10-implement
  [ ! -e "$(dir $id)/hold" ]
  grep -q 'changed nothing' "$(dir $id)/log/10-implement.log"
  t run $id
  [ -e "$(dir $id)/hold" ]
}

test_tasks_run_in_parallel_worktrees_off_main() {
  export SLOTS_opencode=2
  a=$(new "task a")
  b=$(new "task b")
  t tick
  wait_done $a $b
  wa=$(t path $a) wb=$(t path $b)
  [ "$wa" != "$wb" ]
  git -C "$wa" merge-base --is-ancestor origin/main HEAD
  git -C "$wb" merge-base --is-ancestor origin/main HEAD
  not git -C "$wb" merge-base --is-ancestor "t/$a-task-a" HEAD
}

test_a_stacked_task_waits_then_builds_on_its_parent() {
  a=$(new "parent work")
  b=$(new "child work" --on $a)
  t run $b
  eq "$(step $b)" 10-implement                            # queued behind $a
  t ls | grep "^$((10#$b)) " | grep -q "after $((10#$a))"
  t run $a
  eq "$(step $a)" done
  t run $b
  eq "$(step $b)" done
  eq "$(t path $b)" "$(t path $a)"                        # one worktree
  w=$(t path $b)
  eq "$(git -C "$w" branch --show-current)" "t/$b-child-work"
  git -C "$w" merge-base --is-ancestor "t/$a-parent-work" HEAD
  eq "$(git -C "$w" rev-list --count "t/$a-parent-work..HEAD")" 1
  eq "$(cat "$(dir $b)/base")" "t/$a-parent-work"
  grep -q "git diff t/$a-parent-work...HEAD" "$FAKE/read.prompts"   # its review saw only its own diff
}

test_a_stacked_task_sits_under_its_parent_until_that_is_done() {
  a=$(new "parent work")
  b=$(new "child work" --on $a)
  t ls | grep -A1 "^$((10#$a)) " | grep -q "^$((10#$b)) .*└ child work .*after $((10#$a))$"
  t show $b | grep -q 'waiting for:'                      # and what its parent is doing
  t run $a
  out=$(t ls)
  grep -q "^$((10#$b)) .* child work .*next tick$" <<< "$out"
  not grep -q └ <<< "$out"
}

test_t_stack_starts_a_task_on_another() {
  a=$(new "parent work")
  b=$(t stack $a "child work" < /dev/null 2> /dev/null)
  eq "$(cat "$(dir $b)/after")" "$a"
  t run $a
  eq "$(step $a)" done
  t run $b
  eq "$(step $b)" done
}

test_a_stack_never_runs_two_steps_in_one_worktree() {
  a=$(new "parent work")
  b=$(new "child work" --on $a)
  t run $a
  exec 9> "$(dir $a)/lock"; flock 9
  t run $b
  eq "$(step $b)" 10-implement                            # its parent's lock is its lock
  exec 9>&-
  t run $b
  eq "$(step $b)" done
}

test_full_agent_slots_mean_try_again_later() {
  export SLOTS_opencode=1
  mkdir -p "$T_VAR/run"
  exec 8> "$T_VAR/run/opencode.1"; flock 8
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" 10-implement
  eq "$(cat "$(dir $id)/runs/10-implement")" 0            # waiting isn't a run
  grep -q 'slots busy' "$(dir $id)/log/10-implement.log"
  exec 8>&-
  t run $id
  eq "$(step $id)" done
}

test_a_killed_run_is_picked_up_again() {
  id=$(new "add the widget")
  FAKE_SLEEP=5 setsid t run $id > /dev/null 2>&1 &
  sleep 1
  t ls | grep "^$((10#$id)) " | grep -q ' implement: '     # running: its step's latest line
  fuser -s -k "$(dir $id)/lock"                           # like a reboot: everything in the run dies
  sleep 0.3
  eq "$(step $id)" 10-implement
  t run $id                                               # the kernel dropped the lock; nothing to clean
  eq "$(step $id)" done
  eq "$(cat "$(dir $id)/runs/10-implement")" 2
}

test_feature_pipeline_opens_a_pr_and_waits_for_ci() {
  printf 'pending\nfail\npass\n' > "$FAKE/checks"
  id=$(new "add the widget" -p feature)
  t run $id
  eq "$(step $id)" 50-ci                                  # checks pending: waiting
  eq "$(cat "$(dir $id)/runs/50-ci")" 0
  eq "$(cat "$(dir $id)/pr")" https://github.com/example/repo/pull/1
  git --git-dir="$tmp/origin.git" rev-parse -q --verify "refs/heads/t/$id-add-the-widget" > /dev/null
  t run $id                                               # fails → implement → … → pushed again → passes
  eq "$(step $id)" done
  grep -q 'FAIL test_widget' "$FAKE/edit.prompts"
  eq "$(grep -c '^pr create' "$FAKE/gh.calls")" 1         # the second push reuses the PR
  eq "$(git --git-dir="$tmp/origin.git" rev-list --count "main..t/$id-add-the-widget")" 2
}

test_a_feature_is_one_pull_request_unless_its_plan_splits_it() {
  echo "Looks small to me." > "$FAKE/plan"
  id=$(new "add the widget" -p feature)
  t run $id
  eq "$(step $id)" 05-plan                                # a plan without a PART line is no plan
  grep -q 'no PART line' "$(dir $id)/log/05-plan.log"
  t run $id                                               # the planner's default: one part
  eq "$(step $id)" done
  grep -q '^Decide how many pull requests' "$FAKE/read.prompts"
  eq "$(cat "$(dir $id)/task.md")" "# add the widget"     # the task as it was asked
  eq "$(ls "$T_VAR/tasks" | wc -l)" 1
  eq "$(grep -c '^pr create' "$FAKE/gh.calls")" 1
}

test_a_plan_in_parts_becomes_a_stack_of_pull_requests() {
  printf 'Three seams.\n\nPART: Add the widget table\nThe table only.\n\nPART: Show widgets\nA page.\n\nPART: Let users edit widgets\nA form.\n' > "$FAKE/plan"
  a=$(new "build the whole widget feature" -p feature)
  t run $a
  eq "$(step $a)" done
  eq "$(head -1 "$(dir $a)/task.md")" "# Add the widget table"   # it became part 1...
  grep -q '^The table only' "$(dir $a)/task.md"
  grep -q 'Part 1 of 3 of "build the whole widget feature"' "$(dir $a)/task.md"   # ...of the whole
  eq "$(cat "$(dir 0002)/after")" "$a"
  eq "$(cat "$(dir 0003)/after")" 0002
  eq "$(head -1 "$(dir 0003)/task.md")" "# Let users edit widgets"
  grep -q '^A form' "$(dir 0003)/task.md"
  t run 2
  t run 3
  eq "$(step 0003)" done
  eq "$(grep -c '^Decide how many pull requests' "$FAKE/read.prompts")" 1   # the parts came planned
  grep -q "^pr create --head t/0002-show-widgets --base $(cat "$(dir $a)/branch") " "$FAKE/gh.calls"
  grep -q '^pr create --head t/0003-let-users-edit-widgets --base t/0002-show-widgets ' "$FAKE/gh.calls"
  eq "$(git -C "$(t path 3)" rev-list --count main..t/0003-let-users-edit-widgets)" 3   # one commit per part
}

test_opencode_codes_by_default_and_claude_on_request() {
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  grep -q '^session: opencode ses_' "$(dir $id)/log/10-implement.log"
  grep -q -- '--agent plan' "$FAKE/opencode.calls"        # the reviewer only reads
  [ ! -e "$FAKE/claude.calls" ]
  id=$(new "add the gadget" --cli claude)
  t run $id
  eq "$(step $id)" done
  grep -q '^session: claude ' "$(dir $id)/log/10-implement.log"
  grep -q -- '--tools Read,Grep,Glob' "$FAKE/claude.calls" # its reviewer only reads too
}

test_each_step_runs_on_the_cli_its_pipeline_names() {
  echo MODEL_implement=vllm/test-model >> "$tmp/tick/pipelines/feature/env"
  id=$(new "add the widget" -p feature)                   # feature: plan, implement and review on opencode
  t run $id
  eq "$(step $id)" done
  eq "$(grep -c . "$FAKE/opencode.calls")" 3
  grep -q -- '-m vllm/test-model' "$FAKE/opencode.calls"  # the step's model went with it
  [ ! -e "$FAKE/claude.calls" ]
  t show $id | grep -q 'implement (opencode)'
  id=$(new "add the gadget" -p feature --cli claude)      # --cli beats the pipeline
  t run $id
  eq "$(grep -c . "$FAKE/claude.calls")" 3
  not grep -q -- 'test-model' "$FAKE/claude.calls"        # opencode's model isn't claude's
}

test_a_worktree_has_a_name_of_its_own_and_teardown_follows_tests() {
  printf 'TEST_CMD="pwd > %s/pwd"\nTEARDOWN="echo down >> %s/teardowns"\n' "$tmp" "$tmp" >> "$tmp/tick/pipelines/local/env"
  id=$(new "add the widget")
  t run $id
  eq "$(basename "$(cat "$tmp/pwd")")" "repo-$id"         # what the test command sees as its directory
  eq "$(grep -c down "$tmp/teardowns")" 1                 # after the tests
  t rm $id 2> /dev/null
  eq "$(grep -c down "$tmp/teardowns")" 2                 # and before its worktree went
}

test_a_task_started_from_the_board_keeps_the_board_out_of_its_steps() {
  printf 'TEST_CMD="env > %s/env"\n' "$tmp" >> "$tmp/tick/pipelines/local/env"
  id=$(new "add the widget")
  T_UI=$tmp/board T_NEW=$tmp/board t run $id               # as t ui starts it
  grep -q "^TASK_ID=$id$" "$tmp/env"
  not grep -qE '^T_(UI|NEW)=' "$tmp/env"                  # plan's t new would write into the board
}

test_say_sends_a_done_task_back_with_your_notes() {
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  t say $id "also handle the empty case" 2> /dev/null
  eq "$(step $id)" 10-implement
  t run $id
  eq "$(step $id)" done
  grep -q 'also handle the empty case' "$FAKE/edit.prompts"
}

test_rm_f_stops_the_run_and_its_agent_first() {
  a=$(new "parent work")
  b=$(new "child work" --on $a)
  ( exec 9> "$(dir $a)/lock"; flock 9; sleep 30 ) &
  pid=$!
  sleep 0.5
  t rm -f $b 2> /dev/null                                  # it only waits on the run, so the run goes on
  kill -0 $pid
  not t rm $a 2> "$tmp/err"
  grep -q "t rm -f $((10#$a))" "$tmp/err"
  t rm -f $a 2> /dev/null
  [ ! -d "$(dir $a)" ]
  not wait $pid                                            # killed, not finished
}

test_hold_f_cancels_the_running_agent_and_holds_the_task() {
  id=$(new "add the widget")
  FAKE_SLEEP=30 t run $id > /dev/null 2>&1 &
  pid=$!
  for i in $(seq 50); do [ ! -s "$FAKE/opencode.calls" ] || break; sleep 0.1; done   # the agent is working
  t keys $id | grep -q 'alt-c cancel'                      # what the board offers for it
  t hold -f $id cancelled 2> /dev/null
  not wait $pid                                            # killed, not finished
  flock -n "$(dir $id)/lock" true                          # nothing of the run is left, the agent included
  t ls | grep -q 'HELD cancelled$'
  t log $id | grep -q '10-implement cancelled'
  t resume $id 2> /dev/null
  t run $id
  eq "$(step $id)" done
}

test_drivers_log_paths_from_where_the_agent_works() {
  mkdir "$tmp/w" && cd "$tmp/w"
  jq -nc --arg p "$tmp/w/src/app.ts" '{type: "assistant", message: {content: [{type: "tool_use", name: "Read", input: {file_path: $p}}]}}' > "$tmp/c.jsonl"
  echo hi | FAKE_REPLAY=$tmp/c.jsonl "$root/drivers/claude" > /dev/null 2> "$tmp/err" || true
  grep -qx '  · Read src/app.ts' "$tmp/err"
  jq -nc --arg p "$HOME/notes/todo.md" '{type: "tool_use", sessionID: "ses_x", part: {tool: "read", state: {title: "", input: {filePath: $p}}}}' > "$tmp/o.jsonl"
  echo hi | FAKE_REPLAY=$tmp/o.jsonl "$root/drivers/opencode" > /dev/null 2> "$tmp/err"
  grep -qx '  · read ~/notes/todo.md' "$tmp/err"          # outside it, $HOME is ~
}

test_rm_removes_the_worktree_and_keeps_the_branch() {
  id=$(new "add the widget")
  t run $id
  w=$(t path $id)
  t rm $id 2> /dev/null
  [ ! -e "$w" ]
  [ ! -e "$(dir $id)" ]
  git rev-parse -q --verify "refs/heads/t/$id-add-the-widget" > /dev/null
}

test_main_codes_in_a_worktree_and_lands_on_the_local_main() {
  git commit -q --allow-empty -m "not pushed yet"
  id=$(new "fix the widget" -p main)
  t run $id
  eq "$(step $id)" done
  [ "$(t path $id)" != "$(realpath "$tmp/repo")" ]
  eq "$(git branch --show-current)" main
  eq "$(git log -2 --format=%s | paste -sd,)" "fix the widget,not pushed yet"   # built on it, fast-forwarded
  eq "$(cat impl.txt)" change                              # the checkout moved along
}

test_main_waits_while_your_uncommitted_work_is_in_the_way() {
  echo mine > notes.txt
  echo mine > impl.txt                                     # the task writes impl.txt too
  id=$(new "fix the widget" -p main)
  t run $id
  eq "$(step $id)" 40-merge
  eq "$(cat "$(dir $id)/runs/40-merge")" 0                 # waiting isn't a run
  eq "$(cat impl.txt)" mine
  rm impl.txt
  t run $id
  eq "$(step $id)" done
  eq "$(cat impl.txt)" change
  eq "$(cat notes.txt)" mine                               # the rest of your work stays
}

test_main_resolves_conflicts_with_a_moved_main_and_tests_again() {
  export SLOTS_opencode=1
  id=$(new "fix the widget" -p main)
  mkdir -p "$T_VAR/run"
  exec 8> "$T_VAR/run/opencode.1"; flock 8
  t run $id                                                # makes the worktree, then waits for a slot
  exec 8>&-
  echo theirs > impl.txt && git add impl.txt && git commit -q -m "meanwhile on main"
  echo noop > "$FAKE/merges"
  t run $id
  eq "$(step $id)" 40-merge
  grep -q 'left conflict markers' "$(dir $id)/log/40-merge.log"
  t run $id
  eq "$(step $id)" done
  grep -q '40-merge ok → 20-test' "$(dir $id)/history"
  eq "$(sort impl.txt | paste -sd,)" "change,theirs"       # both sides, no markers
  eq "$(git rev-parse HEAD)" "$(git rev-parse "t/$id-fix-the-widget")"
}

test_a_task_stacked_on_a_main_task_lands_on_main_too() {
  a=$(new "parent work" -p main)
  b=$(new "child work" --on $a)
  t run $a
  t run $b
  eq "$(step $b)" done
  eq "$(git log -2 --format=%s | paste -sd,)" "child work,parent work"
}

test_main_works_in_its_own_repo_from_anywhere() {
  git init -q "$tmp/other"
  git -C "$tmp/other" commit -q --allow-empty -m init
  cd "$tmp/other"
  id=$(new "fix the widget" -p main)                      # standing in another repo doesn't count
  eq "$(cat "$(dir $id)/repo")" "$(realpath "$tmp/repo")"
  cd /
  id=$(new "fix the gadget" -p main)
  eq "$(cat "$(dir $id)/repo")" "$(realpath "$tmp/repo")"
  id=$(new "fix the gizmo" -p main -r "$tmp/repo")
  not new "fix the doohickey" -p main -r "$tmp/other"
}

test_a_repo_by_name_brings_its_pipeline_and_its_tests() {
  profile
  cd /
  id=$(new "add the widget" -r toy)
  eq "$(cat "$(dir $id)/repo")" "$(realpath "$tmp/repo")"
  eq "$(cat "$(dir $id)/pipeline")" feature               # the repo's own pipeline
  id=$(new "try the widget" -r toy -p local)              # another pipeline for once...
  t run $id
  eq "$(step $id)" done
  [ -e "$tmp/tested" ]                                    # ...still with the repo's test command
  cd "$tmp/repo"
  id=$(new "one more widget")
  eq "$(cat "$(dir $id)/pipeline")" feature               # standing in the repo counts the same
}

test_a_repo_can_be_a_directory_name_or_the_default() {
  cd /
  not new "no repo anywhere"
  export T_REPOS=$tmp
  id=$(new "add the widget" -r repo)                      # a directory in $T_REPOS
  eq "$(cat "$(dir $id)/repo")" "$(realpath "$tmp/repo")"
  export T_REPO=$tmp/repo
  id=$(new "add the gadget")                              # outside any repo: T_REPO
  eq "$(cat "$(dir $id)/pipeline")" local
}

test_completion_offers_what_you_can_type() {
  profile
  export T_REPOS=$tmp
  t complete commands | grep -q '^new:create a task'
  t complete pipelines | grep -q '^feature:plan (opencode) → implement (opencode) → test'
  t complete repos | grep -q '^toy:.*(pipeline feature)'
  t complete repos | grep -q "^repo:$tmp/repo"
  t complete clis | grep -qx opencode
  id=$(new "add the widget")
  t complete tasks | grep -q '^1:add the widget  (05-plan, ready)'
  t complete steps widget | grep -qx review
  zsh -n "$tmp/tick/completions/t.zsh"
}

test_a_task_can_be_named_by_a_word_from_its_title() {
  a=$(new "add the widget")
  b=$(new "fix the gadget")
  eq "$(t path gadget)" "$T_VAR/tasks/$b/work"
  not t path the 2> "$tmp/err"                            # two match, and no terminal to ask in
  grep -q 'which task' "$tmp/err"
  grep -q '^  1  add the widget' "$tmp/err"
  grep -q '^  2  fix the gadget' "$tmp/err"
}

test_leaving_out_the_task_gives_a_menu() {
  a=$(new "add the widget")
  b=$(new "fix the gadget")
  out=$(printf '2\n' | T_PICKER=select tty "t path")
  grep -q "1) 1 " <<< "$out"
  grep -q "$T_VAR/tasks/$b/work" <<< "$out"
}

test_a_long_title_gets_a_short_name_for_the_board() {
  echo "Fix the checkout" > "$FAKE/names"
  a=$(new "the checkout page crashes when the cart holds more than ninety nine items")
  b=$(new "add the widget")                               # short enough already: no agent
  eq "$(grep -c . "$FAKE/opencode.calls")" 1
  grep -q 'ninety nine items' "$FAKE/read.prompts"
  out=$(t ls)
  grep -q '^1 .* Fix the checkout  ' <<< "$out"
  grep -q '^2 .* add the widget  ' <<< "$out"
  eq "$(t path ninety)" "$T_VAR/tasks/$a/work"            # a word from the title still finds it
  t show $a | grep -q 'ninety nine items'                 # show keeps the whole title
  t name $a "Cart overflow"
  t ls | grep -q '^1 .* Cart overflow  '
}

test_a_long_title_is_cut_to_fit_the_terminal() {
  echo "fit the board to a narrow terminal, however long" > "$FAKE/names"
  new "add the widget" > /dev/null
  new "make the board fit a narrow terminal, however long the title" > /dev/null
  out=$(tty "stty cols 40; t ls" | tr -d '\r')
  grep -q '^2 .*…$' <<< "$out"
  [ "$(wc -L <<< "$out")" -le 40 ]
  out=$(printf '1\n' | T_PICKER=select tty "stty cols 40; t path" | tr -d '\r')
  grep -q '^2) .*…$' <<< "$out"
  [ "$(grep '^[12]) ' <<< "$out" | wc -L)" -le 40 ]
  t ls | grep -q ' fit the board to a narrow t… '          # piped too, the title column has a width
  t show 2 | grep -q 'however long'                         # show keeps it whole
}

test_new_without_a_title_opens_the_editor() {
  cat > "$tmp/ed" << 'EOF'
#!/bin/sh
printf 'add the widget\n\n## Context\nuse tabs\n' > "$1"
EOF
  chmod +x "$tmp/ed"
  EDITOR=$tmp/ed T_PICKER=select tty "t new" > /dev/null < /dev/null   # without fzf; with it, t compose
  eq "$(head -1 "$(dir 0001)/task.md")" "# add the widget"
  grep -q '^## Context' "$(dir 0001)/task.md"            # markdown headings survive
  cat > "$tmp/ed" << 'EOF'
#!/bin/sh
grep -q '^fix the gadget$' "$1" && grep -q '^# tick: repo · local · branches from origin/main$' "$1" &&
  printf 'fix the gadget\n\nuse spaces\n' > "$1"
EOF
  EDITOR=$tmp/ed tty "t new --edit 'fix the gadget'" > /dev/null < /dev/null   # compose's ^E: title and choices there
  grep -q '^use spaces' "$(dir 0002)/task.md"
}

test_new_dry_shows_the_task_it_would_make() {
  out=$(t new --dry "add the widget")
  grep -q '^repo *repo   (this directory)$' <<< "$out"
  grep -q '^pipeline *local$' <<< "$out"
  grep -q '^branch *t/0001-add-the-widget$' <<< "$out"
  grep -q '^base *origin/main$' <<< "$out"
  grep -q '^cli *opencode  (CLI_implement)$' <<< "$out"
  grep -q '^starts *only when you run it' <<< "$out"      # no cron tick here
  grep -q '^t new \\$' <<< "$out"
  [ ! -e "$T_VAR/tasks/0001" ]                            # it made nothing
  out=$(t new --dry -p research "what changed in bash 5.3?")
  grep -q '^repo *none needed$' <<< "$out"
  grep -q '^cli *claude  (CLI_answer)$' <<< "$out"
  grep -q '^t research \\$' <<< "$out"
  echo "* * * * * $tmp/tick/bin/t tick" > "$FAKE/crontab"
  t new --dry "$(printf 'x%.0s' {1..41})" > "$tmp/out"
  grep -q '^starts *next tick' "$tmp/out"
  grep -q 'an agent will pick a short one' "$tmp/out"
  new "add the widget" > /dev/null
  new "child work" --on 0001 > /dev/null
  t new --dry --on 1 "more child work" > "$tmp/out"            # compose's preview for a stack
  grep -q '^starts *when task 1 is done' "$tmp/out"
  grep -q "^shares *task 1's worktree and lock" "$tmp/out"
  grep -q 'task 2 is already stacked here' "$tmp/out"
}

test_a_stray_file_among_the_tasks_does_not_stop_new_ones() {
  mkdir -p "$T_VAR/tasks" && : > "$T_VAR/tasks/lock"
  t new --dry "add the widget" | grep -q '^branch *t/0001-add-the-widget$'
  eq "$(new "add the widget")" 0001
}

test_details_come_from_stdin_only_with_a_dash() {
  t new "add the widget" 2> /dev/null < /dev/zero > /dev/null   # an open stdin must not hang it
  printf 'use tabs\n' | t new "fix the gadget" - > /dev/null 2>&1
  eq "$(cat "$(dir 0001)/task.md")" "# add the widget"
  grep -q '^use tabs' "$(dir 0002)/task.md"
}

test_ask_answers_about_the_repo_and_changes_nothing() {
  id=$(new -p ask "how do the tests run?")
  t run $id
  eq "$(step $id)" done
  [ -s "$(dir $id)/answer.md" ]
  [ ! -e "$(dir $id)/work" ]                              # no worktree
  eq "$(git status --porcelain)" ""                       # the repo is untouched
  grep -q -- '--agent plan' "$FAKE/opencode.calls"        # opencode's read-only agent
}

test_show_puts_the_answer_last_and_pages_in_a_terminal() {
  id=$(new -p ask "how do the tests run?")
  t run $id
  out=$(t show $id)
  grep -A99 'next:' <<< "$out" | grep -q 'answer:'
  [[ $out == *$'\n'"$(cat "$(dir $id)/answer.md")" ]]      # the answer as written, unindented, at the end
  PAGER="tee $tmp/paged" tty "t show $id" > /dev/null
  grep -q 'next:' "$tmp/paged"
}

test_research_needs_no_repo_and_may_search_the_web() {
  cd /
  id=$(new -p research "what changed in bash 5.3?")
  [ ! -e "$(dir $id)/repo" ]
  t run $id
  eq "$(step $id)" done
  [ -s "$(dir $id)/answer.md" ]
  grep -q 'WebSearch' "$FAKE/claude.calls"                 # the pipeline's MODE_answer=web
}

test_say_on_a_question_asks_a_follow_up() {
  id=$(new -p ask "how do the tests run?")
  t run $id
  t say $id "and how do I run just one?" 2> /dev/null
  eq "$(step $id)" 10-answer
  t run $id
  eq "$(step $id)" done
  grep -q 'Your earlier answer' "$FAKE/read.prompts"
  grep -q 'and how do I run just one?' "$FAKE/read.prompts"
}

test_new_now_runs_the_task_at_once() {
  t new --now -p ask "how do the tests run?" < /dev/null > /dev/null 2>&1
  eq "$(step 0001)" done
}

test_with_cron_a_new_task_starts_without_waiting_for_the_tick() {
  echo "* * * * * $tmp/tick/bin/t tick" > "$FAKE/crontab"
  id=$(FAKE_SLEEP=0.5 new "add the widget")              # the run it starts takes a while...
  [ "$(step $id)" != done ]                               # ...and t new doesn't wait for it (t ui's Enter would)
  wait_done $id
}

test_a_pipeline_name_starts_a_task_in_that_pipeline() {
  t ask --now "how do the tests run?" < /dev/null > /dev/null 2>&1
  eq "$(cat "$(dir 0001)/pipeline")" ask
  eq "$(step 0001)" done
  t ask --help | grep -q 'stacks it'
  t complete commands | grep -q '^research:new task: answer (claude)'
  mkdir "$tmp/tick/pipelines/log"                          # a command wins over a pipeline, and doctor says so
  t log --help | grep -q '^t log'
  not grep -q '^log:new task' <(t complete commands)
  not t doctor > "$tmp/out"
  grep -q 'pipeline log has the name of a command' "$tmp/out"
}

test_show_says_where_a_task_is_and_what_comes_next() {
  id=$(new "add the widget")
  out=$(t show $id)
  grep -q '▶ implement (opencode)  · test  · review (opencode)' <<< "$out"
  grep -q 't run 1 ' <<< "$out"
  t run $id
  out=$(t show widget)
  grep -q '✓ implement (opencode)  ✓ test  ✓ review (opencode)' <<< "$out"
  grep -q 't diff 1 ' <<< "$out"
  t ls -a | grep -q '✓✓✓'
}

test_diff_shows_the_change() {
  id=$(new "add the widget")
  t run $id
  t diff $id | grep -q '^+change'
}

test_log_shows_every_run_in_order_each_followed_by_how_it_ended() {
  printf 'BROKEN\nfixed\n' > "$FAKE/impl"                 # the tests fail once: back to implement, in one second
  id=$(new "add the widget")
  t run $id
  eq "$(t log $id | grep -oE '^=== .* run [0-9]+|ok → [0-9a-z-]+' | sed 's/^=== [^ ]* [^ ]* //' | paste -sd ' ')" \
    "10-implement, run 1 ok → 20-test 20-test, run 1 ok → 10-implement 10-implement, run 2 ok → 20-test 20-test, run 2 ok → 30-review 30-review, run 1 ok → done"
}

test_log_f_follows_the_task_into_the_steps_still_to_come() {
  id=$(new "add the widget")
  timeout 20 t log $id -f > "$tmp/out" 2>&1 &
  t run $id
  for i in $(seq 50); do grep -q '30-review ok → done' "$tmp/out" && break; sleep 0.1; done
  kill $!
  grep -q '(no step has run yet)' "$tmp/out"
  grep -q '20-test, run 1' "$tmp/out"
  grep -q '30-review ok → done' "$tmp/out"
}

test_ui_on_a_task_offers_what_to_do_with_it() {
  id=$(new "add the widget")
  printf '7\nbusy\n' | T_PICKER=select PAGER=cat tty "t ui $id" > /dev/null   # 7) hold, and why
  grep -q busy "$(dir $id)/hold"
  (. "$tmp/tick/lib/tick.sh"; T_COLOR=1 board | grep -qF "${C_RED}HELD")   # the live board shows it in red
  out=$(printf 'use a fixture\n' | T_PICKER=select tty "t ui $id say")   # say names the task and what happens next
  grep -q 'starts over at 10-implement' <<< "$out"
  grep -q 'use a fixture' "$(dir $id)/feedback.md"
  t hold $id busy
  tty "t ui $id hold" > /dev/null                         # its ctrl key again: it goes on
  [ ! -e "$(dir $id)/hold" ]
  not t ui $id nosuch 2> "$tmp/err"
  grep -q 'there are: log say' "$tmp/err"
  T_PICKER=select tty t | grep -q 'add the widget'        # no fzf: plain t prints the board
}

test_the_board_spells_out_the_steps_on_request() {
  new "add the widget" > /dev/null
  t ls | grep -q '^1   ▶··       —  repo'
  T_STEPS=names t ls > "$tmp/out"                         # what ^f does on the live board
  grep -q '^1   ▶ implement  · test  · review   —  repo' "$tmp/out"
  h=$(head -1 "$tmp/out") r=$(sed -n 2p "$tmp/out")
  h=${h%%REPO*} r=${r%%repo*}
  eq "${#h}" "${#r}"                                      # the columns still line up
}

test_the_board_says_what_each_task_is_doing_and_for_how_long() {
  printf 'noop\n' > "$FAKE/impl"
  id=$(new "add the widget")
  t ls | grep -q '^1 .*  —  repo .*next tick$'          # nothing ran yet
  t run $id
  t ls | grep -q '^1 .*<1m  repo .*next tick · implement: the implementer changed nothing$'
  t hold $id "waiting on design"
  t ls | grep -q 'HELD waiting on design$'
  t keys $id | grep -q '⏎ say  ^l log  alt-a attach  alt-h resume  ? more$'   # keys only: the pane says the rest
}

test_the_board_keeps_the_end_of_a_long_path() {
  id=$(new "add the widget")
  mkdir -p "$(dir $id)/log"
  printf '=== 2026-09-11 10:00:00 10-implement, run 1\n  · Read frontend/lib/wearables/workers/notify.ts\n' > "$(dir $id)/log/10-implement.log"
  t ls | grep -q 'implement: Read …/workers/notify.ts$'
}

test_the_log_folds_a_run_of_one_tool_and_raw_shows_it_all() {
  id=$(new "add the widget")
  mkdir -p "$(dir $id)/log"
  { echo "=== 2026-09-11 10:00:00 10-implement, run 1"; echo "session: claude abc /x"
    for f in lib/health-sync.ts lib/health-notify.ts hooks/useHealth.ts lib/health-sync.ts; do echo "  · Read $f"; done
    echo "Read them."
    for i in 1 2 3 4 5 6 7; do echo "  · Grep p$i"; done
  } > "$(dir $id)/log/10-implement.log"
  t log $id > "$tmp/out"
  grep -qxF '· Read  ×4  lib/health-*, hooks/useHealth.ts' "$tmp/out"
  grep -qxF '▌ Read them.' "$tmp/out"                    # the agent's own words
  grep -qxF '· Grep  ×7  p1, p2, p3, p4, p5, p6, …' "$tmp/out"
  not grep -q 'session:' "$tmp/out"
  t log $id --raw > "$tmp/raw"
  eq "$(grep -c '· Read' "$tmp/raw")" 4
  grep -q '^session: claude abc' "$tmp/raw"              # the id t attach resumes
  ( exec 9> "$(dir $id)/lock"; flock 9; sleep 30 ) &     # while it runs, its last three calls stay lines
  sleep 0.3
  t log $id | tail -4 > "$tmp/live"
  eq "$(head -1 "$tmp/live")" '· Grep  ×4  p1, p2, p3, p4'
  eq "$(tail -1 "$tmp/live")" '· Grep  p7'
  kill $!
}

test_the_pane_shows_details_log_or_diff() {
  id=$(new "add the widget")
  t run $id
  t peek $id | grep -q '✓ implement'                     # done: its details,
  not grep -q 'next:' <(t peek $id)                       # without the keys the header has
  timeout 0.5 t peek $id log | grep -q '30-review ok → done'
  t peek $id diff | sed 's/\x1b\[[0-9;]*m//g' | grep -q '^+change'   # in color
  t peek $id steps | grep -q '^✓ 30-review'
  timeout 0.5 t peek $id raw | grep -q '^session: opencode'
  t keys $id | grep -q '⏎ diff  alt-t stack'
}

test_steps_says_how_each_step_went_and_which_file_each_setting_comes_from() {
  profile                                                 # toy has a TEST_CMD of its own
  printf 'BROKEN\nfixed\n' > "$FAKE/impl"                 # the tests fail once: back to implement
  id=$(new -r toy -p local --test "make test" "add the widget")
  t peek $id steps | grep -q '^▶ 10-implement  —  '       # nothing ran yet
  t peek $id steps | grep -q '^implement — '              # what the step it is on does
  t run $id
  out=$(t peek $id steps)
  grep -qE '^✓ 10-implement  2 runs   ok → test +→ steps/implement · [0-9]+ pipelines$' <<< "$out"
  grep -qE '^✓ 20-test +2 runs   ok → review ' <<< "$out"
  grep -qE '^✓ 30-review +1 run    ok → done ' <<< "$out"
  grep -qE '^  CLI_implement +opencode  pipelines/local$' <<< "$out"
  grep -qE '^  TEST_CMD +make test  task$' <<< "$out"      # the task's own beats the repo's
  grep -qE "^  REPO +$tmp/repo  repos/toy$" <<< "$out"
}

test_compose_takes_flags_typed_with_the_title() {
  mkdir "$tmp/new"; : > "$tmp/new/args"; : > "$tmp/new/repo"
  out=$(T_NEW=$tmp/new t compose --dry local "what changed in bash? -p research")
  grep -q '^pipeline *research$' <<< "$out"
  grep -q '"what changed in bash?"' <<< "$out"
}

test_the_board_starts_a_task_and_says_to_one_in_place() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{steps,pane,pick,def,args,repo,cli}
  t ui --key alt-n + '' | grep -q 'change-prompt(new> )+disable-search'
  eq "$(cat "$T_UI/pick")" local
  t ui --key tab + '' > /dev/null                         # tab: the next pipeline
  eq "$(cat "$T_UI/pick")" feature
  t ui --pane + 'add the widget' | sed 's/\x1b\[[0-9;]*m//g' | grep -q '^pipeline *feature'   # in color
  t ui --key alt-a + '' > /dev/null                       # alt-a: another agent than the pipeline's
  t ui --pane + 'add the widget' | sed 's/\x1b\[[0-9;]*m//g' | grep -q '^cli *claude  (--cli)'
  t ui --key enter + 'add the widget' | grep -q 'reload-sync'   # made; the reload's end puts the cursor on it
  eq "$(cat "$T_UI/new")" 1
  eq "$(cat "$(dir 0001)/pipeline")" feature
  grep -q '^AGENT_CLI=claude$' "$(dir 0001)/env"
  t hold 1 waiting
  t ui --key enter 1 '' | grep -q 'change-prompt(say to 1> )'   # Enter on a held task: say to it
  t ui --key enter 1 'use a fixture' > /dev/null
  grep -q 'use a fixture' "$(dir 0001)/feedback.md"
  [ ! -e "$(dir 0001)/hold" ]
  eq "$(cat "$T_UI/mode")" board
}

test_ui_new_form_preview_is_spaced_from_header() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{steps,pane,pick,def,args,repo,cli}
  t ui --key alt-n + '' > /dev/null                          # enter the new form
  t ui --pane + 'add the widget' | sed 's/\x1b\[[0-9;]*m//g' | grep -A1 '^─' | grep -q '^$'
}

test_the_board_holds_renames_and_deletes_in_place() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{steps,pane,pick,def,args,repo,cli}
  new "add the widget" > /dev/null
  new "fix the gadget" > /dev/null
  t ui --key alt-h 1 '' | grep -q 'change-prompt(hold 1 because> )'
  t ui --key enter 1 'waiting on design' > /dev/null
  grep -q 'waiting on design' "$(dir 0001)/hold"
  t ui --key alt-h 1 '' > /dev/null                     # held: alt-h resumes it at once
  [ ! -e "$(dir 0001)/hold" ]
  t ui --key alt-e 1 '' | grep -q 'change-query~add the widget~'
  t ui --key enter 1 'Widget' > /dev/null
  eq "$(cat "$(dir 0001)/name")" Widget
  t ui --key alt-x 1 '' > /dev/null
  t ui --pane 1 '' | grep -q 'Deletes its directory'   # the pane says what goes before Enter does it
  [ -d "$(dir 0001)" ]
  t ui --key enter 1 '' > /dev/null
  [ ! -e "$(dir 0001)" ]
  eq "$(cat "$T_UI/new")" 2                              # the cursor goes to the next task
  t ui --key ctrl-l 2 '' > /dev/null
  t ui --key ctrl-l 2 '' > /dev/null
  eq "$(cat "$T_UI/pane")" raw                           # ^l again: the log as it is
  t ui --key '?' 2 '' > /dev/null
  t ui --pane 2 '' | grep -q 'delete it and its worktree'
  eq "$(cat "$T_UI/mode")" "help 2"
  t ui --key '?' 2 '' > /dev/null                        # ? again: back
  eq "$(cat "$T_UI/mode")" board
}

test_doctor_says_what_to_fix() {
  not t doctor > "$tmp/out"
  grep -q 'no cron line' "$tmp/out"
  grep -q '\* local ' "$tmp/out"
  echo "* * * * * $tmp/tick/bin/t tick" > "$FAKE/crontab"
  t doctor > "$tmp/out"
  grep -q 'all good' "$tmp/out"
}

test_the_front_digest_puts_comments_that_mention_you_first() {
  front
  now=$(date +%s)
  page "[{\"id\": \"cnv_mail\", \"subject\": \"Invoice question\", \"status\": \"open\", \"updated_at\": $now}]" > "$FAKE/front/conversations_search_recipient"
  page "[{\"id\": \"cnv_tag\", \"subject\": \"Launch plan\", \"status\": \"open\", \"updated_at\": $((now - 60))}]" > "$FAKE/front/conversations_search_mention"
  page "[{\"type\": \"email\", \"created_at\": $now, \"text\": \"Can you resend the invoice?\", \"recipients\": [{\"role\": \"from\", \"handle\": \"bob@shop.example\"}]},
         {\"type\": \"email\", \"created_at\": 1, \"text\": \"old news\", \"recipients\": []}]" > "$FAKE/front/conversations_cnv_mail_messages"
  page "[{\"id\": \"com_1\", \"posted_at\": $now, \"author\": {\"id\": \"tea_kari\", \"first_name\": \"Kari\", \"last_name\": \"N\"}, \"body\": \"@me can you sign off?\"}]" > "$FAKE/front/conversations_cnv_tag_comments"
  page '[{"id": "tea_me"}]' > "$FAKE/front/comments_com_1_mentions"
  "$tmp/tick/jobs/front-digest" > "$tmp/digest"
  [ -s "$tmp/digest" ]
  p=$FAKE/read.prompts
  grep -q 'comment by Kari N, .* — MENTIONS YOU' "$p"
  [ "$(grep -n 'Launch plan' "$p" | cut -d: -f1)" -lt "$(grep -n 'Invoice question' "$p" | cut -d: -f1)" ]
  grep -q 'email from bob@shop.example' "$p"
  not grep -q 'old news' "$p"
}

test_the_front_digest_calls_no_agent_when_nothing_is_new() {
  front
  out=$("$tmp/tick/jobs/front-digest")
  grep -q '^Nothing new in Front since' <<< "$out"
  [ ! -e "$FAKE/claude.calls" ]
}

test_the_front_digest_fails_with_the_fix_when_front_refuses() {
  export XDG_CONFIG_HOME=$tmp/config
  not "$tmp/tick/jobs/front-digest" 2> "$tmp/err"
  grep -q 'FRONT_TOKEN=' "$tmp/err"
  front
  touch "$FAKE/front/401"
  not "$tmp/tick/jobs/front-digest" > "$tmp/out" 2> "$tmp/err"
  grep -q 'check FRONT_TOKEN' "$tmp/err"
  [ ! -s "$tmp/out" ]
  [ ! -e "$FAKE/claude.calls" ]
}

test_drivers_read_real_cli_output() {
  fx=$root/test/fixtures
  out=$(echo hi | FAKE_REPLAY=$fx/claude-read.jsonl "$root/drivers/claude" 2> "$tmp/err")
  eq "$out" "$(jq -r 'select(.type == "result") | .result' "$fx/claude-read.jsonl")"
  grep -q '· Read /etc/hostname' "$tmp/err"
  grep -q '^session: claude ' "$tmp/err"
  echo hi | FAKE_REPLAY=$fx/claude-denied.jsonl AGENT_MODE=edit "$root/drivers/claude" > /dev/null 2> "$tmp/err"
  grep -q '! denied: Write' "$tmp/err"
  out=$(echo hi | FAKE_REPLAY=$fx/opencode-edit.jsonl AGENT_MODE=edit "$root/drivers/opencode" 2> "$tmp/err")
  [ -n "$out" ]
  grep -q '^session: opencode ses_' "$tmp/err"
  grep -q '· write' "$tmp/err"
  printf '%s\n' '{"type":"tool_use","sessionID":"ses_x","part":{"tool":"glob","state":{"input":{"pattern":"**/*.sh"},"title":""}}}' > "$tmp/untitled.jsonl"
  echo hi | FAKE_REPLAY=$tmp/untitled.jsonl "$root/drivers/opencode" > /dev/null 2> "$tmp/err"
  grep -q '· glob \*\*/\*.sh' "$tmp/err"                  # no title: what it looked for
  not bash -c "echo hi | FAKE_REPLAY=$fx/opencode-error.jsonl '$root/drivers/opencode' > /dev/null 2>&1"
}

names=$(declare -F | awk '{ print $3 }' | grep '^test_' | grep -- "${1:-.}")
logs=$(mktemp -d)
for name in $names; do
  while [ "$(jobs -rp | wc -l)" -ge "$(nproc)" ]; do wait -n; done
  ( ( set -e; setup; "$name" ) > "$logs/$name" 2>&1; echo $? > "$logs/$name.exit" ) &
done
wait

pass=0 failed=()
for name in $names; do
  if [ "$(cat "$logs/$name.exit")" -eq 0 ]; then
    pass=$((pass + 1)); echo "ok    $name"
  else
    failed+=("$name"); echo "FAIL  $name"; tail -40 "$logs/$name" | sed 's/^/      /'
  fi
done
rm -rf "$logs"
echo
echo "$pass passed, ${#failed[@]} failed"
[ ${#failed[@]} -eq 0 ]
