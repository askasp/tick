  [ ! -e "$FAKE/claude.calls" ]
}

test_the_front_digest_fails_with_the_fix_when_front_refuses() {
  export XDG_CONFIG_HOME=$tmp/config
  not "$tmp/tick/jobs/front-digest" 2> "$tmp/err"
  grep -q 'FRONT_TOKEN=' "$tmp/err"
  front
  touch "$FAKE/front/401"
  not "$tmp/tick/jobs/front-digest" > "$tmp/out" 2> "$tmp/err"
  grep -q 'check FRONT_TOKEN' "$tmp/err"
  [ ! -s "$tmp/out" ]
  [ ! -e "$FAKE/claude.calls" ]
}

test_slack_posts_a_task_once_and_edits_that_message_after_that() {
  slack
  id=$(new -r toy "add the widget")
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.postMessage)" 2                 # the board, and the task
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.postMessage)" 2                 # nothing changed: nothing said
  eq "$(calls chat.update)" 0
  t hold $id "waiting for you"
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.postMessage)" 3                 # the two, and the mention no edit of them can be
  eq "$(calls chat.update)" 2                      # the same two messages, edited where they are
  grep -A2 '^chat.update' "$FAKE/slack.calls" | grep -q "ts=$(cat "$(dir $id)/slack_ts")"
  grep -q 'held  waiting for you' "$FAKE/slack.calls"
  grep -q '1 needs you' "$FAKE/slack.calls"
  not grep -q "$(cat "$(dir $id)/branch")" "$FAKE/slack.calls"   # a branch is a terminal's business
}

test_slack_gets_the_answer_to_a_question_and_not_only_that_there_is_one() {
  slack
  id=$(new -r toy -p ask "where is the cart total rounded?")
  "$tmp/tick/jobs/slack-out"
  t run $id
  eq "$(step $id)" done
  "$tmp/tick/jobs/slack-out"
  grep -q "$(head -c 30 "$(dir $id)/answer.md")" "$FAKE/slack.calls"
  grep -q '<@U0AKSEL>' "$FAKE/slack.calls"          # you asked, so you are told
  grep -q ' answered$' "$FAKE/slack.calls"          # and the board keeps the row: a phone is where you read how it went
  answers=$(calls chat.postMessage)
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.postMessage)" "$answers"         # said once, not on every tick
}

test_saying_status_moves_the_board_down_to_where_you_are() {
  slack
  new -r toy "add the widget" > /dev/null
  "$tmp/tick/jobs/slack-out"
  board=$(cat "$T_VAR/slack/board.C0TOY.ts")
  said '[{"ts": "10.0", "user": "U0AKSEL", "text": "status"}]' history
  "$tmp/tick/jobs/slack-in"
  eq "$(ls "$T_VAR/tasks" | wc -l)" 1              # the word is the board, not a task about the board
  "$tmp/tick/jobs/slack-out"
  grep -A2 '^chat.delete' "$FAKE/slack.calls" | grep -q "ts=$board"
  not eq "$(cat "$T_VAR/slack/board.C0TOY.ts")" "$board"     # one board, posted afresh at the bottom
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.delete)" 1                      # and it stays there until you ask again
}

test_slack_takes_the_card_of_a_task_you_removed() {
  slack
  id=$(new -r toy "add the widget")
  "$tmp/tick/jobs/slack-out"
  ts=$(cat "$(dir $id)/slack_ts")
  t rm $id
  "$tmp/tick/jobs/slack-out"
  grep -A2 '^chat.delete' "$FAKE/slack.calls" | grep -q "ts=$ts"
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.delete)" 1                      # deleted once, and never asked about again
}

test_a_message_in_the_slack_channel_starts_a_task_and_gets_an_eye() {
  slack
  said '[{"ts": "10.0", "user": "U0AKSEL", "text": "add the widget\nit goes next to the cart"}]' history
  "$tmp/tick/jobs/slack-in"
  eq "$(step 0001)" 10-implement
  eq "$(head -1 "$(dir 0001)/task.md")" "# add the widget"     # what you wrote after line 1 is the details
  grep -q 'it goes next to the cart' "$(dir 0001)/task.md"
  eq "$(cat "$(dir 0001)/pipeline")" feature       # the channel's repo decides, as in a terminal
  grep -A3 '^reactions.add' "$FAKE/slack.calls" | grep -q 'name=eyes'
  eq "$(cat "$(dir 0001)/slack_src")" 10.0
  said '[{"ts": "10.0", "user": "U0AKSEL", "text": "add the widget",
          "reactions": [{"name": "eyes", "users": ["U0BOT"]}]}]' history
  "$tmp/tick/jobs/slack-in"
  not test -d "$(dir 0002)"                        # 👀 is the whole memory: it never starts twice
}

test_a_slack_message_that_opens_with_a_pipeline_starts_that_kind_of_task() {
  slack
  said '[{"ts": "10.0", "user": "U0AKSEL", "text": "ask where is the cart total rounded?"}]' history
  "$tmp/tick/jobs/slack-in"
  eq "$(cat "$(dir 0001)/pipeline")" ask
  eq "$(head -1 "$(dir 0001)/task.md")" "# where is the cart total rounded?"
  eq "$(cat "$(dir 0001)/repo")" "$tmp/repo"       # ask reads the channel's repo
  said '[{"ts": "11.0", "user": "U0AKSEL", "text": "research which bun test runner is fastest?"}]' history
  "$tmp/tick/jobs/slack-in"
  eq "$(cat "$(dir 0002)/pipeline")" research
  [ ! -e "$(dir 0002)/repo" ]                      # research says REPO=none, so it gets none
  said '[{"ts": "12.0", "user": "U0AKSEL", "text": "feature +plan add a discount code field"}]' history
  "$tmp/tick/jobs/slack-in"
  eq "$(cat "$(dir 0003)/opt")" plan
  eq "$(head -1 "$(dir 0003)/task.md")" "# add a discount code field"
}

test_a_question_asked_in_a_channel_is_answered_there_though_it_has_no_repo() {
