#!/usr/bin/env bash
# test/run [PATTERN] — every test (or those matching PATTERN), with fake claude/opencode/gh/crontab.
# Never calls a model. Tests run in parallel, each under set -e in its own copy of tick, with its own T_VAR and a
# toy repo that has a bare "origin" and a `make test` that fails while impl.txt ends in BROKEN.
root=$(cd "$(dirname "$0")/.." && pwd)
path=$PATH
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 SHELL=/bin/bash
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
unset T_VAR T_PIPELINE T_REPO T_REPOS MAX_RUNS DIFF_MAX GPU_BUSY IDLE_PASSES IDLE_FIXES SLOTS_claude SLOTS_opencode T_EFFORT CLAUDE_EDIT_MODE AGENT_CLI AGENT_MODEL AGENT_EFFORT T_PICKER
# run by a tick task's test step, the task's settings are exported (TEST_CMD=test/run would be the toy's too),
# and so is t ui's state when the board started the task: its T_UI is gone by now, and t new writes there
unset TASK_ID T_STEP T_UI T_NEW T_UI_CHANGED TEST_CMD TEARDOWN $(cat "$root"/pipelines/*/env "$root"/repos/*/env 2> /dev/null | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | sort -u)

eq()   { [ "$1" = "$2" ] || { echo "expected '$2', got '$1'" >&2; return 1; }; }
not()  { if "$@"; then echo "should have failed: $*" >&2; return 1; fi; }
new()  { t new "$@" < /dev/null 2> /dev/null; }
dir()  { echo "$T_VAR/tasks/$1"; }
step() { cat "$(dir "$1")/step"; }
tty()  { script -qec "$1" /dev/null; }      # run a command line in a pseudo-terminal
keyfor() { (. "$tmp/tick/lib/tick.sh"; key_of "$1"); }   # the board's key for an action: keyfor hold → ctrl-r
wait_done() {
  local i id all
  for i in $(seq 150); do
    all=1
    for id; do [ "$(step "$id")" = done ] || all=; done
    [ -z "$all" ] || return 0
    sleep 0.2
  done
  echo "timed out waiting for $*" >&2; t ls -a >&2
  for id; do tail -n 20 "$(dir "$id")"/history "$(dir "$id")"/log/*.log >&2 2> /dev/null || true; done
  return 1
}

setup() {
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  cp -a "$root" "$tmp/tick"
  rm -rf "$tmp/tick/repos"                 # your own repos stay out of the tests
  echo "REPO=$tmp/repo" >> "$tmp/tick/pipelines/main/env"   # main is tick's; here it is the toy repo's
  export T_VAR=$tmp/var FAKE=$tmp/fake PATH=$tmp/tick/test/fake:$tmp/tick/bin:$path
  mkdir -p "$FAKE"
  git init -q --bare -b main "$tmp/origin.git"
  git init -q -b main "$tmp/repo"
  cd "$tmp/repo"
  printf 'test:\n\t@! tail -1 impl.txt 2>/dev/null | grep -q BROKEN\n' > Makefile
  git add Makefile && git commit -q -m init
  git remote add origin "$tmp/origin.git"
  git push -q -u origin main 2> /dev/null
  git remote set-head origin main
}

profile() {   # a repo named "toy" for the toy repo: feature by default, with a test command of its own
  mkdir -p "$tmp/tick/repos/toy"
  printf 'REPO=%s\nPIPELINE=feature\nTEST_CMD="touch %s/tested && make test"\n' "$tmp/repo" "$tmp" > "$tmp/tick/repos/toy/env"
}

front() {   # a Front account for jobs/front-digest, served by the fake curl: me@example.com is tea_me
  export XDG_CONFIG_HOME=$tmp/config
  mkdir -p "$tmp/config/front" "$FAKE/front"
  printf 'FRONT_TOKEN=secret\nFRONT_EMAIL=me@example.com\n' > "$tmp/config/front/env"
  echo '{"id": "tea_me"}' > "$FAKE/front/teammates_alt:email:me@example.com"
}
page() { jq -nc --argjson r "$1" '{_results: $r, _pagination: {next: null}}'; }

slack() {   # a Slack workspace for jobs/slack-*: the toy repo is #C0TOY, and the past is already seen
  profile
  export XDG_CONFIG_HOME=$tmp/config
  mkdir -p "$tmp/config/slack" "$FAKE/slack" "$T_VAR/slack"
  printf 'SLACK_TOKEN=xoxb-test\nSLACK_CHANNELS="C0TOY=toy"\nSLACK_ME=U0AKSEL\n' > "$tmp/config/slack/env"
  echo 0 > "$T_VAR/slack/since.C0TOY"
}
said() {   # what conversations.history or replies ($2) answers: said '[{"ts": "1.0", "text": "hi"}]' history
  jq -nc --argjson m "$1" '{ok: true, messages: $m}' > "$FAKE/slack/conversations.$2"
}
calls() { grep -c "^$1\$" "$FAKE/slack.calls" 2> /dev/null || true; }

test_scripts_parse() {
  for f in "$root"/bin/* "$root"/steps/* "$root"/drivers/* "$root"/sources/* "$root"/calendars/* "$root"/jobs/* "$root"/test/fake/* "$root"/lib/*; do bash -n "$f"; done
}

test_run_runs_only_the_tests_its_pattern_names() {
  out=$(bash "$tmp/tick/test/run" 'new_dry')
  grep -q 'ok    test_new_dry_shows_the_task_it_would_make' <<< "$out"
  grep -q '1 passed, 0 failed' <<< "$out"
  not bash "$tmp/tick/test/run" 'no_such_test' 2> "$tmp/err"
  grep -q 'no test matches no_such_test' "$tmp/err"
}

test_help_shows_how_to_start_a_task() {
  t help | grep -q 'Start a task'
  t help | grep -q 'feature .*implement (opencode)'
  t help | grep -q 't resume'
  t new --help | grep -q 'stacks it'
  not t nosuch 2> "$tmp/err"
  grep -q 'Start a task' "$tmp/err"
}

test_a_task_runs_to_done_in_its_own_worktree() {
  id=$(new "add the widget")
  eq "$id" 0001
  eq "$(step $id)" 10-implement
  t run $id
  eq "$(step $id)" done
  w=$(t path $id)
  eq "$w" "$(readlink -f "$(dir $id)/work")"
  eq "$(git -C "$w" branch --show-current)" t/0001-add-the-widget
  eq "$(git -C "$w" rev-list --count origin/main..HEAD)" 1
  eq "$(git -C "$w" log -1 --format=%s)" "add the widget"
  grep -q ' 1 30-review ok → done' "$(dir $id)/history"   # history names the task, not the run
}

test_review_feedback_reaches_the_implementer() {
  printf 'changes\napprove\n' > "$FAKE/verdicts"
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  eq "$(cat "$(dir $id)/runs/10-implement")" 2
  grep -q 'Feedback to address' "$FAKE/edit.prompts"
  grep -q 'VERDICT: changes' "$FAKE/edit.prompts"
  ls "$(dir $id)"/log/feedback.*.md > /dev/null          # archived once it was addressed
  [ ! -e "$(dir $id)/feedback.md" ]
}

test_a_diff_too_big_for_the_model_is_named_instead_of_sent() {
  export DIFF_MAX=200
  printf 'x%.0s' {1..400} > "$FAKE/impl"                  # one line, a patch over the budget
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  grep -q 'impl.txt | 1 +' "$FAKE/read.prompts"           # the stat always goes
  grep -q '^- impl.txt$' "$FAKE/read.prompts"             # the patch itself didn't
  not grep -q xxxxxxxx "$FAKE/read.prompts"
}

test_a_diff_the_model_can_read_goes_whole() {
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  grep -q '^+change$' "$FAKE/read.prompts"
  not grep -q 'read these files in the worktree' "$FAKE/read.prompts"
}

test_generated_files_reach_no_agent() {
  echo 'GENERATED="*.txt"' >> "$tmp/tick/pipelines/local/env"
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  grep -q 'Generated in this repo' "$FAKE/edit.prompts"   # the implementer hears it too
  grep -q 'Generated in this repo' "$FAKE/read.prompts"
  not grep -q '^+change$' "$FAKE/read.prompts"            # and the review diff leaves them out
}

test_a_review_reads_the_diff_once_per_mindset() {
  echo 'MINDSETS="intent tests"' >> "$tmp/tick/pipelines/local/env"
  printf 'approve\nchanges\napprove\napprove\n' > "$FAKE/verdicts"
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  eq "$(grep -c 'Look only at whether this change is tested' "$FAKE/read.prompts")" 2   # it asked, so it reads again
  eq "$(grep -c 'does this change do' "$FAKE/read.prompts")" 1   # it approved, so it doesn't
  eq "$(grep -c '^## What you asked for last round$' "$FAKE/read.prompts")" 1   # tests reads its own answer back
  eq "$(cat "$(dir $id)/runs/10-implement")" 2                   # the mindset that said changes sent it back
  grep -q '^## tests$' "$(dir $id)"/log/feedback.*.md            # with only that pass in the feedback
  not grep -q '^## intent$' "$(dir $id)"/log/feedback.*.md
  grep -q '^## intent$' "$(dir $id)/review.md"                   # the PR body keeps every pass
  grep -q '^## tests$' "$(dir $id)/review.md"
  [ ! -e "$(dir $id)/passes" ]                                   # moving on forgets the rounds
}

test_from_the_third_round_only_late_mindsets_send_the_task_back() {
  printf 'MINDSETS="intent tests"\nLATE_MINDSETS=intent\n' >> "$tmp/tick/pipelines/local/env"
  printf 'changes\nchanges\nchanges\nchanges\napprove\n' > "$FAKE/verdicts"   # two rounds of both; then intent
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  eq "$(grep -c 'does this change do' "$FAKE/read.prompts")" 3
  eq "$(grep -c 'Look only at whether this change is tested' "$FAKE/read.prompts")" 2   # round 3 left tests out
}

test_the_board_says_which_mindset_a_running_review_is_on_of_how_many() {
  echo 'MINDSETS="intent tests"' >> "$tmp/tick/pipelines/local/env"
  id=$(new "add the widget")
  t run $id
  echo 30-review > "$(dir $id)/step"                              # as if it were reviewing again
  flock "$(dir $id)/lock" t ls | grep "^ *$((10#$id)) " | grep -q ' review  tests 2/2  '
  echo "=== $(date '+%F %T') 30-review, run 2" >> "$(dir $id)/log/30-review.log"
  flock "$(dir $id)/lock" t ls | grep "^ *$((10#$id)) " | grep -q ' review  starting$'   # a new run hasn't one yet
}

test_an_unknown_mindset_names_the_ones_there_are() {
  echo 'MINDSETS="tests nosuch"' >> "$tmp/tick/pipelines/local/env"
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" 30-review                                     # it never asked a model anything
  eq "$(grep -c . "$FAKE/read.prompts" 2> /dev/null || echo 0)" 0
  grep -q "no mindset 'nosuch'" "$(dir $id)/log/30-review.log"
  grep -q 'craft' "$(dir $id)/log/30-review.log"
  t doctor > "$tmp/out" 2>&1 || true                             # and doctor says so before you run it
  grep -q "asks for the mindset 'nosuch'" "$tmp/out"
}

test_failing_tests_go_back_to_the_implementer() {
  printf 'BROKEN\nfixed\n' > "$FAKE/impl"
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  grep -q 'The tests fail' "$FAKE/edit.prompts"
  grep -q '20-test ok → 10-implement' "$(dir $id)/history"
  t show $id | grep -q '  test       →  implement   looped back$'
}

test_a_review_that_keeps_sending_it_back_holds_the_task_after_MAX_ROUNDS() {
  printf 'changes\nchanges\nchanges\nchanges\nchanges\n' > "$FAKE/verdicts"
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" 10-implement                           # more rounds than MAX_RUNS: a send-back isn't a failed run
  [ -s "$(dir $id)/feedback.md" ]                         # the last round's, waiting for implement
  t ls | grep -q 'held  review sent it back 5 times'
  t run $id
  eq "$(cat "$(dir $id)/runs/30-review")" 5               # held: nothing ran
  t resume $id 2> /dev/null
  t run $id                                               # the next review approves
  eq "$(step $id)" done
}

test_a_step_counts_its_runs_afresh_once_the_task_moved_past_it() {
  export SLOTS_opencode=1
  printf 'BROKEN\nBROKEN\nfixed\n' > "$FAKE/impl"         # test sends it back twice, then passes
  id=$(new "fix the widget" -p main)
  mkdir -p "$T_VAR/run"
  ( exec 8> "$T_VAR/run/opencode.1"; flock 8; sleep 2 ) &
  sleep 0.5
  t run $id                                               # makes the worktree, then waits for a slot
  wait
  echo other > other.txt && git add other.txt && git commit -q -m "meanwhile on main"
  t run $id                                               # merge brings main in: test runs a 4th time
  eq "$(step $id)" done
  eq "$(grep -c '20-test ok' "$(dir $id)/history")" 4
}

test_an_implementer_that_changes_nothing_fails() {
  printf 'noop\nnoop\nnoop\n' > "$FAKE/impl"
  id=$(new "add the widget")
  t run $id; t run $id; t run $id
  eq "$(step $id)" 10-implement
  [ ! -e "$(dir $id)/hold" ]
  grep -q 'changed nothing' "$(dir $id)/log/10-implement.log"
  t run $id
  [ -e "$(dir $id)/hold" ]
}

test_tasks_run_in_parallel_worktrees_off_main() {
  export SLOTS_opencode=2
  a=$(new "task a")
  b=$(new "task b")
  t tick
  wait_done $a $b
  wa=$(t path $a) wb=$(t path $b)
  [ "$wa" != "$wb" ]
  git -C "$wa" merge-base --is-ancestor origin/main HEAD
  git -C "$wb" merge-base --is-ancestor origin/main HEAD
  not git -C "$wb" merge-base --is-ancestor "t/$a-task-a" HEAD
}

test_a_stacked_task_waits_then_builds_on_its_parent() {
  a=$(new "parent work")
  b=$(new "child work" --on $a)
  t run $b
  eq "$(step $b)" 10-implement                            # queued behind $a
  t ls | grep "^ *$((10#$b)) " | grep -q "after $((10#$a))"
  t run $a
  eq "$(step $a)" done
  t run $b
  eq "$(step $b)" done
  [ "$(t path $b)" != "$(t path $a)" ]                    # a worktree of its own, off the parent's branch
  w=$(t path $b)
  eq "$(git -C "$w" branch --show-current)" "t/$b-child-work"
  git -C "$w" merge-base --is-ancestor "t/$a-parent-work" HEAD
  eq "$(git -C "$w" rev-list --count "t/$a-parent-work..HEAD")" 1
  eq "$(cat "$(dir $b)/base")" "t/$a-parent-work"
  t show $b | grep -q "^base      t/$a-parent-work · task $((10#$a))$"   # stacked: whose branch that is
  grep -q "git diff t/$a-parent-work...HEAD" "$FAKE/read.prompts"   # its review saw only its own diff
}

test_a_stacked_task_takes_what_the_task_below_did_after_it_branched() {
  a=$(new "parent work" -p feature)
  b=$(new "child work" --on $a -p feature)
  t run $a
  t run $b
  eq "$(step $b)" done
  echo "later fix" >> "$(t path $a)/impl.txt"             # the task below keeps working after that
  git -C "$(t path $a)" commit -qam "later fix"
  t say $b "and this too" implement
  t run $b
  eq "$(step $b)" done
  grep -q 'later fix' "$(t path $b)/impl.txt"             # sync merged it in before the PR
  grep -q '35-sync ok → 20-test' "$(dir $b)/history"      # and sent it through test and review again
}

test_a_stacked_task_sits_under_its_parent_until_that_is_done() {
  a=$(new "parent work")
  b=$(new "child work" --on $a)
  t ls | grep -A1 "^ *$((10#$a)) " | grep -q "^ *$((10#$b)) .*└ child work .*after $((10#$a))$"
  t show $b | grep -q '^waiting for$'                     # and what its parent is doing
  t run $a
  out=$(t ls)
  grep -q "^ *$((10#$b)) .* child work .*next tick$" <<< "$out"
  not grep -q └ <<< "$out"
}

test_t_stack_starts_a_task_on_another() {
  a=$(new "parent work")
  b=$(t stack $a "child work" < /dev/null 2> /dev/null)
  eq "$(cat "$(dir $b)/after")" "$a"
  t run $a
  eq "$(step $a)" done
  t run $b
  eq "$(step $b)" done
}

test_a_stack_runs_on_a_lock_and_a_worktree_of_its_own() {
  a=$(new "parent work")
  b=$(new "child work" --on $a)
  t run $a
  exec 9> "$(dir $a)/lock"; flock 9                       # the task below is busy: say it, run it again
  t run $b
  eq "$(step $b)" done
  [ "$(readlink -f "$(dir $b)/lock")" != "$(readlink -f "$(dir $a)/lock")" ]
  exec 9>&-
}

test_full_agent_slots_mean_try_again_later() {
  export SLOTS_opencode=1
  mkdir -p "$T_VAR/run"
  exec 8> "$T_VAR/run/opencode.1"; flock 8
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" 10-implement
  eq "$(cat "$(dir $id)/runs/10-implement")" 0            # waiting isn't a run
  grep -q 'slots busy' "$(dir $id)/log/10-implement.log"
  exec 8>&-
  t run $id
  eq "$(step $id)" done
}

test_a_cli_that_fails_hands_the_same_prompt_to_claude() {
  printf 'context length exceeded\n' > "$FAKE/fails"      # opencode can't answer the implementer
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  grep -q 'context length exceeded' "$(dir $id)/log/10-implement.log"
  grep -q 'goes to claude' "$(dir $id)/log/10-implement.log"
  eq "$(grep -c . "$FAKE/claude.calls")" 1                # only the step opencode dropped
  eq "$(grep -c . "$FAKE/opencode.calls")" 2              # implement, then the review it did answer
  eq "$(grep -c 'add the widget' "$FAKE/edit.prompts")" 2 # claude got the prompt opencode had
}

test_a_task_an_agent_starts_stays_off_the_board() {
  id=$(new "add the widget")
  FAKE_RUN='t new "a task of its own" < /dev/null && touch "$FAKE/started"' t run $id
  [ -f "$FAKE/started" ]
  eq "$(ls "$T_VAR/tasks" | grep -c '^[0-9]')" 1
}

test_a_killed_run_is_picked_up_again() {
  id=$(new "add the widget")
  FAKE_SLEEP=5 setsid t run $id > /dev/null 2>&1 &
  sleep 1
  t ls | grep "^ *$((10#$id)) " | grep -q ' implement  '   # running: its step's latest line
  fuser -s -k "$(dir $id)/lock"                           # like a reboot: everything in the run dies
  sleep 0.3
  eq "$(step $id)" 10-implement
  t run $id                                               # the kernel dropped the lock; nothing to clean
  eq "$(step $id)" done
  eq "$(cat "$(dir $id)/runs/10-implement")" 2
}

test_feature_pipeline_opens_a_pr_and_waits_for_ci() {
  printf 'pending\nfail\npass\n' > "$FAKE/checks"
  id=$(new "add the widget" -p feature +ci)
  t run $id
  eq "$(step $id)" 50-ci                                  # checks pending: waiting
  eq "$(cat "$(dir $id)/runs/50-ci")" 0
  eq "$(cat "$(dir $id)/pr")" https://github.com/example/repo/pull/1
  git --git-dir="$tmp/origin.git" rev-parse -q --verify "refs/heads/t/$id-add-the-widget" > /dev/null
  t run $id                                               # fails → implement → … → pushed again → passes
  eq "$(step $id)" done
  grep -q 'FAIL test_widget' "$FAKE/edit.prompts"
  eq "$(grep -c '^pr create' "$FAKE/gh.calls")" 1         # the second push reuses the PR
  eq "$(git --git-dir="$tmp/origin.git" rev-list --count "main..t/$id-add-the-widget")" 2
}

test_a_feature_is_one_pull_request_unless_its_plan_splits_it() {
  echo "Looks small to me." > "$FAKE/plan"
  id=$(new "add the widget" -p feature +plan)
  t run $id
  eq "$(step $id)" 05-plan                                # a plan without a PART line is no plan
  grep -q 'no PART line' "$(dir $id)/log/05-plan.log"
  t run $id                                               # the planner's default: one part
  eq "$(step $id)" done
  grep -q '^Decide how many pull requests' "$FAKE/read.prompts"
  eq "$(cat "$(dir $id)/task.md")" "# add the widget"     # the task as it was asked
  eq "$(ls "$T_VAR/tasks" | wc -l)" 1
  eq "$(grep -c '^pr create' "$FAKE/gh.calls")" 1
}

test_a_plan_in_parts_becomes_a_stack_of_pull_requests() {
  printf 'Three seams.\n\nPART: Add the widget table\nThe table only.\n\nPART: Show widgets\nA page.\n\nPART: Let users edit widgets\nA form.\n' > "$FAKE/plan"
  a=$(new "build the whole widget feature" -p feature +plan)
  t run $a
  eq "$(step $a)" done
  eq "$(head -1 "$(dir $a)/task.md")" "# Add the widget table"   # it became part 1...
  grep -q '^The table only' "$(dir $a)/task.md"
  grep -q 'Part 1 of 3 of "build the whole widget feature"' "$(dir $a)/task.md"   # ...of the whole
  eq "$(cat "$(dir 0002)/after")" "$a"
  eq "$(cat "$(dir 0003)/after")" 0002
  eq "$(head -1 "$(dir 0003)/task.md")" "# Let users edit widgets"
  grep -q '^A form' "$(dir 0003)/task.md"
  t run 2
  t run 3
  eq "$(step 0003)" done
  eq "$(grep -c '^Decide how many pull requests' "$FAKE/read.prompts")" 1   # the parts came planned
  grep -q "^pr create --head t/0002-show-widgets --base $(cat "$(dir $a)/branch") " "$FAKE/gh.calls"
  grep -q '^pr create --head t/0003-let-users-edit-widgets --base t/0002-show-widgets ' "$FAKE/gh.calls"
  eq "$(git -C "$(t path 3)" rev-list --count main..t/0003-let-users-edit-widgets)" 3   # one commit per part
}

test_a_pipelines_optional_step_is_left_out_unless_the_task_asks() {
  id=$(new "add the widget" -p feature)                   # feature plans and waits for CI only when asked
  eq "$(step $id)" 10-implement
  [ ! -e "$(dir $id)/opt" ]
  t ls | grep -qE '^ +1 .* 0/5 +next tick$'               # five steps, not seven
  not grep -qx plan <(t complete steps widget)
  with=$(new "add the gadget" -p feature +plan +ci)
  eq "$(step $with)" 05-plan
  eq "$(cat "$(dir $with)/opt")" "$(printf 'plan\nci')"
  t ls | grep -qE '^ +2 .* 0/7 +next tick$'
  t complete steps gadget | grep -qx plan
  t new --dry -p feature +plan "add the gizmo" > "$tmp/out"
  grep -q '^steps *plan (claude) → implement (opencode) → test → review (opencode) → sync (opencode) → pr$' "$tmp/out"
  grep -q '^t feature +plan \\$' "$tmp/out"             # the command, to type next time
  t new --dry -p feature +ci "add the gizmo" | grep -q '^steps *implement (opencode) → test → review (opencode) → sync (opencode) → pr → ci$'
  not new "fix the thing" -p feature +nosuch
  not new "fix the thing" -p local +plan                  # local has no optional steps at all
}

test_opencode_codes_by_default_and_claude_on_request() {
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  grep -q '^session: opencode ses_' "$(dir $id)/log/10-implement.log"
  grep -q -- '--agent plan' "$FAKE/opencode.calls"        # the reviewer only reads
  [ ! -e "$FAKE/claude.calls" ]
  id=$(new "add the gadget" --cli claude)
  t run $id
  eq "$(step $id)" done
  grep -q '^session: claude ' "$(dir $id)/log/10-implement.log"
  grep -q -- '--tools Read,Grep,Glob' "$FAKE/claude.calls" # its reviewer only reads too
  grep -q -- '--permission-mode acceptEdits --allowedTools Bash' "$FAKE/claude.calls"   # its implementer runs the tests
}

test_agents_may_read_the_task_directories_outside_their_worktree() {
  id=$(new "add the widget")
  t run $id
  jq -e --arg tasks "$T_VAR/tasks/*" '.permission.external_directory[$tasks] == "allow"' "$FAKE/opencode.config" > /dev/null
  id=$(new "add the gadget" --cli claude)
  t run $id
  grep -qF -- "--add-dir $T_VAR/tasks" "$FAKE/claude.calls"
}

test_each_step_runs_on_the_cli_its_pipeline_names() {
  echo MODEL_implement=vllm/test-model >> "$tmp/tick/pipelines/feature/env"
  id=$(new "add the widget" -p feature +plan)             # feature: plan on claude, the rest on opencode
  t run $id
  eq "$(step $id)" done
  eq "$(grep -c . "$FAKE/opencode.calls")" 6              # implement, and a review pass per mindset
  grep -q -- '-m vllm/test-model' "$FAKE/opencode.calls"  # the step's model went with it
  eq "$(grep -c . "$FAKE/claude.calls")" 1                # the planner
  grep -q -- '--model opus --effort max' "$FAKE/claude.calls"
  t show $id | grep -q '^pipeline  feature · claude, opencode$'
  id=$(new "add the gadget" -p feature +plan --cli claude)   # --cli beats the pipeline
  t run $id
  eq "$(grep -c . "$FAKE/claude.calls")" 8
  not grep -q -- 'test-model' "$FAKE/claude.calls"        # opencode's model isn't claude's
  eq "$(grep -c -- '--effort max' "$FAKE/claude.calls")" 2     # both planners, as feature asks
  eq "$(grep -c -- '--effort high' "$FAKE/claude.calls")" 6    # implement and the five reviews: T_EFFORT
}

test_a_worktree_has_a_name_of_its_own_and_teardown_follows_tests() {
  printf 'TEST_CMD="pwd > %s/pwd"\nTEARDOWN="echo down >> %s/teardowns"\n' "$tmp" "$tmp" >> "$tmp/tick/pipelines/local/env"
  id=$(new "add the widget")
  t run $id
  eq "$(basename "$(cat "$tmp/pwd")")" "repo-$id"         # what the test command sees as its directory
  eq "$(grep -c down "$tmp/teardowns")" 1                 # after the tests
  t rm $id 2> /dev/null
  eq "$(grep -c down "$tmp/teardowns")" 2                 # and before its worktree went
}

test_a_task_started_from_the_board_keeps_the_board_out_of_its_steps() {
  printf 'TEST_CMD="env > %s/env"\n' "$tmp" >> "$tmp/tick/pipelines/local/env"
  id=$(new "add the widget")
  T_UI=$tmp/board T_NEW=$tmp/board t run $id               # as t ui starts it
  grep -q "^TASK_ID=$id$" "$tmp/env"
  not grep -qE '^T_(UI|NEW)=' "$tmp/env"                  # plan's t new would write into the board
}

test_say_sends_a_done_task_back_with_your_notes() {
  id=$(new "add the widget")
  t run $id
  eq "$(step $id)" done
  t say $id "also handle the empty case" 2> /dev/null
  eq "$(step $id)" 10-implement
  t run $id
  eq "$(step $id)" done
  grep -q 'also handle the empty case' "$FAKE/edit.prompts"
}

test_rm_f_stops_the_run_and_its_agent_first() {
  a=$(new "parent work")
  b=$(new "child work" --on $a)
  ( exec 9> "$(dir $a)/lock"; flock 9; sleep 30 ) &
  pid=$!
  sleep 0.5
  t rm -f $b 2> /dev/null                                  # it only waits on the run, so the run goes on
  kill -0 $pid
  not t rm $a 2> "$tmp/err"
  grep -q "t rm -f $((10#$a))" "$tmp/err"
  t rm -f $a 2> /dev/null
  [ ! -d "$(dir $a)" ]
  not wait $pid                                            # killed, not finished
}

test_hold_f_cancels_the_running_agent_and_holds_the_task() {
  id=$(new "add the widget")
  FAKE_SLEEP=30 t run $id > /dev/null 2>&1 &
  pid=$!
  for i in $(seq 50); do [ ! -s "$FAKE/opencode.calls" ] || break; sleep 0.1; done   # the agent is working
  t hold -f $id cancelled 2> /dev/null
  not wait $pid                                            # killed, not finished
  flock -n "$(dir $id)/lock" true                          # nothing of the run is left, the agent included
  t ls | grep -q 'held  cancelled$'
  t log $id | grep -q 'implement cancelled'
  t resume $id 2> /dev/null
  t run $id
  eq "$(step $id)" done
}

test_drivers_log_paths_from_where_the_agent_works() {
  mkdir "$tmp/w" && cd "$tmp/w"
  jq -nc --arg p "$tmp/w/src/app.ts" '{type: "assistant", message: {content: [{type: "tool_use", name: "Read", input: {file_path: $p}}]}}' > "$tmp/c.jsonl"
  echo hi | FAKE_REPLAY=$tmp/c.jsonl "$root/drivers/claude" > /dev/null 2> "$tmp/err" || true
  grep -qx '  · Read src/app.ts' "$tmp/err"
  jq -nc --arg p "$HOME/notes/todo.md" '{type: "tool_use", sessionID: "ses_x", part: {tool: "read", state: {title: "", input: {filePath: $p}}}}' > "$tmp/o.jsonl"
  echo hi | FAKE_REPLAY=$tmp/o.jsonl "$root/drivers/opencode" > /dev/null 2> "$tmp/err"
  grep -qx '  · read ~/notes/todo.md' "$tmp/err"          # outside it, $HOME is ~
}

test_rm_removes_the_worktree_and_keeps_the_branch() {
  id=$(new "add the widget")
  t run $id
  w=$(t path $id)
  t rm $id 2> /dev/null
  [ ! -e "$w" ]
  [ ! -e "$(dir $id)" ]
  git rev-parse -q --verify "refs/heads/t/$id-add-the-widget" > /dev/null
}

test_rm_f_stops_the_running_agent_and_deletes_the_task() {
  id=$(new "add the widget")
  FAKE_SLEEP=30 t run $id > /dev/null 2>&1 &
  pid=$!
  for i in $(seq 50); do [ ! -s "$FAKE/opencode.calls" ] || break; sleep 0.1; done
  t rm -f $id 2> /dev/null
  not wait $pid
  [ ! -e "$(dir $id)" ]
}

test_ctrl_x_deletes_a_task_in_place() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  new "add the widget" > /dev/null
  new "fix the gadget" > /dev/null
  eq "$(keyfor rm)" ctrl-x
  t ui --key "$(keyfor rm)" 1 '' | grep -q 'delete 1?'
  t ui --pane 1 '' | grep -q 'Deletes its directory'
  [ -d "$(dir 0001)" ]
  t ui --key enter 1 '' > /dev/null
  [ ! -e "$(dir 0001)" ]
  eq "$(cat "$T_UI/new")" 2
}

test_clean_deletes_what_is_done_answered_or_held_for_12_hours() {
  old=$(new "old done")
  t run $old
  answered=$(new "old answer")
  echo done > "$(dir $answered)/step"; touch "$(dir $answered)/answer.md"
  held=$(new "old hold")
  t hold $held waiting
  fresh=$(new "fresh hold")
  t hold $fresh waiting
  stuck=$(new "never ran")
  touch -d '13 hours ago' "$(dir $old)/step" "$(dir $answered)/step" "$(dir $held)/hold" "$(dir $stuck)/step"
  t clean -n | grep -q "old answer  answered$"
  eq "$(t clean -n | wc -l)" 3
  t clean 2> /dev/null
  [ ! -e "$(dir $old)" ] && [ ! -e "$(dir $answered)" ] && [ ! -e "$(dir $held)" ]
  [ -d "$(dir $fresh)" ] && [ -d "$(dir $stuck)" ]
  t clean 1 | grep -q 'no task done, answered or held for 1h'
}

test_the_board_cleans_after_listing_what_goes() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  id=$(new "old done")
  t run $id
  touch -d '2 days ago' "$(dir $id)/step"
  t ui --key "$(keyfor clean)" 1 '' | grep -q 'change-prompt(delete these? )'
  t ui --pane 1 '' | grep -q '1  old done  done'
  [ -d "$(dir $id)" ]
  t ui --key enter 1 '' | grep -q 'change-prompt(task> )'
  [ ! -e "$(dir $id)" ]
}

test_the_board_stays_on_clean_and_says_what_it_could_not_delete() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  parent=$(new "parent work")
  t run $parent
  child=$(new "child work" --on $parent)
  touch -d '2 days ago' "$(dir $parent)/step"
  t ui --key "$(keyfor clean)" 1 '' > /dev/null
  out=$(t ui --key enter 1 '')
  not grep -q 'change-prompt(task> )' <<< "$out"
  grep -q "change-footer~.*task $((10#$child)) is stacked on $((10#$parent))" <<< "$out"
  eq "$(cat "$T_UI/mode")" "clean -"
  [ -d "$(dir $parent)" ]
}

test_ctrl_x_is_offered_for_a_running_task() {
  id=$(new "add the widget")
  ( exec 9> "$(dir $id)/lock"; flock 9; sleep 30 ) &
  pid=$!
  sleep 0.5
  t keys $id | grep -q 'x:rm'
  kill $pid 2>/dev/null || true
}

test_main_codes_in_a_worktree_and_lands_on_the_local_main() {
  git commit -q --allow-empty -m "not pushed yet"
  id=$(new "fix the widget" -p main)
  t run $id
  eq "$(step $id)" done
  [ "$(t path $id)" != "$(realpath "$tmp/repo")" ]
  eq "$(git branch --show-current)" main
  eq "$(git log -2 --format=%s | paste -sd,)" "fix the widget,not pushed yet"   # built on it, fast-forwarded
  eq "$(cat impl.txt)" change                              # the checkout moved along
}

test_main_waits_while_your_uncommitted_work_is_in_the_way() {
  echo mine > notes.txt
  echo mine > impl.txt                                     # the task writes impl.txt too
  id=$(new "fix the widget" -p main)
  t run $id
  eq "$(step $id)" 40-merge
  eq "$(cat "$(dir $id)/runs/40-merge")" 0                 # waiting isn't a run
  eq "$(cat impl.txt)" mine
  rm impl.txt
  t run $id
  eq "$(step $id)" done
  eq "$(cat impl.txt)" change
  eq "$(cat notes.txt)" mine                               # the rest of your work stays
}

test_main_lands_past_your_uncommitted_edits_unless_they_clash() {
  seq 5 > impl.txt && git add impl.txt && git commit -q -m numbers
  echo mine >> impl.txt                                    # where the task appends its line
  id=$(new "fix the widget" -p main)
  t run $id
  eq "$(step $id)" 40-merge
  eq "$(tail -1 impl.txt)" mine
  eq "$(git stash list)" ""
  sed -i '$d; 1s/.*/mine/' impl.txt                        # the same file, somewhere else
  t run $id
  eq "$(step $id)" done
  eq "$(head -1 impl.txt),$(tail -1 impl.txt)" "mine,change"
  eq "$(git diff --name-only)" impl.txt                    # still yours to commit
  eq "$(git stash list)" ""
}

test_main_resolves_conflicts_with_a_moved_main_and_tests_again() {
  export SLOTS_opencode=1
  id=$(new "fix the widget" -p main)
  mkdir -p "$T_VAR/run"
  exec 8> "$T_VAR/run/opencode.1"; flock 8
  t run $id                                                # makes the worktree, then waits for a slot
  exec 8>&-
  echo theirs > impl.txt && git add impl.txt && git commit -q -m "meanwhile on main"
  echo noop > "$FAKE/merges"
  t run $id
  eq "$(step $id)" 40-merge
  grep -q 'left conflict markers' "$(dir $id)/log/40-merge.log"
  t run $id
  eq "$(step $id)" done
  grep -q '40-merge ok → 20-test' "$(dir $id)/history"
  eq "$(sort impl.txt | paste -sd,)" "change,theirs"       # both sides, no markers
  eq "$(git rev-parse HEAD)" "$(git rev-parse "t/$id-fix-the-widget")"
}

test_a_task_stacked_on_a_main_task_lands_on_main_too() {
  a=$(new "parent work" -p main)
  b=$(new "child work" --on $a)
  t run $a
  t run $b
  eq "$(step $b)" done
  eq "$(git log -2 --format=%s | paste -sd,)" "child work,parent work"
}

test_main_works_in_its_own_repo_from_anywhere() {
  git init -q "$tmp/other"
  git -C "$tmp/other" commit -q --allow-empty -m init
  cd "$tmp/other"
  id=$(new "fix the widget" -p main)                      # standing in another repo doesn't count
  eq "$(cat "$(dir $id)/repo")" "$(realpath "$tmp/repo")"
  cd /
  id=$(new "fix the gadget" -p main)
  eq "$(cat "$(dir $id)/repo")" "$(realpath "$tmp/repo")"
  id=$(new "fix the gizmo" -p main -r "$tmp/repo")
  not new "fix the doohickey" -p main -r "$tmp/other"
}

test_a_repo_by_name_brings_its_pipeline_and_its_tests() {
  profile
  cd /
  id=$(new "add the widget" -r toy)
  eq "$(cat "$(dir $id)/repo")" "$(realpath "$tmp/repo")"
  eq "$(cat "$(dir $id)/pipeline")" feature               # the repo's own pipeline
  id=$(new "try the widget" -r toy -p local)              # another pipeline for once...
  t run $id
  eq "$(step $id)" done
  [ -e "$tmp/tested" ]                                    # ...still with the repo's test command
  cd "$tmp/repo"
  id=$(new "one more widget")
  eq "$(cat "$(dir $id)/pipeline")" feature               # standing in the repo counts the same
}

test_a_repo_can_be_a_directory_name_or_the_default() {
  cd /
  not new "no repo anywhere"
  export T_REPOS=$tmp
  id=$(new "add the widget" -r repo)                      # a directory in $T_REPOS
  eq "$(cat "$(dir $id)/repo")" "$(realpath "$tmp/repo")"
  export T_REPO=$tmp/repo
  id=$(new "add the gadget")                              # outside any repo: T_REPO
  eq "$(cat "$(dir $id)/pipeline")" local
}

test_completion_offers_what_you_can_type() {
  profile
  export T_REPOS=$tmp
  t complete commands | grep -q '^new:create a task'
  t complete pipelines | grep -q '^feature:+plan (claude) → implement (opencode) → test .* → pr → +ci$'
  t complete repos | grep -q '^toy:.*(pipeline feature)'
  t complete repos | grep -q "^repo:$tmp/repo"
  t complete clis | grep -qx opencode
  id=$(new "add the widget")
  t complete tasks | grep -q '^1:add the widget  (10-implement, ready)'
  t complete steps widget | grep -qx review
  zsh -n "$tmp/tick/completions/t.zsh"
}

test_a_task_can_be_named_by_a_word_from_its_title() {
  a=$(new "add the widget")
  b=$(new "fix the gadget")
  eq "$(t path gadget)" "$T_VAR/tasks/$b/work"
  not t path the 2> "$tmp/err"                            # two match, and no terminal to ask in
  grep -q 'which task' "$tmp/err"
  grep -q '^  1  add the widget' "$tmp/err"
  grep -q '^  2  fix the gadget' "$tmp/err"
}

test_leaving_out_the_task_gives_a_menu() {
  a=$(new "add the widget")
  b=$(new "fix the gadget")
  out=$(printf '2\n' | T_PICKER=select tty "t path")
  grep -q "1) *1  " <<< "$out"
  grep -q "$T_VAR/tasks/$b/work" <<< "$out"
}

test_a_long_title_gets_a_short_name_for_the_board() {
  echo "Fix the checkout" > "$FAKE/names"
  a=$(new "the checkout page crashes when the cart holds more than ninety nine items")
  b=$(new "add the widget")                               # short enough already: no agent
  eq "$(grep -c . "$FAKE/opencode.calls")" 1
  grep -q 'ninety nine items' "$FAKE/read.prompts"
  out=$(t ls)
  grep -q '^ *1 .* Fix the checkout  ' <<< "$out"
  grep -q '^ *2 .* add the widget  ' <<< "$out"
  eq "$(t path ninety)" "$T_VAR/tasks/$a/work"            # a word from the title still finds it
  t show $a | grep -q 'ninety nine items'                 # show keeps the whole title
  t name $a "Cart overflow"
  t ls | grep -q '^ *1 .* Cart overflow  '
}

test_a_long_title_is_cut_to_fit_the_terminal() {
  echo "fit the board to a narrow terminal, however long" > "$FAKE/names"
  new "add the widget" > /dev/null
  new "make the board fit a narrow terminal, however long the title" > /dev/null
  out=$(tty "stty cols 40; t ls" | tr -d '\r')
  grep -qE '^ +2 +fit the board to a narrow ter… +0/3$' <<< "$out"   # the title cut, and the step kept
  [ "$(wc -L <<< "$out")" -le 40 ]
  out=$(printf '1\n' | T_PICKER=select tty "stty cols 40; t path" | tr -d '\r')
  grep -q '^2) .*…$' <<< "$out"
  [ "$(grep '^[12]) ' <<< "$out" | wc -L)" -le 40 ]
  t ls | grep -q ' fit the board to a narrow ter…  '        # piped too, the title column has a width
  t show 2 | grep -q 'however long'                         # show keeps it whole
}

test_new_without_a_title_opens_the_editor() {
  cat > "$tmp/ed" << 'EOF'
#!/bin/sh
printf 'add the widget\n\n## Context\nuse tabs\n' > "$1"
EOF
  chmod +x "$tmp/ed"
  EDITOR=$tmp/ed T_PICKER=select tty "t new" > /dev/null < /dev/null   # without fzf; with it, t compose
  eq "$(head -1 "$(dir 0001)/task.md")" "# add the widget"
  grep -q '^## Context' "$(dir 0001)/task.md"            # markdown headings survive
  cat > "$tmp/ed" << 'EOF'
#!/bin/sh
grep -q '^fix the gadget$' "$1" && grep -q '^# tick: repo · local · branches from origin/main$' "$1" &&
  printf 'fix the gadget\n\nuse spaces\n' > "$1"
EOF
  EDITOR=$tmp/ed tty "t new --edit 'fix the gadget'" > /dev/null < /dev/null   # compose's ^E: title and choices there
  grep -q '^use spaces' "$(dir 0002)/task.md"
}

test_new_dry_shows_the_task_it_would_make() {
  out=$(t new --dry "add the widget")
  grep -q '^repo *repo   (this directory)$' <<< "$out"
  grep -q '^pipeline *local$' <<< "$out"
  grep -q '^branch *t/0001-add-the-widget$' <<< "$out"
  t new --dry "Add proration. It must handle upgrades too." |
    grep -q '^branch *t/0001-add-proration$'              # the branch stops at the first sentence
  grep -q '^base *origin/main$' <<< "$out"
  grep -q '^steps *implement (opencode) → test → review (opencode)$' <<< "$out"
  t new --dry --cli claude "add the widget" |
    grep -q '^steps *implement (claude) → test → review (claude)$'   # --cli, on every agent step
  grep -q '^starts *only when you run it' <<< "$out"      # no cron tick here
  grep -q '^t new \\$' <<< "$out"
  [ ! -e "$T_VAR/tasks/0001" ]                            # it made nothing
  out=$(t new --dry -p research "what changed in bash 5.3?")
  grep -q '^repo *none needed$' <<< "$out"
  grep -q '^steps *answer (claude)$' <<< "$out"
  grep -q '^t research \\$' <<< "$out"
  echo "* * * * * $tmp/tick/bin/t tick" > "$FAKE/crontab"
  t new --dry "$(printf 'x%.0s' {1..41})" > "$tmp/out"
  grep -q '^starts *next tick' "$tmp/out"
  grep -q 'an agent will pick a short one' "$tmp/out"
  new "add the widget" > /dev/null
  new "child work" --on 0001 > /dev/null
  t new --dry --on 1 "more child work" > "$tmp/out"            # compose's preview for a stack
  grep -q '^starts *when task 1 is done' "$tmp/out"
  grep -q "^branches *from task 1's branch, into a worktree of its own" "$tmp/out"
  grep -q 'task 2 is already stacked here' "$tmp/out"
}

test_a_stray_file_among_the_tasks_does_not_stop_new_ones() {
  mkdir -p "$T_VAR/tasks" && : > "$T_VAR/tasks/lock"
  t new --dry "add the widget" | grep -q '^branch *t/0001-add-the-widget$'
  eq "$(new "add the widget")" 0001
}

test_details_come_from_stdin_only_with_a_dash() {
  t new "add the widget" 2> /dev/null < /dev/zero > /dev/null   # an open stdin must not hang it
  printf 'use tabs\n' | t new "fix the gadget" - > /dev/null 2>&1
  eq "$(cat "$(dir 0001)/task.md")" "# add the widget"
  grep -q '^use tabs' "$(dir 0002)/task.md"
}

test_ask_answers_about_the_repo_and_changes_nothing() {
  id=$(new -p ask "how do the tests run?")
  t run $id
  eq "$(step $id)" done
  [ -s "$(dir $id)/answer.md" ]
  [ ! -e "$(dir $id)/work" ]                              # no worktree
  eq "$(git status --porcelain)" ""                       # the repo is untouched
  grep -q -- '--agent plan' "$FAKE/opencode.calls"        # opencode's read-only agent
}

test_show_puts_the_answer_last_and_pages_in_a_terminal() {
  id=$(new -p ask "how do the tests run?")
  t run $id
  out=$(t show $id)
  grep -A99 '^next$' <<< "$out" | grep -q '^answer$'
  [[ $out == *$'\n'"$(cat "$(dir $id)/answer.md")" ]]      # the answer as written, unindented, at the end
  PAGER="tee $tmp/paged" tty "t show $id" > /dev/null
  grep -q 'ask a follow-up' "$tmp/paged"
}

test_research_needs_no_repo_and_may_search_the_web() {
  cd /
  id=$(new -p research "what changed in bash 5.3?")
  [ ! -e "$(dir $id)/repo" ]
  t run $id
  eq "$(step $id)" done
  [ -s "$(dir $id)/answer.md" ]
  grep -q 'WebSearch' "$FAKE/claude.calls"                 # the pipeline's MODE_answer=web
}

test_say_on_a_question_asks_a_follow_up() {
  id=$(new -p ask "how do the tests run?")
  t run $id
  t say $id "and how do I run just one?" 2> /dev/null
  eq "$(step $id)" 10-answer
  t run $id
  eq "$(step $id)" done
  grep -q 'Your earlier answer' "$FAKE/read.prompts"
  grep -q 'and how do I run just one?' "$FAKE/read.prompts"
}

test_an_answered_question_becomes_a_task_with_the_question_and_answer_as_details() {
  ask=$(new -p ask "how do the tests run?")
  t run $ask
  t say $ask "and how do I run just one?" 2> /dev/null
  t run $ask
  cd /                                                    # the question's repo, not the one you're in
  t new --dry --from $ask "run one test" | grep -q "^details *task $((10#$ask))'s question and answer$"
  id=$(new --from $ask "run one test")
  eq "$(cat "$(dir $id)/repo")" "$(cat "$(dir $ask)/repo")"
  [ "$(cat "$(dir $id)/pipeline")" != ask ]               # the repo's pipeline, which changes code
  [ ! -e "$(dir $id)/after" ]                             # nothing to wait for
  eq "$(head -1 "$(dir $id)/task.md")" "# run one test"
  grep -q '^how do the tests run?$' "$(dir $id)/task.md"
  grep -q 'and how do I run just one?' "$(dir $id)/task.md"
  grep -qF "$(grep -m1 . "$(dir $ask)/answer.md")" "$(dir $id)/task.md"
  eq "$(cat "$(dir "$(t stack $ask "again" < /dev/null 2> /dev/null)")/pipeline")" "$(cat "$(dir $id)/pipeline")"
  not new --from $id "no answer here" 2> /dev/null
  t keys $ask | grep -q ':stack '
  export T_UI=$tmp/ui T_NEW=$tmp/ui                        # on the board, the stack key makes the task
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  t ui --key "$(keyfor stack)" $((10#$ask)) '' | grep -q "change-prompt(task from $((10#$ask))> )"
}

test_new_now_runs_the_task_at_once() {
  t new --now -p ask "how do the tests run?" < /dev/null > /dev/null 2>&1
  eq "$(step 0001)" done
}

test_with_cron_a_new_task_starts_without_waiting_for_the_tick() {
  echo "* * * * * $tmp/tick/bin/t tick" > "$FAKE/crontab"
  id=$(FAKE_SLEEP=0.5 new "add the widget")              # the run it starts takes a while...
  [ "$(step $id)" != done ]                               # ...and t new doesn't wait for it (t ui's Enter would)
  wait_done $id
}

test_a_pipeline_name_starts_a_task_in_that_pipeline() {
  t ask --now "how do the tests run?" < /dev/null > /dev/null 2>&1
  eq "$(cat "$(dir 0001)/pipeline")" ask
  eq "$(step 0001)" done
  t ask --help | grep -q 'stacks it'
  t complete commands | grep -q '^research:new task: answer (claude)'
  mkdir "$tmp/tick/pipelines/log"                          # a command wins over a pipeline, and doctor says so
  t log --help | grep -q '^t log'
  not grep -q '^log:new task' <(t complete commands)
  not t doctor > "$tmp/out"
  grep -q 'pipeline log has the name of a command' "$tmp/out"
}

test_show_says_where_a_task_is_and_what_comes_next() {
  id=$(new "add the widget")
  out=$(t show $id)
  grep -q '^pipeline  local · opencode$' <<< "$out"      # the agent named once
  grep -q '^          1 implement  2 test  3 review$' <<< "$out"
  grep -q '^state     waiting for the next tick$' <<< "$out"
  grep -q '^base      origin/main$' <<< "$out"           # what its diff is against, before it has a worktree
  grep -q 't run 1 ' <<< "$out"
  t run $id
  out=$(t show widget)
  grep -q '^  [0-9:]*  review     →  done$' <<< "$out"   # history, without the date, the task and "ok"
  grep -q 't diff 1 ' <<< "$out"
  t ls -a | grep -q ' 3/3 '
}

test_diff_shows_the_change() {
  id=$(new "add the widget")
  t run $id
  t diff $id | grep -q '^+change'
}

test_the_diff_lists_the_files_and_leaves_out_what_tooling_wrote() {
  echo 'GENERATED="*.gen.json"' >> "$tmp/tick/pipelines/local/env"
  id=$(new "add the widget")
  t run $id
  w=$(t path $id)
  echo '{"huge": 1}' > "$w/api.gen.json"
  git -C "$w" add api.gen.json && git -C "$w" commit -q -m generated
  out=$(t peek $id diff)
  grep -qE '^ +\+1 -0  impl\.txt$' <<< "$out"
  grep -qE '^ +\+1 -0  api\.gen\.json  generated$' <<< "$out"
  grep -q '^+change$' <<< "$out"
  not grep -q 'huge' <<< "$out"                           # named, but its diff left out
  t diff $id | grep -q 'huge'                             # piped, t diff is all of it
  export T_UI=$tmp/ui                                     # enter on the board opens a file at a time
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  eq "$(t ui --key enter $((10#$id)) '')" "execute(t-diff $((10#$id)))"
}

test_log_shows_every_run_in_order_each_followed_by_how_it_ended() {
  printf 'BROKEN\nfixed\n' > "$FAKE/impl"                 # the tests fail once: back to implement, in one second
  id=$(new "add the widget")
  t run $id
  eq "$(t log $id | grep -oE '[a-z]+( → [a-z]+)? +run [0-9]+|[a-z]+ → done' | tr -s ' ' | paste -sd,)" \
    "implement run 1,implement → test run 1,test → implement run 2,implement → test run 2,test → review run 1,review → done"
}

test_log_f_follows_the_task_into_the_steps_still_to_come() {
  id=$(new "add the widget")
  timeout 20 t log $id -f > "$tmp/out" 2>&1 &
  for i in $(seq 50); do grep -q '(no step has run yet)' "$tmp/out" && break; sleep 0.1; done
  t run $id
  for i in $(seq 50); do grep -q 'review → done' "$tmp/out" && break; sleep 0.1; done
  kill $!
  grep -q '(no step has run yet)' "$tmp/out"
  grep -qE 'implement → test +run 1' "$tmp/out"
  grep -q 'review → done' "$tmp/out"
}

test_ui_on_a_task_offers_what_to_do_with_it() {
  id=$(new "add the widget")
  printf '7\nbusy\n' | T_PICKER=select PAGER=cat tty "t ui $id" > /dev/null   # 7) hold, and why
  grep -q busy "$(dir $id)/hold"
  (. "$tmp/tick/lib/tick.sh"; T_COLOR=1 board | grep -qF "${C_RED}held")   # the live board shows it in red
  out=$(printf 'use a fixture\n' | T_PICKER=select tty "t ui $id say")   # say names the task and what happens next
  grep -q 'starts over at 10-implement' <<< "$out"
  grep -q 'use a fixture' "$(dir $id)/feedback.md"
  t hold $id busy
  tty "t ui $id hold" > /dev/null                         # its ctrl key again: it goes on
  [ ! -e "$(dir $id)/hold" ]
  not t ui $id nosuch 2> "$tmp/err"
  grep -q 'there are: log say' "$tmp/err"
  T_PICKER=select tty t | grep -q 'add the widget'        # no fzf: plain t prints the board
}

test_the_board_counts_steps_and_leaves_what_is_absent_blank() {
  new "add the widget" > /dev/null
  new -p ask "how do the tests run?" > /dev/null
  t run 2
  t ls -a > "$tmp/out"
  grep -qE '^ +1 +repo +add the widget +0/3 +next tick$' "$tmp/out"   # not begun: no age
  grep -qE '^ +2 +repo +how do the tests run\? +1/1 +answered$' "$tmp/out"
  not grep -q — "$tmp/out"                                # what is absent is blank
  eq "$(awk '{ print index($0, "/") }' "$tmp/out" | sort -u | wc -l)" 1   # the step column lines up
  (. "$tmp/tick/lib/tick.sh"; T_COLS=80 board -a) > "$tmp/narrow"         # under 100 columns: no repo
  not grep -q repo "$tmp/narrow"
  grep -q ' 0/3 *next tick$' "$tmp/narrow"
}

test_the_board_says_what_each_task_is_doing_and_for_how_long() {
  printf 'noop\n' > "$FAKE/impl"
  id=$(new "add the widget")
  t ls | grep -qE '^ +1 .* 0/3 +next tick$'              # nothing ran yet
  t run $id
  t ls | grep -qE '^ +1 .* 1/3 +<1m +next tick +implement: the implementer changed nothing$'
  t hold $id "waiting on design"
  t ls | grep -qE ' 1/3 +<1m +held +waiting on design$'
  t keys $id | grep -qE '^enter:say .*:resume .*:keys$'  # enter says to it, a key resumes it, ? has the rest
}

test_the_board_names_the_file_and_never_a_whole_command() {
  id=$(new "add the widget")
  mkdir -p "$(dir $id)/log"
  did() { printf '=== 2026-09-11 10:00:00 10-implement, run 1\n  · %s\n' "$1" > "$(dir $id)/log/10-implement.log"; }
  did 'Read frontend/lib/wearables/workers/notify.ts'
  t ls | grep -q 'implement: Read notify.ts$'
  did 'Bash cd "$(git rev-parse --show-toplevel)" && ./fetch-pr-comments.sh 2>&1'
  t ls | grep -q 'implement: Bash fetch-pr-comments.sh$'
  did 'reading the discount code field and the proration it needs'
  t ls | grep -q 'implement: reading the discount code field…$'   # nothing gets more than a column
}

test_the_log_folds_a_run_of_one_tool_and_raw_shows_it_all() {
  id=$(new "add the widget")
  mkdir -p "$(dir $id)/log"
  { echo "=== 2026-09-11 10:00:00 10-implement, run 1"; echo "session: claude abc /x"
    for f in lib/health-sync.ts lib/health-notify.ts hooks/useHealth.ts lib/health-sync.ts; do echo "  · Read $f"; done
    echo "Read them."
    for i in 1 2 3 4 5 6 7; do echo "  · Grep p$i"; done
  } > "$(dir $id)/log/10-implement.log"
  t log $id > "$tmp/out"
  grep -qxF '       read   ×4  lib/health-*, hooks/useHealth.ts' "$tmp/out"
  grep -qxF '       Read them.' "$tmp/out"               # the agent's own words, in the text column
  grep -qxF '       grep   ×7  p1, p2, p3, p4, p5, p6, …' "$tmp/out"
  not grep -q 'session:' "$tmp/out"
  t log $id --raw > "$tmp/raw"
  eq "$(grep -c '· Read' "$tmp/raw")" 4
  grep -q '^session: claude abc' "$tmp/raw"              # the id t attach resumes
  ( exec 9> "$(dir $id)/lock"; flock 9; sleep 30 ) &     # while it runs, its last three calls stay lines
  sleep 0.3
  t log $id | tail -4 > "$tmp/live"
  eq "$(head -1 "$tmp/live")" '       grep   ×4  p1, p2, p3, p4'
  eq "$(tail -1 "$tmp/live")" '       grep   p7'
  kill $!
}

test_an_agents_markdown_reads_as_text_folded_to_the_pane() {
  id=$(new "add the widget")
  mkdir -p "$(dir $id)/log"
  cp "$tmp/tick/test/fixtures/opencode-review.log" "$(dir $id)/log/30-review.log"
  FZF_PREVIEW_COLUMNS=60 t log $id > "$tmp/out"
  [ "$(LC_ALL=C.UTF-8 wc -L < "$tmp/out")" -lt 60 ]       # folded to the pane, so fzf wraps nothing
  grep -qE '^13:11  review +run 1$' "$tmp/out"            # the banner: its time, step, and run at the edge
  not grep -qE '\*\*|`|^ *#' "$tmp/out"                   # the markdown is rendered, not printed
  grep -qxF '       Analysis' "$tmp/out"
  grep -qxF '       · suppresses CONNECTION_ENDED only in that window' "$tmp/out"
  tr -s ' \n' '  ' < "$tmp/out" | grep -qF 'causing the postgres library to reject it with CONNECTION_ENDED.'   # no word broken
  red=$(. "$tmp/tick/lib/tick.sh"; echo "$C_RED")
  FZF_PREVIEW_COLUMNS=60 CLICOLOR_FORCE=1 t log $id | grep -qF "${red}closeDb()"   # code stands out in red
}

test_the_pane_shows_details_log_or_diff() {
  id=$(new "add the widget")
  t run $id
  t peek $id | grep -q '^          1 implement  2 test  3 review$'   # done: its details,
  not grep -q 't diff 1' <(t peek $id)                    # without what to do next: the board's keys say
  timeout 0.5 t peek $id log | grep -q 'review → done'
  CLICOLOR_FORCE=1 t peek $id diff | grep -q $'\e\\['     # in color
  t peek $id diff | grep -q '^+change'
  t peek $id steps | grep -qE '^30-review +1 run'
  timeout 0.5 t peek $id raw | grep -q '^session: opencode'
  t keys $id | grep -qE '^enter:diff +[^ ]+:stack +[^ ]+:say '
  export T_UI=$tmp/ui T_NEW=$tmp/ui                        # and the key the footer offers works
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  t ui --key "$(keyfor say)" $((10#$id)) '' | grep -q "change-prompt(say to $((10#$id))> )"
}

test_steps_says_how_each_step_went_and_which_file_each_setting_comes_from() {
  profile                                                 # toy has a TEST_CMD of its own
  printf 'BROKEN\nfixed\n' > "$FAKE/impl"                 # the tests fail once: back to implement
  id=$(new -r toy -p local --test "make test" "add the widget")
  t peek $id steps | grep -qE '^10-implement +next tick '     # nothing ran yet
  t peek $id steps | grep -q '^implement — '              # what the step it is on does
  t run $id
  out=$(t peek $id steps)
  grep -qE '^10-implement  2 runs   ok → test +→ steps/implement · [0-9]+ pipelines$' <<< "$out"
  grep -qE '^20-test +2 runs   ok → review ' <<< "$out"
  grep -qE '^30-review +1 run    ok → done ' <<< "$out"
  grep -qE '^  CLI_implement +opencode  pipelines/local$' <<< "$out"
  grep -qE '^  TEST_CMD +make test  task$' <<< "$out"      # the task's own beats the repo's
  grep -qE "^  REPO +$tmp/repo  repos/toy$" <<< "$out"
}

test_compose_takes_flags_typed_with_the_title() {
  mkdir "$tmp/new"; : > "$tmp/new/args"; : > "$tmp/new/repo"
  out=$(T_NEW=$tmp/new t compose --dry local "what changed in bash? -p research")
  grep -q '^pipeline *research$' <<< "$out"
  grep -q '"what changed in bash?"' <<< "$out"
}

test_the_board_starts_a_task_and_says_to_one_in_place() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  t ui --key "$(keyfor new)" '' '' | grep -q 'change-prompt(new> )+disable-search'
  eq "$(cat "$T_UI/pick")" local
  out=$(t ui --key "$(keyfor pipeline)" '' 'add the widget')      # ^p: the list becomes the pipelines
  grep -q 'change-prompt(pipeline> )+enable-search' <<< "$out"
  grep -q 'reload-sync~t-ui --pipelines~+pos(1)' <<< "$out"       # the cursor lands on the first
  eq "$(cat "$T_UI/list")" pipelines
  eq "$(cat "$T_UI/title")" 'add the widget'                      # the title waits where you left it
  eq "$(head -1 <<< "$(t ui --pipelines)" | awk '{ print $1 }')" local   # the repo's default, first
  t ui --pane feature '' | sed 's/\x1b\[[0-9;]*m//g' | grep -q '^pipeline *feature'  # the one under the cursor
  t ui --key esc '' '' > /dev/null                                # esc: back to the tasks, nothing picked
  eq "$(cat "$T_UI/list")" tasks
  eq "$(cat "$T_UI/pick")" local
  t ui --key "$(keyfor pipeline)" '' '' > /dev/null
  t ui --key enter feature '' > /dev/null                         # enter on it: that is the pipeline
  eq "$(cat "$T_UI/list")" tasks
  eq "$(cat "$T_UI/pick")" feature
  t ui --key "$(keyfor agent)" '' '' > /dev/null          # another agent than the pipeline's
  t ui --pane '' 'add the widget' | sed 's/\x1b\[[0-9;]*m//g' | grep -q '^steps *implement (claude) → test → review (claude) → sync (claude) → pr$'
  t ui --key enter '' 'add the widget' | grep -q 'reload-sync'   # made; the reload's end puts the cursor on it
  eq "$(cat "$T_UI/new")" 1
  eq "$(cat "$(dir 0001)/pipeline")" feature
  grep -q '^AGENT_CLI=claude$' "$(dir 0001)/env"
  t hold 1 waiting
  t ui --key enter 1 '' | grep -q 'change-prompt(say to 1> )'   # Enter on a held task: say to it
  t ui --key enter 1 'use a fixture' > /dev/null
  grep -q 'use a fixture' "$(dir 0001)/feedback.md"
  [ ! -e "$(dir 0001)/hold" ]
  eq "$(cat "$T_UI/mode")" board
}

test_ui_new_form_preview_is_spaced_from_header() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  t ui --key enter '' '' > /dev/null                      # enter on an empty board: a new task
  eq "$(t ui --pane '' 'add the widget' | sed -n 2p)" ""  # a blank line under the pipelines
}

test_the_board_holds_renames_and_deletes_in_place() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  new "add the widget" > /dev/null
  new "fix the gadget" > /dev/null
  t ui --key "$(keyfor hold)" 1 '' | grep -q 'change-prompt(hold 1 because> )'
  t ui --key enter 1 'waiting on design' > /dev/null
  grep -q 'waiting on design' "$(dir 0001)/hold"
  t ui --key "$(keyfor hold)" 1 '' > /dev/null                    # held: ^r resumes it at once
  [ ! -e "$(dir 0001)/hold" ]
  t ui --key "$(keyfor keys)" 1 '' | grep -q 'change-prompt(do to 1> )'   # ? asks for the action by name...
  t ui --key enter 1 na | grep -q 'change-query~add the widget~'   # ...and its first letters will do
  t ui --key enter 1 'Widget' > /dev/null
  eq "$(cat "$(dir 0001)/name")" Widget
  t ui --key "$(keyfor keys)" 1 '' > /dev/null
  t ui --key enter 1 rm > /dev/null
  t ui --pane 1 '' | grep -q 'Deletes its directory'   # the pane says what goes before Enter does it
  [ -d "$(dir 0001)" ]
  t ui --key enter 1 '' > /dev/null
  [ ! -e "$(dir 0001)" ]
  eq "$(cat "$T_UI/new")" 2                              # the cursor goes to the next task
  t ui --key "$(keyfor log)" 2 '' > /dev/null
  t ui --key "$(keyfor log)" 2 '' > /dev/null
  eq "$(cat "$T_UI/pane")" raw                           # ^l again: the log as it is
  t ui --key "$(keyfor keys)" 2 '' > /dev/null
  t ui --pane 2 '' | grep -q 'delete it and its worktree'
  eq "$(cat "$T_UI/mode")" "do 2"
  t ui --key enter 2 r | grep -q 'could be: run rm'      # two start so: it says which
  t ui --key "$(keyfor keys)" 2 '' > /dev/null                        # ? again: back
  eq "$(cat "$T_UI/mode")" board
}

test_a_key_does_one_thing_on_the_board_and_one_in_a_form() {
  ( . "$tmp/tick/lib/tick.sh"
    eq "$(printf '%s\n' "$ACTIONS" "$BOARD_KEYS" | awk '$2 != "-" { print $2 }' | sort | uniq -d)" ""
    eq "$(printf '%s\n' "$FORM_KEYS" "$BOARD_KEYS" | awk '{ print $2 }' | sort | uniq -d)" "" )
}

test_the_live_board_draws_its_rows_and_the_keys_at_the_bottom() {
  command -v tmux > /dev/null && command -v fzf > /dev/null || return 0
  new "add the widget" > /dev/null
  server=tick-${tmp##*/}
  tmux -f /dev/null -L "$server" new-session -d -x 160 -y 16 t
  for i in $(seq 100); do                                 # the pane comes last
    tmux -L "$server" capture-pane -p > "$tmp/screen"
    if grep -q 'implement · next tick' "$tmp/screen"; then break; fi
    sleep 0.1
  done
  last=$(($(tmux -L "$server" display-message -p '#{pane_height}') - 1))
  tmux -L "$server" capture-pane -p -e -E 0 > "$tmp/top"
  tmux -L "$server" capture-pane -p -e -S "$last" > "$tmp/bottom"
  tmux -L "$server" kill-server
  cat "$tmp/screen" >&2                                    # what it drew, should a line below fail
  for corner in top bottom; do                             # the list's grey reaches the edges, with no gap in the terminal's
    grep -qE $'^[\e[0-9;m]*48;2;28;28;28' "$tmp/$corner"
  done
  grep -q '^[│ ]*task> ' "$tmp/screen"
  grep -qE '^[│ ]*> +1 +(repo +)?add the widget +0/3 +next tick' "$tmp/screen"   # fzf's pointer
  grep -q 'implement · next tick' "$tmp/screen"                      # the pane on it
  grep -qE 'enter:run .*:keys' "$tmp/screen"
}

test_the_board_picks_the_pipeline_from_a_list_of_them() {
  command -v tmux > /dev/null && command -v fzf > /dev/null || return 0
  new "add the widget" > /dev/null
  server=tick-${tmp##*/}
  tmux -f /dev/null -L "$server" new-session -d -x 160 -y 16 t
  screen() { tmux -L "$server" capture-pane -p; }
  for i in $(seq 100); do screen | grep -q 'implement · next tick' && break; sleep 0.1; done
  tmux -L "$server" send-keys C-n                          # the new form
  for i in $(seq 100); do screen | grep -q 'new> ' && break; sleep 0.1; done
  tmux -L "$server" send-keys 'add a discount code'
  tmux -L "$server" send-keys C-p                          # the pipelines, the default first
  for i in $(seq 100); do screen | grep -qE '^[│ ]*> +local ' && break; sleep 0.1; done
  screen | grep -q 'pipeline> '
  screen | grep -qE '^[│ ]*> +local '                      # the default, under the cursor
  tmux -L "$server" send-keys fea                          # search them, as the tasks are searched
  for i in $(seq 100); do screen | grep -qE '^[│ ]*> +feature ' && break; sleep 0.1; done
  tmux -L "$server" send-keys Enter                        # picks it; the tasks come back, the title waiting
  for i in $(seq 100); do screen | grep -q 'new> add a discount code' && break; sleep 0.1; done
  tmux -L "$server" send-keys Enter
  for i in $(seq 100); do [ -f "$(dir 0002)/pipeline" ] && break; sleep 0.1; done
  eq "$(cat "$(dir 0002)/pipeline")" feature
  tmux -L "$server" kill-server
}

test_the_board_changes_who_solves_a_task_it_already_has() {
  export T_UI=$tmp/ui T_NEW=$tmp/ui
  mkdir "$T_UI"; echo board > "$T_UI/mode"; touch "$T_UI"/{pane,pick,def,args,repo,cli}
  id=$(new "add the widget")
  t ui --key "$(keyfor agent)" $((10#$id)) '' | grep -q 'task 1: claude solves every step'
  t show $id | grep -q '^pipeline  local · claude$'
  t run $id
  grep -q '^session: claude ' "$(dir $id)/log/10-implement.log"
  [ ! -e "$FAKE/opencode.calls" ]
  t ui --key "$(keyfor agent)" $((10#$id)) '' > /dev/null  # opencode
  t ui --key "$(keyfor agent)" $((10#$id)) '' | grep -q "its pipeline's agents"
  not grep -q AGENT_CLI "$(dir $id)/env"
  t agent $id claude > /dev/null
  t ui --key "$(keyfor say)" $((10#$id)) '' > /dev/null     # the say form starts from the task's own agent
  eq "$(cat "$T_UI/cli")" claude
}

test_doctor_says_what_to_fix() {
  not t doctor > "$tmp/out"
  if command -v fzf > /dev/null; then grep -q '✓ fzf (the live board)' "$tmp/out"; fi   # fzf knows the board's flags and colors
  grep -q 'no cron line' "$tmp/out"
  grep -q '\* local ' "$tmp/out"
  echo "* * * * * $tmp/tick/bin/t tick" > "$FAKE/crontab"
  t doctor > "$tmp/out"
  grep -q 'all good' "$tmp/out"
}

test_the_front_digest_puts_comments_that_mention_you_first() {
  front
  now=$(date +%s)
  page "[{\"id\": \"cnv_mail\", \"subject\": \"Invoice question\", \"status\": \"open\", \"updated_at\": $now}]" > "$FAKE/front/conversations_search_recipient"
  page "[{\"id\": \"cnv_tag\", \"subject\": \"Launch plan\", \"status\": \"open\", \"updated_at\": $((now - 60))}]" > "$FAKE/front/conversations_search_mention"
  page "[{\"type\": \"email\", \"created_at\": $now, \"text\": \"Can you resend the invoice?\", \"recipients\": [{\"role\": \"from\", \"handle\": \"bob@shop.example\"}]},
         {\"type\": \"email\", \"created_at\": 1, \"text\": \"old news\", \"recipients\": []}]" > "$FAKE/front/conversations_cnv_mail_messages"
  page "[{\"id\": \"com_1\", \"posted_at\": $now, \"author\": {\"id\": \"tea_kari\", \"first_name\": \"Kari\", \"last_name\": \"N\"}, \"body\": \"@me can you sign off?\"}]" > "$FAKE/front/conversations_cnv_tag_comments"
  page '[{"id": "tea_me"}]' > "$FAKE/front/comments_com_1_mentions"
  "$tmp/tick/jobs/front-digest" > "$tmp/digest"
  [ -s "$tmp/digest" ]
  p=$FAKE/read.prompts
  grep -q 'comment by Kari N, .* — MENTIONS YOU' "$p"
  [ "$(grep -n 'Launch plan' "$p" | cut -d: -f1)" -lt "$(grep -n 'Invoice question' "$p" | cut -d: -f1)" ]
  grep -q 'email from bob@shop.example' "$p"
  not grep -q 'old news' "$p"
}

idle() { "$tmp/tick/jobs/idle-review" 2> /dev/null; }   # one pass of jobs/idle-review, quietly   # one pass of jobs/idle-review, quietly
reads() { grep -c '^=====$' "$FAKE/read.prompts" 2> /dev/null || echo 0; }   # prompts a reviewer got

test_idle_review_reads_finished_work_with_a_mindset_its_pipeline_skipped() {
  echo 'MINDSETS="intent"' >> "$tmp/tick/pipelines/local/env"
  id=$(new "add the widget")
  t run $id
  eq "$(reads)" 1                                         # the pipeline read it once, as intent
  idle
  eq "$(reads)" 2
  [ ! -e "$(dir $id)/idle/intent" ]                       # the one its pipeline runs waits its turn
  m=$(ls "$(dir $id)/idle")                               # whichever it took, that mindset was read
  grep -qF "$(head -1 "$tmp/tick/mindsets/$m.md")" "$FAKE/read.prompts"
  eq "$(cut -d' ' -f1 "$(dir $id)/idle/$m")" "$(git -C "$(t path $id)" rev-parse HEAD)"
}

test_the_board_says_which_mindset_is_reading_a_finished_task() {
  id=$(new "add the widget")
  t run $id
  FAKE_SLEEP=3 setsid "$tmp/tick/jobs/idle-review" > /dev/null 2>&1 &
  for _ in $(seq 50); do [ -s "$(dir $id)/note" ] && break; sleep 0.2; done
  t ls -a | grep "^ *$((10#$id)) " | grep -q 'idle review  '      # something is happening, and what
  wait
  [ ! -e "$(dir $id)/note" ]                                      # and the board says done again
  t ls -a | grep "^ *$((10#$id)) " | grep -q ' done$'
}

test_idle_review_waits_while_the_gpu_is_yours() {
  id=$(new "add the widget")
  t run $id
  before=$(reads)
  export GPU_BUSY=true                                    # as a Steam game makes it
  idle
  eq "$(reads)" "$before"
  export GPU_BUSY=false
  idle
  eq "$(reads)" "$((before + 1))"                         # and reads again once you stop playing
}

test_idle_review_goes_quiet_when_every_mindset_has_read_the_commit() {
  export IDLE_PASSES=1
  id=$(new "add the widget")
  t run $id
  for _ in $(ls "$tmp/tick/mindsets"); do idle; done
  before=$(reads)
  idle
  eq "$(reads)" "$before"                                 # nothing new to look at, and it says nothing
  eq "$(ls "$(dir $id)/idle" | wc -l)" "$(ls "$tmp/tick/mindsets" | wc -l)"
}

test_what_an_idle_review_finds_goes_back_to_the_task_once() {
  printf 'approve\nchanges\n' > "$FAKE/verdicts"         # the pipeline approves; the idle pass doesn't
  id=$(new "add the widget")
  t run $id
  idle
  eq "$(step $id)" 10-implement                           # said to the task, which starts over
  grep -q '^## idle review: ' "$(dir $id)/feedback.md"    # and the note says which mindset found it
  eq "$(cat "$(dir $id)/idle/fixes")" 1
  idle
  eq "$(cat "$(dir $id)/idle/fixes")" 1                   # it is running now: one finding at a time
}

test_idle_review_leaves_a_busy_machine_alone() {
  id=$(new "add the widget")
  t run $id
  exec 9> "$(dir $id)/lock"; flock 9
  echo 10-implement > "$(dir $id)/step"                   # something is running
  before=$(reads)
  idle
  eq "$(reads)" "$before"
  exec 9>&-
}

test_two_idle_reviews_never_overlap() {
  id=$(new "add the widget")
  t run $id
  mkdir -p "$T_VAR"; exec 8> "$T_VAR/idle.lock"; flock 8
  before=$(reads)
  idle
  eq "$(reads)" "$before"
  exec 8>&-
}

test_idle_review_passes_over_work_it_cannot_help() {
  a=$(new "landed work" -p main)                          # main lands its branch on the trunk
  t run $a
  b=$(new "parent work"); c=$(new "child work" --on $b)
  t run $b
  d=$(new "held work"); t run $d; t hold $d "not now" > /dev/null 2>&1
  e=$(new "a question" -p ask); t run $e                  # no worktree at all
  before=$(reads)
  idle
  eq "$(reads)" "$before"                                 # landed, stacked on, held, no worktree
  eq "$(step $c)" 10-implement
}

test_idle_review_asks_one_task_for_no_more_fixes_than_it_may() {
  export IDLE_FIXES=1
  printf 'approve\nchanges\napprove\n' > "$FAKE/verdicts"
  id=$(new "add the widget")
  t run $id
  idle
  eq "$(cat "$(dir $id)/idle/fixes")" 1
  t run $id                                               # it fixes what the idle review found
  eq "$(step $id)" done
  before=$(reads)
  idle
  eq "$(reads)" "$before"                                 # and is left alone from now on
}

test_idle_review_leaves_a_closed_pull_request_alone() {
  profile
  echo MERGED > "$FAKE/pr_state"
  id=$(new "add the widget" -r toy -p feature)
  t run $id
  eq "$(step $id)" done
  before=$(reads)
  idle
  eq "$(reads)" "$before"
  [ -n "$(ls "$(dir $id)/idle")" ]                        # marked read, so it stops being a candidate
}

test_idle_review_is_a_job_the_rest_of_tick_knows_nothing_about() {
  not grep -rq 'idle/' "$root/bin" "$root/lib" "$root/steps" "$root/drivers" "$root/pipelines" "$root/etc"
}

test_the_front_digest_calls_no_agent_when_nothing_is_new() {
  front
  out=$("$tmp/tick/jobs/front-digest")
  grep -q '^Nothing new in Front since' <<< "$out"
  [ ! -e "$FAKE/claude.calls" ]
}

test_the_front_digest_fails_with_the_fix_when_front_refuses() {
  export XDG_CONFIG_HOME=$tmp/config
  not "$tmp/tick/jobs/front-digest" 2> "$tmp/err"
  grep -q 't front login' "$tmp/err"
  front
  touch "$FAKE/front/401"
  not "$tmp/tick/jobs/front-digest" > "$tmp/out" 2> "$tmp/err"
  grep -q 'check FRONT_TOKEN' "$tmp/err"
  [ ! -s "$tmp/out" ]
  [ ! -e "$FAKE/claude.calls" ]
}

test_front_login_checks_the_token_before_it_keeps_it_where_front_is_read() {
  export XDG_CONFIG_HOME=$tmp/config
  mkdir -p "$FAKE/front"
  echo '{"id": "cmp_1", "name": "Stadler"}' > "$FAKE/front/me"
  echo '{"id": "tea_me", "first_name": "Aksel", "last_name": "S"}' > "$FAKE/front/teammates_alt:email:me%40example.com"
  printf 'secret-token\nme@example.com\n' | t front login 2> "$tmp/err"
  grep -q '^  private     Read, Write, Send' "$tmp/err"                 # what to choose, said before it asks
  grep -q '^  Delete   leave it off' "$tmp/err"
  grep -q 'at Stadler as Aksel S' "$tmp/err"
  eq "$(env -i bash -c ". '$tmp/config/front/env'; echo \"\$FRONT_TOKEN \$FRONT_EMAIL\"")" "secret-token me@example.com"
  eq "$(stat -c %a "$tmp/config/front/env")" 600
  touch "$FAKE/front/401"
  not bash -c "printf 'bad-token\n\n' | t front login" 2> "$tmp/err"   # an empty login keeps the one you had
  grep -q 'refused the token, so nothing changed' "$tmp/err"
  grep -q '^FRONT_TOKEN=secret-token$' "$tmp/config/front/env"
}

front_source() { "$tmp/tick/sources/front" "$@"; }

test_front_polls_each_conversation_that_involves_you_once_with_why() {
  front
  page '[{"id": "cnv_a", "subject": "A", "updated_at": 300}]' > "$FAKE/front/conversations_search_mention"
  page '[{"id": "cnv_a", "subject": "A", "updated_at": 300}, {"id": "cnv_b", "subject": "B", "updated_at": 400}]' > "$FAKE/front/conversations_search_assignee"
  page '[{"id": "cnv_c", "subject": "C", "updated_at": 200}]' > "$FAKE/front/conversations_search_participant"
  out=$(front_source poll 100)
  eq "$(wc -l <<< "$out")" 3
  eq "$(head -1 <<< "$out" | jq -r .id)" cnv_b                      # newest first
  eq "$(jq -r 'select(.id == "cnv_a") | .why' <<< "$out")" "mention assigned"
  eq "$(jq -r 'select(.id == "cnv_c") | .why' <<< "$out")" participant   # one you only replied in
  grep -q 'after%3A100' "$FAKE/curl.calls"
}

test_a_front_thread_reads_oldest_first_without_quotes_or_drafts() {
  front
  echo '{"id": "cnv_x", "subject": "Invoice question"}' > "$FAKE/front/conversations_cnv_x"
  page '[{"type": "email", "created_at": 300, "draft_mode": "private", "text": "half a thought"},
         {"type": "email", "created_at": 200, "draft_mode": null, "recipients": [{"role": "from", "handle": "me@example.com"}], "text": "We are on it.\n> Can you resend the invoice?"},
         {"type": "email", "created_at": 100, "draft_mode": null, "is_inbound": true, "recipients": [{"role": "from", "name": "Bob", "handle": "bob@shop.example"}], "text": "Can you resend the invoice?"}]' \
    > "$FAKE/front/conversations_cnv_x_messages"
  page '[{"posted_at": 150, "author": {"first_name": "Kari", "last_name": "N"}, "body": "ask finance"}]' > "$FAKE/front/conversations_cnv_x_comments"
  front_source thread cnv_x > "$tmp/thread.md"
  eq "$(head -1 "$tmp/thread.md")" "# Invoice question"
  eq "$(grep '^##' "$tmp/thread.md" | cut -d, -f1)" "$(printf '## email from Bob\n### └ comment by Kari N\n## email from me@example.com')"
  grep -qx '_1 comment: only your teammates see it, not Bob._' "$tmp/thread.md"   # said, so it never reads as said to Bob
  not grep -q '^> ' "$tmp/thread.md"
  not grep -q 'half a thought' "$tmp/thread.md"                     # your unsent draft is not the thread
}

test_a_front_draft_is_private_and_a_second_one_edits_the_first() {
  front
  page '[{"id": "inb_1"}]' > "$FAKE/front/conversations_cnv_x_inboxes"
  page '[{"id": "cha_1"}]' > "$FAKE/front/inboxes_inb_1_channels"
  echo '{"id": "msg_d1"}' > "$FAKE/front/conversations_cnv_x_drafts"
  eq "$(printf 'Hi Bob,\n\nsent again <today>.\n' | front_source draft cnv_x)" msg_d1
  body=$(grep -A1 '^POST /conversations/cnv_x/drafts$' "$FAKE/front.calls" | tail -1)
  eq "$(jq -r .mode <<< "$body")" private                           # nobody else sees it until you send it
  eq "$(jq -r .channel_id <<< "$body")" cha_1
  eq "$(jq -r .author_id <<< "$body")" tea_me
  eq "$(jq -r .body <<< "$body")" 'Hi Bob,<br><br>sent again &lt;today&gt;.'
  echo '{"id": "msg_d1"}' > "$FAKE/front/drafts_msg_d1"
  printf 'shorter\n' | front_source draft cnv_x msg_d1 > /dev/null
  grep -q '^PATCH /drafts/msg_d1/$' "$FAKE/front.calls"
  eq "$(grep -c '^POST ' "$FAKE/front.calls")" 1                    # one draft, edited, not two
  not front_source draft cnv_x < /dev/null 2> "$tmp/err"
  grep -q 'the reply is empty' "$tmp/err"
}

conversation() {   # Front's conversation cnv_x, where Bob asks for his invoice, to reply to
  front
  echo '{"id": "cnv_x", "subject": "Invoice question"}' > "$FAKE/front/conversations_cnv_x"
  asks '[{"type": "email", "created_at": 100, "draft_mode": null, "recipients": [{"role": "from", "name": "Bob"}], "text": "Can you resend the invoice?"}]'
  page '[]' > "$FAKE/front/conversations_cnv_x_comments"
  page '[{"id": "inb_1"}]' > "$FAKE/front/conversations_cnv_x_inboxes"
  page '[{"id": "cha_1"}]' > "$FAKE/front/inboxes_inb_1_channels"
  echo '{"id": "msg_d1"}' > "$FAKE/front/conversations_cnv_x_drafts"
}
asks() { page "$1" > "$FAKE/front/conversations_cnv_x_messages"; }   # the messages in cnv_x from now on
reply() { printf 'conversation: front cnv_x\n%s' "${2:-}" | t new -p reply $1 "Re: Invoice question" - 2> /dev/null; }
sign() { t sign "$1" < /dev/null 2> /dev/null; }

test_a_reply_you_write_holds_until_you_sign_it_then_lands_as_a_front_draft() {
  conversation
  id=$(reply)
  t run $id
  eq "$(step $id)" 30-sign
  eq "$(cat "$(dir $id)/hold")" "write your reply"                  # held: it waits for you, in red
  grep -q 'Can you resend the invoice?' "$(dir $id)/thread.md"
  [ ! -e "$FAKE/front.calls" ]                                      # and nothing has left
  not t sign $id < /dev/null 2> "$tmp/err"
  grep -q 'no reply to sign' "$tmp/err"
  printf 'Sent it again just now.\n' > "$(dir $id)/answer.md"
  sign $id
  t run $id
  eq "$(step $id)" done
  grep -q '^POST /conversations/cnv_x/drafts$' "$FAKE/front.calls"
  eq "$(cat "$(dir $id)/draft_id")" msg_d1
  not grep -q '/messages$' "$FAKE/front.calls"                      # a draft: you send it from Front
}

test_an_agent_drafts_a_reply_from_the_thread_and_redrafts_it_from_your_notes() {
  conversation
  id=$(reply +draft 'say it goes out today')
  t run $id
  eq "$(cat "$(dir $id)/hold")" "draft ready"
  grep -q 'Can you resend the invoice?' "$FAKE/read.prompts"
  grep -q 'say it goes out today' "$FAKE/read.prompts"
  [ -s "$(dir $id)/answer.md" ]
  sign $id
  t run $id
  eq "$(step $id)" done
  t say $id "shorter" draft 2> /dev/null
  t run $id
  eq "$(step $id)" 30-sign                                          # a new draft waits to be read again
  grep -q '^## Your earlier draft' "$FAKE/read.prompts"
  grep -q '^shorter$' "$FAKE/read.prompts"
  sign $id
  t run $id
  grep -q '^PATCH /drafts/msg_d1/$' "$FAKE/front.calls"             # into the draft it made before
  eq "$(grep -c '^POST ' "$FAKE/front.calls")" 1
}

test_a_reply_is_sent_only_while_the_thread_is_the_one_you_read() {
  conversation
  echo 'DELIVER=send' >> "$tmp/tick/pipelines/reply/env"
  echo '{"status": "accepted", "message_uid": "uid_1"}' > "$FAKE/front/POST_conversations_cnv_x_messages"
  id=$(reply)
  t run $id
  printf 'Sent it again just now.\n' > "$(dir $id)/answer.md"
  asks '[{"type": "email", "created_at": 200, "draft_mode": null, "recipients": [{"role": "from", "name": "Bob"}], "text": "Never mind, found it."},
         {"type": "email", "created_at": 100, "draft_mode": null, "recipients": [{"role": "from", "name": "Bob"}], "text": "Can you resend the invoice?"}]'
  sign $id
  t run $id
  eq "$(step $id)" 30-sign
  grep -q 'the thread moved' "$(dir $id)/hold"
  grep -q 'Never mind, found it.' "$(dir $id)/thread.md"
  not grep -qs '^POST ' "$FAKE/front.calls"                         # Bob wrote since: nothing went
  sign $id
  t run $id
  eq "$(step $id)" done
  body=$(grep -A1 '^POST /conversations/cnv_x/messages$' "$FAKE/front.calls" | tail -1)
  eq "$(jq .options.archive <<< "$body")" false
  eq "$(cat "$(dir $id)/sent")" uid_1
}

test_show_puts_a_reply_above_the_thread_it_answers_and_says_how_to_sign_it() {
  conversation
  id=$(reply)
  t run $id
  t show $id > "$tmp/out"
  grep -q "^  t sign $((10#$id)) " "$tmp/out"
  not grep -q 't attach' "$tmp/out"                                 # no agent wrote it, so none to take over
  printf 'Sent it again just now.\n' > "$(dir $id)/answer.md"
  t show $id > "$tmp/out"
  eq "$(grep '^reply$\|^thread$\|^Sent it again\|^Can you resend' "$tmp/out")" \
     "$(printf 'reply\nSent it again just now.\nthread\nCan you resend the invoice?')"
}

test_the_front_watch_keeps_what_changed_and_says_how_much_on_its_one_row() {
  conversation
  page "[{\"id\": \"cnv_x\", \"subject\": \"Invoice question\", \"updated_at\": $(date +%s)}]" > "$FAKE/front/conversations_search_mention"
  id=$(new -p front-inbox "front inbox")
  t run $id
  eq "$(step $id)" 10-watch                                         # a watch never ends
  mail=$T_VAR/mail/front/cnv_x
  grep -q 'Can you resend the invoice?' "$mail/thread.md"
  grep -q 'Can you resend the invoice?' "$FAKE/read.prompts"        # the gist is an agent's, of the thread
  [ -s "$mail/gist" ]
  eq "$(cat "$(dir $id)/inbox")" front
  t ls | grep "^ *$((10#$id)) " | grep -q '  1 today$'
  asked=$(wc -l < "$FAKE/curl.calls")
  t run $id
  eq "$(wc -l < "$FAKE/curl.calls")" "$asked"                       # within POLL, Front isn't asked again
  touch -d '1 hour ago' "$T_VAR/mail/front/polled"
  touch "$FAKE/front/401"
  t run $id
  t ls | grep "^ *$((10#$id)) " > "$tmp/row"
  not grep -q today "$tmp/row"                                      # a poll that failed says so, not the last count
}

watched() {   # a front watch that has read cnv_x once (after conversation); prints its task id
  page "[{\"id\": \"cnv_x\", \"subject\": \"Invoice question\", \"updated_at\": $(date +%s)}]" > "$FAKE/front/conversations_search_mention"
  new -p front-inbox "front inbox"
  t run 1 > /dev/null 2>&1
}
inbox() { T_INBOX=front "$tmp/tick/bin/t-inbox" "$@"; }
offered() { (. "$tmp/tick/lib/tick.sh"; offers "$(dir "$1")"); }

test_the_inbox_lists_what_the_watch_keeps_and_enter_drafts_one_reply_to_a_conversation() {
  conversation
  watch=$(watched)
  eq "$(offered $watch)" "inbox log"                               # enter on the watch's row opens its mail
  inbox --rows | grep -q $'^cnv_x\t.*Invoice question'
  inbox --pane cnv_x | grep -q 'Can you resend the invoice?'
  inbox --key enter cnv_x > /dev/null
  id=$(ls "$T_VAR/tasks" | tail -1)
  eq "$(cat "$(dir $id)/pipeline")" reply
  eq "$(cat "$(dir $id)/opt")" draft
  grep -qx 'conversation: front cnv_x' "$(dir $id)/task.md"
  inbox --rows | grep -q "task $((10#$id))"
  inbox --key enter cnv_x | grep -q 'already replies'
  eq "$(ls "$T_VAR/tasks" | wc -l)" 2                               # one reply to a conversation, not one a press
  t run $id
  eq "$(offered $id)" "sign say rm"                                 # and enter on the held reply signs it
}

test_archiving_in_the_inbox_archives_in_front_and_takes_the_row() {
  conversation
  watched > /dev/null
  inbox --key "$(keyfor archive)" cnv_x > /dev/null
  grep -A1 '^PATCH /conversations/cnv_x$' "$FAKE/front.calls" | tail -1 | grep -q '"status":"archived"'
  eq "$(inbox --rows)" ""
}

test_a_comment_is_posted_for_your_teammates_only_once_you_sign_it() {
  conversation
  mkdir -p "$T_VAR/mail/front/cnv_x"
  echo '{"id": "cnv_x", "from": "bob@shop.example"}' > "$T_VAR/mail/front/cnv_x/conv.json"
  id=$(printf 'conversation: front cnv_x\n' | t new -p comment "Re: Invoice question" - 2> /dev/null)
  t run $id
  eq "$(cat "$(dir $id)/hold")" "write your comment"
  printf 'Ida, can you confirm the PO?\n' > "$(dir $id)/answer.md"
  t resume $id 2> /dev/null
  t run $id
  eq "$(cat "$(dir $id)/hold")" "comment ready: internal, bob@shop.example will not see it"   # who, by name
  [ ! -e "$FAKE/front.calls" ]                                      # and nothing is up yet
  sign $id
  t run $id
  eq "$(step $id)" done
  body=$(grep -A1 '^POST /conversations/cnv_x/comments$' "$FAKE/front.calls" | tail -1)
  eq "$(jq -r .body <<< "$body")" 'Ida, can you confirm the PO?'
  eq "$(jq -r .author_id <<< "$body")" tea_me
  not grep -q '/drafts$\|/messages$' "$FAKE/front.calls"            # a comment, never a reply
}

test_the_inbox_says_where_a_comment_mentions_you_and_writes_a_comment_apart_from_a_reply() {
  conversation
  page '[{"posted_at": 150, "author": {"first_name": "Ida", "last_name": "K"}, "body": "@me the PO was never updated"}]' \
    > "$FAKE/front/conversations_cnv_x_comments"
  watched > /dev/null                                               # found by Front's mention: search
  inbox --rows | grep -q $'^cnv_x\t.*Invoice question .*mention'
  inbox --pane cnv_x | grep -q ' · 1 message, 1 comment'
  inbox --pane cnv_x | grep -q '^### └ comment by Ida K'
  eq "$(inbox --key "$(keyfor comment)" cnv_x)" "execute(t-inbox --write comment cnv_x)+reload(CLICOLOR_FORCE=1 t-inbox --rows)"
  eq "$(inbox --key "$(keyfor write)" cnv_x)" "execute(t-inbox --write reply cnv_x)+reload(CLICOLOR_FORCE=1 t-inbox --rows)"
}

test_a_draft_follows_the_comments_and_is_told_the_customer_cannot_see_them() {
  conversation
  page '[{"posted_at": 150, "author": {"first_name": "Marius", "last_name": "H"}, "body": "do not offer a credit note"}]' \
    > "$FAKE/front/conversations_cnv_x_comments"
  id=$(reply +draft)
  t run $id
  grep -q '^### └ comment by Marius H' "$FAKE/read.prompts"
  grep -q 'do not offer a credit note' "$FAKE/read.prompts"
  grep -q 'never sees' "$FAKE/read.prompts"                         # agents/drafter.md says what a └ line is
}

test_the_first_poll_reads_a_day_back_and_a_later_mention_brings_the_whole_thread() {
  conversation                                                      # Bob asked for his invoice long ago
  id=$(new -p front-inbox "front inbox")
  before=$(date +%s)
  t run $id
  since=$(grep -o 'after%3A[0-9]*' "$FAKE/curl.calls" | head -1 | grep -o '[0-9]*$')
  [ "$since" -le $((before - 86400)) ] && [ "$since" -ge $((before - 86400 - 120)) ]   # a day back, and nothing more
  [ ! -e "$T_VAR/mail/front/cnv_x" ]
  page '[{"posted_at": 150, "author": {"first_name": "Ida", "last_name": "K"}, "body": "@me can you take this?"}]' \
    > "$FAKE/front/conversations_cnv_x_comments"
  page "[{\"id\": \"cnv_x\", \"subject\": \"Invoice question\", \"updated_at\": $(date +%s)}]" > "$FAKE/front/conversations_search_mention"
  touch -d '1 hour ago' "$T_VAR/mail/front/polled"
  t run $id
  grep -q 'Can you resend the invoice?' "$T_VAR/mail/front/cnv_x/thread.md"   # the message from before the day, too
  grep -q '^### └ comment by Ida K' "$T_VAR/mail/front/cnv_x/thread.md"
}

searched_since() { grep -o 'participant%3Atea_me%20after%3A[0-9-]*' "$FAKE/curl.calls" | tail -1 | grep -o '[0-9-]*$'; }

test_the_corpus_keeps_only_what_you_sent_and_goes_on_from_where_it_stopped() {
  front
  now=$(date +%s)
  page '[{"id": "cnv_s", "subject": "Invoice question", "updated_at": 1}]' > "$FAKE/front/conversations_search_participant"
  page "$(jq -nc --argjson t "$now" '[
    {id: "msg_in", is_inbound: true, created_at: $t, draft_mode: null, author: null, recipients: [], text: "Can you resend it?"},
    {id: "msg_out", is_inbound: false, created_at: $t, draft_mode: null, author: {id: "tea_me"},
     recipients: [{role: "to", handle: "bob@shop.example"}], subject: "Re: Invoice question", text: "Sent it again.\n> Can you resend it?"},
    {id: "msg_unsent", is_inbound: false, created_at: $t, draft_mode: "private", author: {id: "tea_me"}, recipients: [], text: "half a thought"},
    {id: "msg_kari", is_inbound: false, created_at: $t, draft_mode: null, author: {id: "tea_kari"}, recipients: [], text: "Kari wrote this"}]')" \
    > "$FAKE/front/conversations_cnv_s_messages"
  "$tmp/tick/jobs/mail-corpus" 2> /dev/null
  corpus=$T_VAR/corpus/front
  eq "$(ls "$corpus")" msg_out.md                                   # not theirs, not a draft, not a teammate's
  eq "$(head -2 "$corpus/msg_out.md")" "$(printf 'to: bob@shop.example\nsubject: Re: Invoice question')"
  grep -qx 'Sent it again.' "$corpus/msg_out.md"
  not grep -q '^> ' "$corpus/msg_out.md"
  [ "$(searched_since)" -lt "$((now - 86400))" ]                    # the first run goes back CORPUS_SINCE
  "$tmp/tick/jobs/mail-corpus" 2> /dev/null
  [ "$(searched_since)" -ge "$now" ]                                # and the next one from where it stopped
}

test_a_draft_reads_what_you_wrote_to_the_same_person_before_anyone_else() {
  conversation
  mkdir -p "$T_VAR/corpus/front" "$T_VAR/mail/front/cnv_x"
  echo '{"id": "cnv_x", "from": "bob@shop.example"}' > "$T_VAR/mail/front/cnv_x/conv.json"
  printf 'to: bob@shop.example\nsubject: Old news\n\nHei Bob, as always.\n' > "$T_VAR/corpus/front/msg_bob.md"
  touch -d '2 days ago' "$T_VAR/corpus/front/msg_bob.md"
  printf 'to: ann@elsewhere.example\nsubject: Newer\n\nDear Ann, newer.\n' > "$T_VAR/corpus/front/msg_ann.md"
  export CORPUS_MAX=100                                             # room for one of the two
  id=$(reply +draft)
  t run $id
  grep -q '^## Mail you wrote before, to bob@shop.example first' "$FAKE/read.prompts"
  grep -q 'Hei Bob, as always.' "$FAKE/read.prompts"
  not grep -q 'Dear Ann, newer.' "$FAKE/read.prompts"               # the newest, but to someone else
}

workspace() {   # Google account "work", logged in, its mail linked as sources/work and its calendar as calendars/work
  export XDG_CONFIG_HOME=$tmp/config
  mkdir -p "$tmp/config/google/work" "$FAKE/google"
  printf 'GOOGLE_CLIENT_ID=id.apps\nGOOGLE_CLIENT_SECRET=secret\n' > "$tmp/config/google/work/env"
  echo refresh-old > "$tmp/config/google/work/refresh_token"
  echo '{"access_token": "tok", "refresh_token": "refresh-new", "expires_in": 3599}' > "$FAKE/google/token"
  echo '{"emailAddress": "Me@work.example"}' > "$FAKE/google/gmail_v1_users_me_profile"
  ln -s gmail "$tmp/tick/sources/work"
  ln -s gcal "$tmp/tick/calendars/work"
}
gmail_message() {   # ID FROM TO SUBJECT EPOCH TEXT [LABELS]: one message, as Gmail's API gives it
  jq -nc --arg id "$1" --arg from "$2" --arg to "$3" --arg subject "$4" --argjson at "$5" --arg text "$6" --arg labels "${7:-INBOX}" '
    {id: $id, labelIds: ($labels | split(",")), internalDate: ($at * 1000 | tostring),
     payload: {mimeType: "multipart/alternative",
       headers: [{name: "From", value: $from}, {name: "To", value: $to}, {name: "Subject", value: $subject},
                 {name: "Message-ID", value: "<\($id)@mail>"}],
       parts: [{mimeType: "text/plain", body: {data: ($text | @base64 | gsub("\\+"; "-") | gsub("/"; "_") | gsub("="; ""))}},
               {mimeType: "text/html", body: {data: "PGI-"}}]}}'
}
gmail_thread() {   # th_1: you wrote Bob, Bob answered, and a draft of yours sits under it
  now=$(date +%s)
  jq -nc '{threads: [{id: "th_1"}]}' > "$FAKE/google/gmail_v1_users_me_threads"
  jq -nc --argjson m "[$(gmail_message m1 'Me <me@work.example>' bob@shop.example Invoice $((now - 120)) 'Here is the invoice.'),
      $(gmail_message m2 'Bob <bob@shop.example>' me@work.example 'Re: Invoice' $((now - 60)) $'Can you resend it?\r\n> Here is the invoice.' INBOX,UNREAD),
      $(gmail_message m3 'Me <me@work.example>' bob@shop.example 'Re: Invoice' "$now" 'half a thought' DRAFT)]" \
    '{id: "th_1", messages: $m}' > "$FAKE/google/gmail_v1_users_me_threads_th_1"
}
unbase64url() { local s; s=$(tr -- '-_' '+/'); while [ $((${#s} % 4)) -ne 0 ]; do s+='='; done; base64 -d <<< "$s"; }

test_gmail_reads_one_accounts_threads_the_way_front_does() {
  workspace
  gmail_thread
  out=$("$tmp/tick/sources/work" poll $((now - 3600)))
  eq "$(jq -r .from <<< "$out")" bob@shop.example                   # who wrote last that isn't you
  eq "$(jq -r .updated_at <<< "$out")" $((now - 60))                # your draft is not news
  eq "$(jq -r .why <<< "$out")" "inbox unread"
  grep -q "in%3Ainbox%20after%3A$((now - 3600))" "$FAKE/curl.calls"
  "$tmp/tick/sources/work" thread th_1 > "$tmp/thread.md"
  eq "$(head -1 "$tmp/thread.md")" "# Invoice"
  eq "$(grep '^## ' "$tmp/thread.md" | cut -d, -f1)" "$(printf '## email from Me <me@work.example>\n## email from Bob <bob@shop.example>')"
  grep -qx 'Can you resend it?' "$tmp/thread.md"
  not grep -q '^> \|half a thought' "$tmp/thread.md"
  not "$tmp/tick/sources/gmail" poll 1 2> "$tmp/err"               # gmail itself is no account
  grep -q 'ln -s gmail' "$tmp/err"
}

test_a_gmail_reply_is_a_draft_in_its_thread_to_whoever_wrote_last() {
  workspace
  gmail_thread
  printf 'Sent it again.\n' | "$tmp/tick/sources/work" draft th_1 > /dev/null
  body=$(grep -A1 '^POST /gmail/v1/users/me/drafts$' "$FAKE/google.calls" | tail -1)
  eq "$(jq -r .message.threadId <<< "$body")" th_1
  jq -r .message.raw <<< "$body" | unbase64url | tr -d '\r' > "$tmp/mail"
  grep -qx 'To: Bob <bob@shop.example>' "$tmp/mail"
  grep -qx "Subject: =?UTF-8?B?$(printf 'Re: Invoice' | base64 -w0)?=" "$tmp/mail"
  grep -qx 'In-Reply-To: <m2@mail>' "$tmp/mail"                    # so it lands in the thread, for Bob too
  grep -qx 'Sent it again.' "$tmp/mail"
  printf 'Sent it again, really.\n' | "$tmp/tick/sources/work" draft th_1 d_1 > /dev/null
  grep -q '^PUT /gmail/v1/users/me/drafts/d_1$' "$FAKE/google.calls"   # the same draft, rewritten
  not grep -q '/messages/send' "$FAKE/google.calls"
  printf 'Sent.\n' | "$tmp/tick/sources/work" send th_1 > /dev/null
  grep -q '^POST /gmail/v1/users/me/messages/send$' "$FAKE/google.calls"
}

test_a_reply_to_a_gmail_thread_takes_the_same_road_as_one_to_front() {
  workspace
  gmail_thread
  id=$(printf 'conversation: work th_1\n' | t new -p reply "Re: Invoice" - 2> /dev/null)
  t run $id
  grep -q 'Can you resend it?' "$(dir $id)/thread.md"
  printf 'Sent it again.\n' > "$(dir $id)/answer.md"
  sign $id
  t run $id
  eq "$(step $id)" done
  grep -q '^POST /gmail/v1/users/me/drafts$' "$FAKE/google.calls"
}

calendar_event() {   # ID SUMMARY EPOCH MINUTES YOUR-ANSWER: an event Anna organizes, and you are invited to
  jq -nc --arg id "$1" --arg summary "$2" --argjson at "$3" --argjson minutes "$4" --arg answer "$5" '
    {id: $id, status: "confirmed", summary: $summary, htmlLink: "https://calendar.google.com/event?eid=\($id)",
     start: {dateTime: ($at | todate)}, end: {dateTime: ($at + $minutes * 60 | todate)},
     organizer: {email: "anna@work.example", displayName: "Anna"},
     attendees: [{email: "anna@work.example", displayName: "Anna", responseStatus: "accepted", organizer: true},
                 {email: "me@work.example", self: true, responseStatus: $answer}]}'
}
calendar_screen() { T_CALENDAR=work "$tmp/tick/bin/t-cal" "$@"; }

test_a_calendar_says_its_day_on_one_row_and_an_answer_reaches_the_organizer() {
  workspace
  now=$(date +%s)
  jq -nc --argjson items "[$(calendar_event ev_1 Standup $((now + 120)) 15 accepted), $(calendar_event ev_2 'RFC review' $((now + 7200)) 30 needsAction)]" \
    '{items: $items}' > "$FAKE/google/calendar_v3_calendars_primary_events"
  calendar_event ev_2 'RFC review' $((now + 7200)) 30 needsAction > "$FAKE/google/calendar_v3_calendars_primary_events_ev_2"
  mkdir "$tmp/tick/pipelines/work-cal"
  ln -s ../../steps/agenda "$tmp/tick/pipelines/work-cal/10-agenda"
  printf 'REPO=none\nCALENDAR=work\n' > "$tmp/tick/pipelines/work-cal/env"
  id=$(new -p work-cal "work calendar")
  t run $id
  eq "$(step $id)" 10-agenda                                        # a watch never ends
  t ls | grep "^ *$((10#$id)) " | grep -q ' · next .*Standup · 1 to answer$'
  eq "$(offered $id)" "cal log"                                     # enter on its row opens the week
  calendar_screen --rows | grep -q $'^ev_2\t.*RFC review .*to answer'
  calendar_screen --pane ev_2 | grep -q 'Anna: accepted'
  calendar_screen --key "$(keyfor accept)" ev_2 > /dev/null
  body=$(grep -A1 '^PATCH /calendar/v3/calendars/primary/events/ev_2$' "$FAKE/google.calls" | tail -1)
  eq "$(jq -r '.attendees[] | select(.self) | .responseStatus' <<< "$body")" accepted
  eq "$(jq -r '.attendees[] | select(.self | not) | .responseStatus' <<< "$body")" accepted   # Anna's own answer, untouched
  grep -q 'events/ev_2?sendUpdates=all' "$FAKE/curl.calls"          # and she is told
  calendar_screen --rows | grep $'^ev_2\t' > "$tmp/row"
  not grep -q 'to answer' "$tmp/row"
}

test_logging_a_google_account_in_asks_only_for_what_its_links_need() {
  workspace
  rm "$tmp/tick/calendars/work" "$tmp/config/google/work/refresh_token"   # mail only, and never logged in
  not "$tmp/tick/sources/work" poll 1 2> "$tmp/err"
  grep -q 't google login work' "$tmp/err"
  t google login work 2> "$tmp/err"
  grep -q 'gmail.modify' "$tmp/err"
  not grep -q 'calendar' "$tmp/err"
  eq "$(cat "$tmp/config/google/work/refresh_token")" refresh-new
  eq "$(stat -c %a "$tmp/config/google/work/refresh_token")" 600
  not t google login home 2> "$tmp/err"                             # another account is another name
  grep -q 'ln -s gmail' "$tmp/err"
}

test_slack_posts_a_task_once_and_edits_that_message_after_that() {
  slack
  id=$(new -r toy "add the widget")
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.postMessage)" 2                 # the task, and its details under it
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.postMessage)" 2                 # nothing changed: nothing said
  eq "$(calls chat.update)" 0
  t hold $id "waiting for you"
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.postMessage)" 3                 # the two, and the mention no edit of them can be
  eq "$(calls chat.update)" 2                      # the same two messages, edited where they are
  grep -A2 '^chat.update' "$FAKE/slack.calls" | grep -q "ts=$(cat "$(dir $id)/slack_ts")"
  eq "$(wc -l < "$(dir $id)/slack_sent")" 1        # the card is one short line
  grep -q ' held$' "$(dir $id)/slack_sent"
  grep -q 'held  waiting for you' "$(dir $id)/slack_story"   # and why is in the thread
  not grep -q "$(cat "$(dir $id)/branch")" "$FAKE/slack.calls"   # a branch is a terminal's business
}

test_slack_gets_the_answer_to_a_question_and_not_only_that_there_is_one() {
  slack
  id=$(new -r toy -p ask "where is the cart total rounded?")
  "$tmp/tick/jobs/slack-out"
  t run $id
  eq "$(step $id)" done
  "$tmp/tick/jobs/slack-out"
  grep -q "$(head -c 30 "$(dir $id)/answer.md")" "$FAKE/slack.calls"
  grep -q '<@U0AKSEL>' "$FAKE/slack.calls"          # you asked, so you are told
  grep -q ' answered$' "$(dir $id)/slack_sent"      # and the card stays: a phone is where you read how it went
  answers=$(calls chat.postMessage)
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.postMessage)" "$answers"         # said once, not on every tick
}

test_saying_status_posts_each_open_task_again_where_you_are() {
  slack
  said '[{"ts": "9.0", "user": "U0AKSEL", "text": "status"}]' history
  "$tmp/tick/jobs/slack-in"
  grep -q 'nothing open here' "$FAKE/slack.calls"  # asked, so answered
  id=$(new -r toy "add the widget")
  "$tmp/tick/jobs/slack-out"
  card=$(cat "$(dir $id)/slack_ts") details=$(cat "$(dir $id)/slack_thread")
  said '[{"ts": "10.0", "user": "U0AKSEL", "text": "status"}]' history
  "$tmp/tick/jobs/slack-in"
  eq "$(ls "$T_VAR/tasks" | wc -l)" 1              # the word is not a task about the tasks
  "$tmp/tick/jobs/slack-out"
  grep -A2 '^chat.delete' "$FAKE/slack.calls" | grep -q "ts=$card"
  grep -A2 '^chat.delete' "$FAKE/slack.calls" | grep -q "ts=$details"
  not eq "$(cat "$(dir $id)/slack_ts")" "$card"    # one card, posted afresh at the bottom
  [ -s "$(dir $id)/slack_thread" ]                 # with its details under it
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.delete)" 2                      # and it stays there until you ask again
}

test_help_in_slack_says_what_you_can_type_there() {
  slack
