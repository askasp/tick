test_a_message_in_the_slack_channel_starts_a_task_and_gets_an_eye() {
  slack
  said '[{"ts": "10.0", "user": "U0AKSEL", "text": "add the widget\nit goes next to the cart"}]' history
  "$tmp/tick/jobs/slack-in"
  eq "$(step 0001)" 10-implement
  eq "$(head -1 "$(dir 0001)/task.md")" "# add the widget"     # what you wrote after line 1 is the details
  grep -q 'it goes next to the cart' "$(dir 0001)/task.md"
  eq "$(cat "$(dir 0001)/pipeline")" feature       # the channel's repo decides, as in a terminal
  grep -A3 '^reactions.add' "$FAKE/slack.calls" | grep -q 'name=eyes'
  eq "$(cat "$(dir 0001)/slack_src")" 10.0
  said '[{"ts": "10.0", "user": "U0AKSEL", "text": "add the widget",
          "reactions": [{"name": "eyes", "users": ["U0BOT"]}]}]' history
  "$tmp/tick/jobs/slack-in"
  not test -d "$(dir 0002)"                        # 👀 is the whole memory: it never starts twice
}

test_a_slack_message_that_opens_with_a_pipeline_starts_that_kind_of_task() {
  slack
  said '[{"ts": "10.0", "user": "U0AKSEL", "text": "ask where is the cart total rounded?"}]' history
  "$tmp/tick/jobs/slack-in"
  eq "$(cat "$(dir 0001)/pipeline")" ask
  eq "$(head -1 "$(dir 0001)/task.md")" "# where is the cart total rounded?"
  eq "$(cat "$(dir 0001)/repo")" "$tmp/repo"       # ask reads the channel's repo
  said '[{"ts": "11.0", "user": "U0AKSEL", "text": "research which bun test runner is fastest?"}]' history
  "$tmp/tick/jobs/slack-in"
  eq "$(cat "$(dir 0002)/pipeline")" research
  [ ! -e "$(dir 0002)/repo" ]                      # research says REPO=none, so it gets none
  said '[{"ts": "12.0", "user": "U0AKSEL", "text": "feature +plan add a discount code field"}]' history
  "$tmp/tick/jobs/slack-in"
  eq "$(cat "$(dir 0003)/opt")" plan
  eq "$(head -1 "$(dir 0003)/task.md")" "# add a discount code field"
}

