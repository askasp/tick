test_a_reply_that_is_a_command_runs_it_and_posts_what_it_printed() {
  slack
  id=$(new -r toy "add the widget")
  "$tmp/tick/jobs/slack-out"
  said '[{"ts": "1701.000000", "bot_id": "B0", "text": "task 1"},
         {"ts": "20.0", "user": "U0AKSEL", "text": "t hold sleep on it"}]' replies
  "$tmp/tick/jobs/slack-in"
  eq "$(cat "$(dir $id)/hold")" "sleep on it"
  [ ! -f "$(dir $id)/feedback.md" ]
  said '[{"ts": "1701.000000", "bot_id": "B0", "text": "task 1"},
         {"ts": "22.0", "user": "U0AKSEL", "text": "t show"}]' replies
  "$tmp/tick/jobs/slack-in"
  grep -q 'sleep on it' "$FAKE/slack.calls"        # what it printed, not an empty block
  said '[{"ts": "1701.000000", "bot_id": "B0", "text": "task 1"},
         {"ts": "21.0", "user": "U0AKSEL", "text": "t frobnicate"}]' replies
  "$tmp/tick/jobs/slack-in"
  grep -q "no 'frobnicate' here" "$FAKE/slack.calls"
}

test_what_a_task_did_is_one_thread_message_edited_with_its_loops_collapsed() {
  slack
  id=$(new -r toy "add the widget")
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.postMessage)" 2                  # the task, and details that say only where it is
  n=$((10#$id))
  cat >> "$(dir $id)/history" <<EOF
2026-01-01 09:00:00 $n 10-implement ok → 20-test
2026-01-01 09:01:00 $n 20-test ok → 30-review
2026-01-01 09:02:00 $n 30-review ok → 10-implement
2026-01-01 09:10:00 $n 10-implement ok → 20-test
2026-01-01 09:11:00 $n 20-test ok → 30-review
2026-01-01 09:12:00 $n 30-review ok → 10-implement
EOF
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.postMessage)" 2                  # what it did is the same details message, edited
  grep -q 'implement → test → review  \*↺ ×2\*' "$FAKE/slack.calls"   # the churn, not a line each
  not grep -q '10-implement ok' "$FAKE/slack.calls"
  thread=$(cat "$(dir $id)/slack_thread")
  printf '2026-01-01 09:20:00 %s 10-implement failed (exit 127); it runs again on the next tick\n' \
    "$((10#$id))" >> "$(dir $id)/history"
  "$tmp/tick/jobs/slack-out"
  grep -q '09:20  implement failed (exit 127)$' "$FAKE/slack.calls"   # a failure names itself, once
  eq "$(calls chat.postMessage)" 2                  # the same message, edited where it stands
  grep -A2 '^chat.update' "$FAKE/slack.calls" | grep -q "ts=$thread"
  "$tmp/tick/jobs/slack-out"
  eq "$(calls chat.update)" 2                       # and left alone while nothing happens
}

test_a_held_task_mentions_you_in_its_thread_and_nowhere_else() {
  slack
  id=$(new -r toy "add the widget")
  printf '2026-01-01 09:00:00 %s 10-implement ok → 20-test\n' "$((10#$id))" >> "$(dir $id)/history"
  "$tmp/tick/jobs/slack-out"
  grep -q '09:00  implement → test' "$FAKE/slack.calls"
  not grep -q 'U0AKSEL' "$FAKE/slack.calls"
  t hold $id "test ran 3 times"
  "$tmp/tick/jobs/slack-out"
  grep -q '<@U0AKSEL>' "$FAKE/slack.calls"
  eq "$(grep -c 'thread_ts=' "$FAKE/slack.calls")" 2   # the thread message, and the mention an edit can't be
  "$tmp/tick/jobs/slack-out"
  eq "$(grep -c 'thread_ts=' "$FAKE/slack.calls")" 2   # said once, not on every tick
}

test_slack_is_a_job_tick_itself_knows_nothing_about() {
  not grep -rlq slack "$root/bin" "$root/lib" "$root/steps" "$root/drivers" "$root/pipelines" "$root/etc"
}

test_drivers_read_real_cli_output() {
  fx=$root/test/fixtures
  out=$(echo hi | FAKE_REPLAY=$fx/claude-read.jsonl "$root/drivers/claude" 2> "$tmp/err")
  eq "$out" "$(jq -r 'select(.type == "result") | .result' "$fx/claude-read.jsonl")"
  grep -q '· Read /etc/hostname' "$tmp/err"
  grep -q '^session: claude ' "$tmp/err"
  echo hi | FAKE_REPLAY=$fx/claude-denied.jsonl AGENT_MODE=edit "$root/drivers/claude" > /dev/null 2> "$tmp/err"
  grep -q '! denied: Write' "$tmp/err"
  out=$(echo hi | FAKE_REPLAY=$fx/opencode-edit.jsonl AGENT_MODE=edit "$root/drivers/opencode" 2> "$tmp/err")
  [ -n "$out" ]
  grep -q '^session: opencode ses_' "$tmp/err"
  grep -q '· write' "$tmp/err"
  printf '%s\n' '{"type":"tool_use","sessionID":"ses_x","part":{"tool":"glob","state":{"input":{"pattern":"**/*.sh"},"title":""}}}' > "$tmp/untitled.jsonl"
  echo hi | FAKE_REPLAY=$tmp/untitled.jsonl "$root/drivers/opencode" > /dev/null 2> "$tmp/err"
  grep -q '· glob \*\*/\*.sh' "$tmp/err"                  # no title: what it looked for
  not bash -c "echo hi | FAKE_REPLAY=$fx/opencode-error.jsonl '$root/drivers/opencode' > /dev/null 2>&1"
}

names=$(declare -F | awk '{ print $3 }' | grep '^test_' | grep -- "${1:-.}")
[ -n "$names" ] || { echo "no test matches ${1:-.}; run test/run with no pattern for all of them" >&2; exit 1; }
logs=$(mktemp -d)
for name in $names; do
  while [ "$(jobs -rp | wc -l)" -ge "$(nproc)" ]; do wait -n; done
  ( ( set -e; setup; "$name" ) > "$logs/$name" 2>&1; echo $? > "$logs/$name.exit" ) &
done
wait

pass=0 failed=()
for name in $names; do
  if [ "$(cat "$logs/$name.exit")" -eq 0 ]; then
    pass=$((pass + 1)); echo "ok    $name"
  else
    failed+=("$name"); echo "FAIL  $name"; cat "$logs/$name" | sed 's/^/      /'
  fi
done
rm -rf "$logs"
echo
echo "$pass passed, ${#failed[@]} failed"
[ ${#failed[@]} -eq 0 ]
