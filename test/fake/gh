#!/usr/bin/env bash
# A stand-in for gh. `pr checks` answers with the next line of $FAKE/checks:
# pass | pending | fail (default pass), with gh's exit codes (0, 8, 1).
# `pr view` answers with the next line of $FAKE/pr_state (default OPEN). `pr comment` adds its body to $FAKE/comments.
# `api graphql` answers a project's items with $FAKE/gh/items, and a search for the issues off it with $FAKE/gh/offboard.
# `issue create` numbers the issues it makes from #15, and waits while $FAKE/gh/hold is there.
set -eu
pop() {
  local line=
  if [ -s "$FAKE/$1" ]; then line=$(head -1 "$FAKE/$1"); sed -i 1d "$FAKE/$1"; fi
  echo "${line:-$2}"
}
echo "$*" >> "$FAKE/gh.calls"
if [ -e "$FAKE/gh/offline" ] && [ "$1" != api ]; then echo "error connecting to api.github.com" >&2; exit 1; fi
link=https://github.com/example/repo/actions/runs/7/job/1

case "$1 $2" in
  "pr create") cat > /dev/null; echo https://github.com/example/repo/pull/1 ;;
  "pr checks")
    case $(pop checks pass) in
      pass)    printf 'build\tpass\t1m2s\t%s\n' $link ;;
      pending) printf 'build\tpending\t0\t%s\n' $link; exit 8 ;;
      fail)    printf 'build\tfail\t1m2s\t%s\n' $link; exit 1 ;;
    esac ;;
  "pr view")   pop pr_state OPEN ;;
  "pr comment") cat >> "$FAKE/comments" ;;
  "run view")  echo "FAIL test_widget: expected 2, got 3" ;;
  "auth status") ;;
  "issue create") while [ -e "$FAKE/gh/hold" ]; do sleep 0.05; done; echo "https://github.com/$4/issues/$(( 14 + $(grep -c '^issue create' "$FAKE/gh.calls") ))" ;;
  "issue view")   echo I_parent ;;
  "api graphql")
    if [[ $* == *addSubIssue* ]]; then echo '{}'
    elif [[ $* == *search* ]]; then cat "$FAKE/gh/offboard" 2> /dev/null || echo '{"data": {"search": {"nodes": []}}}'
    else cat "$FAKE/gh/items"; fi ;;
  "project item-add")   echo PVTI_added ;;
  "project view")       echo PVT_1 ;;
  "project field-list") echo '{"fields": [{"id": "F_status", "name": "Status", "options": [{"id": "O_backlog", "name": "Backlog"},
                          {"id": "O_next", "name": "Up-next"}, {"id": "O_started", "name": "In progress"}, {"id": "O_qa", "name": "QA"}]}]}' ;;
  "project item-edit" | "issue edit") ;;
  *)           echo "fake gh: unhandled: $*" >&2; exit 1 ;;
esac
