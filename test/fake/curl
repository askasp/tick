#!/usr/bin/env bash
# A stand-in for curl against the Front and Google APIs.
# Front (api2.frontapp.com) and Google (*.googleapis.com) answer from $FAKE/front or $FAKE/google: the file whose
# name (the URL's path, slashes as _) starts the requested path; longest name wins. No file: an empty Front page.
# $FAKE/SERVICE/401 makes every request fail the way `curl -f` does. A call that writes (-X POST, PATCH, PUT) goes
# to $FAKE/SERVICE.calls as "METHOD /path" and its body on the next line, and answers with $FAKE/SERVICE/POST_path
# first, then as a GET would, else an id of its own.
set -eu
url=${!#}
echo "$url" >> "$FAKE/curl.calls"
verb=GET
for ((i = 1; i < $#; i++)); do
  if [ "${!i}" = -X ]; then j=$((i + 1)); verb=${!j}; fi
done

case $url in
  https://api2.frontapp.com/*) service=front ;;
  https://*.googleapis.com/*)  service=google ;;
  *) echo "the fake curl knows nothing of $url" >&2; exit 2 ;;
esac
route=/${url#https://*/}
route=${route%%\?*}
path=${route#/}
path=${path//\//_}
if [ -e "$FAKE/$service/401" ]; then echo "curl: (22) The requested URL returned error: 401" >&2; exit 22; fi
if [ "$verb" != GET ]; then
  printf '%s %s\n%s\n' "$verb" "$route" "$(cat)" >> "$FAKE/$service.calls"
fi
answer() {   # the file whose name starts $1, if there is one
  local name
  for name in $(ls "$FAKE/$service" 2> /dev/null | sort -r); do
    if [[ $1 == "$name"* ]]; then cat "$FAKE/$service/$name"; exit 0; fi
  done
}
if [ "$verb" != GET ]; then answer "${verb}_$path"; fi   # POST_conversations_cnv_x_messages: what only a POST gets
answer "$path"
if [ "$verb" != GET ]; then echo '{"id": "msg_fake"}'; exit 0; fi
echo '{"_results": [], "_pagination": {"next": null}}'
